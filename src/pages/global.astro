---
import { env } from 'cloudflare:workers';
import Layout from '../layouts/Layout.astro';

let globalList: any[] = [];
try {

  const db = env.DB;
  if (db) {
    const result = await db.prepare(
      `SELECT id, title, link, description, source, category, pub_date, original_title, country
       FROM news WHERE category = 'global' AND title != original_title
       ORDER BY created_at DESC LIMIT 50`
    ).all();
    globalList = result.results || [];
  }
} catch (e) {
  console.error('Global news fetch error:', e);
}

function getSourceColor(source: string): string {
  const map: Record<string, string> = {
    'TechCrunch AI': 'text-[#111111] dark:text-[#555555]',
    'MIT Tech Review': 'text-[#111111] dark:text-[#555555]',
    'SCMP China Tech': 'text-red-700 dark:text-red-400',
    'Hacker News': 'text-[#111111] dark:text-[#555555]',
  };
  return map[source] || 'text-gray-600 dark:text-gray-400';
}

function getFlag(country: string): string {
  const map: Record<string, string> = { 'us': '🇺🇸', 'cn': '🇨🇳' };
  return map[country] || '🌐';
}
---
<Layout title="글로벌 AI 뉴스 - AI코리아24" description="미국, 중국 등 해외 AI 뉴스를 한국어로 번역하여 제공합니다.">
  <div class="bg-white dark:bg-[#0A0E1A] text-gray-900 dark:text-white min-h-screen transition-colors">
    <div class="max-w-4xl mx-auto px-4 py-12">
      <div class="flex items-center gap-3 mb-8">
        <span class="text-3xl">🌍</span>
        <h1 class="text-3xl font-bold">글로벌 AI 뉴스</h1>
      </div>
      <p class="text-gray-500 mb-8">TechCrunch, MIT Technology Review, SCMP, Hacker News 등 해외 주요 AI 매체의 뉴스를 한국어로 번역하여 제공합니다.</p>
      {globalList.length === 0 ? (
        <div class="text-center py-12">
          <img src="/mascot-tiger.png" alt="AI코리아24 마스코트" width="120" height="120" class="mx-auto mb-4" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='/logo-final.webp';" />
          <p class="text-gray-500">아직 수집된 글로벌 뉴스가 없습니다.</p>
        </div>
      ) : (
        <div class="space-y-4">
          {globalList.map((n: any) => (
            <a href={n.link} target="_blank" rel="noopener" class="block bg-gray-100  border border-gray-200  rounded-xl p-5 hover:bg-gray-100 hover:border-[#e5e5e5] transition-all">
              <div class="flex items-center gap-2 mb-2">
                <span class={`text-[10px] font-medium px-2 py-0.5 rounded-full bg-[#333333]/10 ${getSourceColor(n.source)}`}>{getFlag(n.country)} {n.source}</span>
                <span class="text-xs text-gray-600 dark:text-gray-400">{n.pub_date}</span>
              </div>
              <h2 class="font-medium text-gray-900 dark:text-white mb-1">{n.title}</h2>
              <p class="text-xs text-gray-400 mb-1">{n.original_title}</p>
              <p class="text-sm text-gray-500 line-clamp-2">{n.description}</p>
            </a>
          ))}
        </div>
      )}
    </div>
  </div>
</Layout>
