---
// AIK24-EMDASH-03: Astro 블로그는 EmDash 로 이관 완료.
// /blog/<astro-slug>/ → https://emdash.aikorea24.kr/posts/<emdash-slug> 301
// Cloudflare Pages/Workers 의 public/_redirects 는 한글(비ASCII) 소스 경로를 매칭하지
// 못해(실측: raw / percent-encoded 둘 다 404, ASCII 규칙만 동작) Worker 라우트로 301 을 낸다.
export const prerender = false;

import SLUG_MAP from '../../data/emdash_slug_map.json';

const POSTS = 'https://emdash.aikorea24.kr/posts';
const map = SLUG_MAP as Record<string, string>;

const seg = decodeURIComponent(Astro.params.page || '').replace(/^\/+|\/+$/g, '');

// /blog/ , /blog/2/ , /blog/3/ … → EmDash 목록 페이지네이션
if (!seg || /^\d+$/.test(seg)) {
  return Astro.redirect(seg ? `${POSTS}?page=${seg}` : POSTS, 301);
}

// /blog/<slug>/ → 해당 EmDash 글. 매핑이 없으면 404.
// 2026-11-16 (AIK24-ADSENSE-404FIX): 매핑 없는 슬러그를 목록 페이지로 보내면
// 200 + 광고가 실린 빈 URL 이 되어 무효 노출이 된다(실측: /blog/<임의문자열>/ → 200·광고 3).
// 존재하지 않는 글은 404 로 응답하고, 광고는 넣지 않는다.
const target = map[seg] || map[seg.toLowerCase()];
if (!target) {
  return new Response(
    `<!DOCTYPE html><html lang="ko"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>페이지를 찾을 수 없습니다</title>
<style>body{margin:0;font-family:system-ui,-apple-system,"Apple SD Gothic Neo",sans-serif;display:flex;min-height:100vh;align-items:center;justify-content:center;background:#fff;color:#111}.box{text-align:center;padding:24px}h1{font-size:4rem;margin:0;line-height:1}p{color:#555;margin:12px 0 24px}a{display:inline-block;padding:10px 22px;background:#111;color:#fff;border-radius:8px;text-decoration:none}</style>
</head><body><div class="box"><h1>404</h1><p>요청하신 글을 찾을 수 없습니다.</p>
<a href="/">홈으로 돌아가기</a></div></body></html>`,
    { status: 404, headers: { 'content-type': 'text/html; charset=utf-8' } },
  );
}
return Astro.redirect(target, 301);
---