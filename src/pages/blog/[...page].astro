---
// AIK24-EMDASH-03: Astro 블로그는 EmDash 로 이관 완료.
// /blog/<astro-slug>/ → https://emdash.aikorea24.kr/posts/<emdash-slug> 301
// Cloudflare Pages/Workers 의 public/_redirects 는 한글(비ASCII) 소스 경로를 매칭하지
// 못해(실측: raw / percent-encoded 둘 다 404, ASCII 규칙만 동작) Worker 라우트로 301 을 낸다.
export const prerender = false;

import SLUG_MAP from '../../data/emdash_slug_map.json';

const POSTS = 'https://emdash.aikorea24.kr/posts';
const map = SLUG_MAP as Record<string, string>;

const seg = decodeURIComponent(Astro.params.page || '').replace(/^\/+|\/+$/g, '');

// /blog/ , /blog/2/ , /blog/3/ … → EmDash 목록 페이지네이션
if (!seg || /^\d+$/.test(seg)) {
  return Astro.redirect(seg ? `${POSTS}?page=${seg}` : POSTS, 301);
}

// /blog/<slug>/ → 해당 EmDash 글. 매핑이 없으면 목록으로 (404 보다 낫다)
return Astro.redirect(map[seg] || map[seg.toLowerCase()] || POSTS, 301);
---