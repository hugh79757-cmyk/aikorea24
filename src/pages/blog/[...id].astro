---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const publishedPosts = posts.filter(p => !p.data.draft);

  return publishedPosts.map(post => {
    const currentTags = new Set((post.data.tags || []).map((t: string) => t.toLowerCase()));
    const currentCategory = (post.data.category || '').toLowerCase();

    const relatedPosts = publishedPosts
      .filter(p => p.id !== post.id)
      .map(p => {
        let score = 0;
        const pCategory = (p.data.category || '').toLowerCase();
        const pTags = (p.data.tags || []).map((t: string) => t.toLowerCase());
        if (pCategory && pCategory === currentCategory) score += 3;
        for (const t of pTags) {
          if (currentTags.has(t)) score += 1;
        }
        return { post: p, score };
      })
      .filter(r => r.score > 0)
      .sort((a, b) => b.score - a.score || new Date(b.post.data.date).getTime() - new Date(a.post.data.date).getTime())
      .slice(0, 5)
      .map(r => r.post);

    return {
      params: { id: post.id },
      props: { post, relatedPosts },
    };
  });
}

const { post, relatedPosts } = Astro.props;
const { Content } = await render(post);

const dateStr = post.data.date instanceof Date
  ? post.data.date.toISOString()
  : new Date(post.data.date).toISOString();

const inlinePosts = relatedPosts.slice(0, 3);
const bottomPosts = relatedPosts.slice(3);

const formattedDate = post.data.date instanceof Date
  ? post.data.date.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' })
  : new Date(post.data.date).toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout
  title={post.data.title}
  description={post.data.description}
  image={post.data.image || '/og-default.jpeg'}
  type="article"
  publishedDate={dateStr}
  tags={post.data.tags || []}
  category={post.data.category || ''}
>
  <article class="max-w-3xl mx-auto px-4 py-12">
    <!-- 브레드크럼 -->
    <nav class="text-sm text-gray-500 dark:text-gray-400 mb-6" aria-label="breadcrumb">
      <ol class="flex items-center gap-1">
        <li><a href="/" class="hover:text-[#111111] dark:hover:text-[#555555]">홈</a></li>
        <li class="before:content-['/'] before:mx-1">
          <a href="/blog" class="hover:text-[#111111] dark:hover:text-[#555555]">블로그</a>
        </li>
        <li class="before:content-['/'] before:mx-1 text-gray-900 dark:text-gray-100 font-medium truncate max-w-[200px]">
          {post.data.title}
        </li>
      </ol>
    </nav>

    <!-- 헤더 -->
    <header class="mb-8">
      {post.data.category && (
        <span class="inline-block bg-gray-100 dark:bg-[#111111]/40 text-[#111111] dark:text-gray-500 text-xs font-semibold px-3 py-1 rounded-full mb-4">
          {post.data.category}
        </span>
      )}
      <h1 class="text-3xl md:text-4xl font-bold text-[#111111] leading-tight mb-4" style="border-left: 6px solid #E63B2E; padding-left: 24px;">
        {post.data.title}
      </h1>
      <div class="flex items-center gap-4 text-sm text-gray-500 dark:text-gray-400">
        <time datetime={dateStr}>{formattedDate}</time>
        {post.data.tags && post.data.tags.length > 0 && (
          <div class="flex gap-2 flex-wrap">
            {post.data.tags.map((tag: string) => (
              <span class="bg-gray-100 dark:bg-white/10 text-gray-600 dark:text-gray-300 px-2 py-0.5 rounded text-xs">
                #{tag}
              </span>
            ))}
          </div>
        )}
      </div>
    </header>

    <!-- 커버 이미지 -->
    {post.data.image && (
      <img
        src={post.data.image}
        alt={post.data.title}
        class="w-full rounded-xl mb-8 aspect-video object-cover"
        width="768"
        height="432"
        loading="eager"
      />
    )}

    <!-- 본문 상단 광고 (정적 삽입 - 가장 안정적) -->
    <div class="not-prose my-8" style="width:100%;overflow:hidden;">
      <ins class="adsbygoogle"
           style="display:block;text-align:center;"
           data-ad-layout="in-article"
           data-ad-format="fluid"
           data-ad-client="ca-pub-5938862195544185"
           data-ad-slot="3350911709"></ins>
      <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
    </div>

    <!-- 본문 -->
    <div id="prose-body" class="prose prose-container prose-xl max-w-none
        prose-headings:text-[#111111]
        prose-p:text-[#333333]
        prose-strong:text-[#111111]
        prose-a:text-[#111111] prose-a:underline prose-a:underline-offset-2 hover:prose-a:text-[#E63B2E]
        prose-blockquote:text-[#555555] prose-blockquote:border-[#E63B2E]
        prose-code:text-[#111111]
        prose-pre:bg-[#fafafa]
        prose-li:text-[#333333]
        prose-img:rounded-xl
        prose-hr:border-[#e5e5e5]
        prose-th:text-[#111111]
        prose-td:text-[#333333]
        prose-table:w-full prose-table:my-8 prose-table:text-base prose-table:border-collapse
        prose-th:border prose-th:border-[#e5e5e5] prose-th:bg-[#fafafa] prose-th:px-4 prose-th:py-2.5
        prose-td:border prose-td:border-[#e5e5e5] prose-td:px-4 prose-td:py-2.5">
      <Content />
    </div>

    <!-- 본문 중간 광고 (정적 삽입) -->
    <div class="not-prose my-8" style="width:100%;overflow:hidden;">
      <ins class="adsbygoogle"
           style="display:block;text-align:center;"
           data-ad-layout="in-article"
           data-ad-format="fluid"
           data-ad-client="ca-pub-5938862195544185"
           data-ad-slot="3350911709"></ins>
      <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
    </div>

    <!-- 인라인 관련글 데이터 -->
    {inlinePosts.length > 0 && (
      <div id="inline-related-data" class="hidden">
        {inlinePosts.map((ip, idx) => (
          <div
            data-idx={idx}
            data-url={`/blog/${ip.id}/`}
            data-title={ip.data.title}
            data-category={ip.data.category || ''}
          ></div>
        ))}
      </div>
    )}

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const prose = document.getElementById('prose-body');
        if (!prose) return;
        const h2s = prose.querySelectorAll('h2');

        // 관련글 배너 삽입
        const container = document.getElementById('inline-related-data');
        if (container && h2s.length >= 2) {
          const items = container.querySelectorAll('[data-idx]');
          if (items.length > 0) {
            const total = h2s.length;
            let positions: number[];
            if (total <= 3) positions = [1];
            else if (total <= 5) positions = [1, 3];
            else positions = [1, 3, 5];

            const count = Math.min(positions.length, items.length);
            for (let i = 0; i < count; i++) {
              const pos = positions[i];
              if (pos >= h2s.length) break;
              const item = items[i] as HTMLElement;
              const url = item.dataset.url;
              const title = item.dataset.title;
              const category = item.dataset.category;
              const banner = document.createElement('div');
              banner.className = 'not-prose my-6 p-4 bg-gray-100 dark:bg-[#111111]/20 border border-[#e5e5e5] dark:border-[#e5e5e5] rounded-xl';
              banner.innerHTML = `
                <a href="${url}" class="flex items-start gap-3 no-underline group">
                  <span>
                    ${category ? `<span class="text-xs font-semibold text-[#555555] mr-2">${category}</span>` : ''}
                    <span class="text-lg font-semibold text-gray-900 dark:text-white group-hover:text-[#E63B2E] dark:group-hover:text-[#E63B2E]">${title}</span>
                  </span>
                </a>
              `;
              h2s[pos].parentNode?.insertBefore(banner, h2s[pos]);
            }
          }
        }
      });
    </script>

    <!-- 본문 하단 CTA -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-10 mb-6">
      <!-- CTA 1: 강좌 -->
      <div class="p-5 rounded-xl bg-[#111111]r/30/20 border border-[#e5e5e5]/30 text-center">
        <h3 class="text-sm font-bold text-gray-900 dark:text-white mb-1">7일 강좌 무료 신청</h3>
        <p class="text-xs text-gray-400 mb-3">AI, 어디서부터 시작할지 모르겠다면?</p>
        <a href="/courses/7day-starter/" class="inline-block bg-[#111111] text-white px-4 py-2 rounded-lg text-xs font-semibold transition-all">
          강좌 신청하기 →
        </a>
      </div>

      <!-- CTA 2: 브리핑 구독 -->
      <div class="p-5 rounded-xl bg-[#111111]r/30/20 border border-[#e5e5e5]/30 text-center">
        <h3 class="text-sm font-bold text-gray-900 dark:text-white mb-1">매일 아침 AI 브리핑</h3>
        <p class="text-xs text-gray-400 mb-3">선별된 AI 뉴스를 이메일로 받아보세요</p>
        <a href="/subscribe/" class="inline-block bg-[#111111] text-white px-4 py-2 rounded-lg text-xs font-semibold transition-all">
          구독하기 →
        </a>
      </div>
    </div>

    <!-- 관련 글 -->
    {bottomPosts.length > 0 && (
      <section class="mt-12 pt-8 border-t border-gray-200 dark:border-gray-700">
        <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-6">함께 읽으면 좋은 글</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {bottomPosts.map(rp => (
            <a href={`/blog/${rp.id}/`}
               class="block p-4 rounded-xl border border-gray-200 dark:border-gray-700 hover:border-[#e5e5e5] dark:hover:border-[#e5e5e5] hover:shadow-md transition-all group">
              {rp.data.category && (
                <span class="text-xs font-semibold text-[#111111] dark:text-[#555555]">{rp.data.category}</span>
              )}
              <h3 class="text-sm font-semibold text-gray-900 dark:text-white mt-1 group-hover:text-[#111111] dark:group-hover:text-[#555555] line-clamp-2">
                {rp.data.title}
              </h3>
              <p class="text-xs text-gray-500 dark:text-gray-400 mt-2 line-clamp-2">{rp.data.description}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- 서브 프로젝트 배너 -->
    <div class="mt-10 flex flex-col gap-4">

      <!-- cert 배너 -->
      <div class="p-6 bg-[#111111]/20 border border-[#e5e5e5] dark:border-[#e5e5e5] rounded-2xl">
        <div class="flex items-center gap-3 mb-3">
          <span class="text-base font-bold text-[#111111] dark:text-[#555555]">CertKorea</span>
        </div>
        <p class="text-gray-700 dark:text-gray-300 text-base mb-4 leading-relaxed">
          2026년 국가자격증 시험일정을 한눈에 확인하세요. 613개 자격증의 필기·실기 D-day 카운트다운.
        </p>
        <a href="https://cert.aikorea24.kr" target="_blank" rel="noopener"
           class="inline-flex items-center text-sm font-semibold text-[#111111] dark:text-[#555555] hover:text-[#111111] dark:hover:text-gray-500">
          자격증 시험일정 확인하기 →
        </a>
      </div>

      <!-- persona 배너 -->
      <div class="p-6 bg-[#111111]/20 border border-[#e5e5e5] dark:border-[#e5e5e5] rounded-2xl">
        <div class="flex items-center gap-3 mb-3">
          <span class="text-base font-bold text-[#111111] dark:text-[#555555]">한국인 AI 페르소나</span>
        </div>
        <p class="text-gray-700 dark:text-gray-300 text-base mb-4 leading-relaxed">
          나와 비슷한 한국인은 어떻게 살까? 나이·성별·지역만 입력하면 주거·직업·소득을 통계로 분석해드려요.
        </p>
        <a href="https://persona.aikorea24.kr" target="_blank" rel="noopener"
           class="inline-flex items-center text-sm font-semibold text-[#111111] dark:text-[#555555] hover:text-[#111111] dark:hover:text-gray-500">
          내 페르소나 분석하기 →
        </a>
      </div>

    </div>

    <!-- 하단 네비게이션 -->
    <div class="mt-8 pt-8 border-t border-gray-200 dark:border-gray-700">
      <a id="back-to-list" href="/blog/" class="inline-flex items-center text-[#111111] dark:text-[#555555] hover:text-[#111111] dark:hover:text-gray-500 font-medium">
        ← 블로그 목록으로
      </a>
      <script is:inline>
        (function() {
          var url = sessionStorage.getItem('blog_back_url');
          if (url) {
            var el = document.getElementById('back-to-list');
            if (el) el.setAttribute('href', url);
          }
        })();
      </script>
    </div>
  </article>
</Layout>
