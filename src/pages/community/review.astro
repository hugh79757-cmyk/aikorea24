---
import Layout from '../../layouts/Layout.astro';

let currentUser = null;
try {
  const session = Astro.cookies.get('session')?.value;
  if (session) currentUser = JSON.parse(atob(session));
} catch {}

if (!currentUser) {
  return Astro.redirect('/auth/consent');
}

const toolId = Astro.url.searchParams.get('tool_id');
const toolName = Astro.url.searchParams.get('tool_name');
---
<Layout title="리뷰 작성 | AI코리아24" description="AI 도구 사용 후기를 작성해주세요.">

  <main class="relative z-10 min-h-screen px-4 py-12">

    <!-- 앰비언트 글로우 배경 -->
    <div class="fixed inset-0 pointer-events-none z-0">
      <div class="absolute top-[-15%] left-[5%] w-[500px] h-[500px] bg-blue-600/15 rounded-full blur-[140px]"></div>
      <div class="absolute bottom-[-10%] right-[10%] w-[400px] h-[400px] bg-purple-600/10 rounded-full blur-[120px]"></div>
    </div>

    <div class="relative z-10 max-w-xl mx-auto">

      <!-- 헤더 -->
      <div class="text-center mb-10">
        <h1 class="text-3xl font-bold text-white mb-2">✍️ 리뷰 작성</h1>
        <p class="text-gray-400 text-sm">실제 사용 경험을 공유해주세요</p>
      </div>

      <!-- 리뷰 대상 툴 카드 -->
      {toolName && (
        <div class="bg-gradient-to-r from-blue-600/20 to-purple-600/20 backdrop-blur-md border border-blue-500/20 rounded-xl p-5 mb-8 text-center">
          <span class="inline-block bg-blue-500/20 text-blue-300 text-xs font-medium px-3 py-1 rounded-full mb-2">📌 리뷰 대상</span>
          <p class="text-xl font-bold text-white">{toolName}</p>
        </div>
      )}

      <!-- 에러 메시지 -->
      <div id="error-msg" class="hidden bg-red-500/15 border border-red-500/30 text-red-300 px-5 py-3.5 rounded-xl mb-6 text-sm"></div>

      <!-- 리뷰 폼 -->
      <form id="review-form" class="space-y-7">

        <!-- 별점 -->
        <div>
          <label class="block text-sm font-medium text-gray-300 mb-3">⭐ 별점</label>
          <div class="flex justify-center gap-2 text-4xl" id="star-rating">
            {[1, 2, 3, 4, 5].map((i) => (
              <button type="button"
                class="star cursor-pointer text-gray-600 hover:text-yellow-400 transition-colors duration-150 focus:outline-none"
                data-value={i}
                aria-label={`${i}점`}>
                ★
              </button>
            ))}
          </div>
          <input type="hidden" id="rating" name="rating" value="5" />
          <p id="rating-label" class="text-center text-sm text-gray-500 mt-2">매우 좋음</p>
        </div>

        <!-- 제목 -->
        <div>
          <label for="title" class="block text-sm font-medium text-gray-300 mb-2">제목</label>
          <input type="text" id="title" name="title" maxlength="100" placeholder="한줄로 요약해주세요" required
            class="w-full px-5 py-3.5 bg-gray-800/60 border border-gray-700/50 rounded-xl text-white placeholder-gray-500
                   focus:ring-2 focus:ring-blue-500/40 focus:border-blue-500/50 outline-none transition-all duration-200" />
          <div class="text-right text-xs text-gray-600 mt-1.5">
            <span id="title-count">0</span> / 100
          </div>
        </div>

        <!-- 본문 -->
        <div>
          <label for="content" class="block text-sm font-medium text-gray-300 mb-2">내용</label>
          <textarea id="content" name="content" rows="8" maxlength="2000"
            placeholder="실제 사용 경험을 자유롭게 작성해주세요&#10;&#10;• 언제부터 사용했는지&#10;• 어떤 점이 좋았는지&#10;• 아쉬운 점은 무엇인지"
            required
            class="w-full px-5 py-3.5 bg-gray-800/60 border border-gray-700/50 rounded-xl text-white placeholder-gray-500
                   focus:ring-2 focus:ring-blue-500/40 focus:border-blue-500/50 outline-none transition-all duration-200 resize-y"></textarea>
          <div class="text-right text-xs text-gray-600 mt-1.5">
            <span id="content-count">0</span> / 2,000
          </div>
        </div>

        <!-- 버튼 -->
        <div class="flex items-center justify-between pt-2">
          <button type="button" id="cancel-btn" onclick="history.back()"
            class="px-6 py-3 rounded-xl text-gray-400 hover:text-white border border-gray-700/50 hover:border-gray-600/50
                   bg-gray-800/30 hover:bg-gray-800/60 transition-all duration-200 text-sm">
            ← 취소
          </button>
          <button type="submit" id="submit-btn"
            class="px-8 py-3 rounded-xl bg-gradient-to-r from-blue-500 to-purple-600 text-white font-semibold
                   hover:shadow-[0_0_30px_rgba(99,102,241,0.3)] hover:-translate-y-0.5 transition-all duration-300 text-sm">
            리뷰 등록하기
          </button>
        </div>

      </form>
    </div>
  </main>

  <script>
    (function() {
      const form = document.getElementById('review-form') as HTMLFormElement;
      const titleEl = document.getElementById('title') as HTMLInputElement;
      const contentEl = document.getElementById('content') as HTMLTextAreaElement;
      const titleCount = document.getElementById('title-count') as HTMLSpanElement;
      const contentCount = document.getElementById('content-count') as HTMLSpanElement;
      const errorMsg = document.getElementById('error-msg') as HTMLDivElement;
      const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
      const ratingInput = document.getElementById('rating') as HTMLInputElement;
      const ratingLabel = document.getElementById('rating-label') as HTMLParagraphElement;
      const stars = document.querySelectorAll('.star') as NodeListOf<HTMLButtonElement>;

      const toolId = new URLSearchParams(window.location.search).get('tool_id');
      const toolName = new URLSearchParams(window.location.search).get('tool_name');

      const ratingLabels: Record<number, string> = {
        1: '매우 나쁨',
        2: '나쁨',
        3: '보통',
        4: '좋음',
        5: '매우 좋음',
      };

      // 글자수 카운트
      titleEl.addEventListener('input', () => {
        titleCount.textContent = String(titleEl.value.length);
      });
      contentEl.addEventListener('input', () => {
        contentCount.textContent = String(contentEl.value.length);
      });

      // 별점 클릭
      stars.forEach((star) => {
        star.addEventListener('click', () => {
          const val = parseInt(star.dataset.value!, 10);
          ratingInput.value = String(val);
          ratingLabel.textContent = ratingLabels[val] || '';

          stars.forEach((s, i) => {
            if (i < val) {
              s.classList.add('text-yellow-400');
              s.classList.remove('text-gray-600');
            } else {
              s.classList.remove('text-yellow-400');
              s.classList.add('text-gray-600');
            }
          });
        });

        // 호버 프리뷰
        star.addEventListener('mouseenter', () => {
          const val = parseInt(star.dataset.value!, 10);
          stars.forEach((s, i) => {
            if (i < val) {
              s.classList.add('text-yellow-300');
            }
          });
        });
        star.addEventListener('mouseleave', () => {
          const currentVal = parseInt(ratingInput.value, 10) || 0;
          stars.forEach((s, i) => {
            s.classList.remove('text-yellow-300');
            if (i < currentVal) {
              s.classList.add('text-yellow-400');
            }
          });
        });
      });

      // 초기 별점 5 활성화
      stars.forEach((s, i) => {
        if (i < 5) {
          s.classList.add('text-yellow-400');
          s.classList.remove('text-gray-600');
        }
      });
      ratingLabel.textContent = '매우 좋음';

      // 폼 제출
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorMsg.classList.add('hidden');
        submitBtn.disabled = true;
        submitBtn.textContent = '등록 중...';

        const title = titleEl.value.trim();
        const content = contentEl.value.trim();

        if (!title || !content) {
          errorMsg.textContent = '제목과 내용을 모두 입력해주세요.';
          errorMsg.classList.remove('hidden');
          submitBtn.disabled = false;
          submitBtn.textContent = '리뷰 등록하기';
          return;
        }

        try {
          const res = await fetch('/api/posts', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              title,
              content,
              category: 'review',
              access_level: 'free',
              price: 0,
              preview_content: '',
              tool_id: toolId || null,
              rating: parseInt(ratingInput.value, 10) || 5
            })
          });

          const data = await res.json();

          if (res.ok && data.success) {
            // tool_name이 있으면 slug 변환 후 이동, 없으면 커뮤니티로
            if (toolName) {
              const slug = toolName.toLowerCase()
                .replace(/[^a-z0-9가-힣]+/g, '-')
                .replace(/^-|-$/g, '')
                .replace(/[^a-z0-9-]/g, '');
              window.location.href = '/tools/' + slug + '/';
            } else {
              window.location.href = '/community/';
            }
          } else {
            errorMsg.textContent = data.error || '리뷰 등록에 실패했습니다.';
            errorMsg.classList.remove('hidden');
          }
        } catch (err) {
          errorMsg.textContent = '네트워크 오류가 발생했습니다.';
          errorMsg.classList.remove('hidden');
        }

        submitBtn.disabled = false;
        submitBtn.textContent = '리뷰 등록하기';
      });
    })();
  </script>

</Layout>
