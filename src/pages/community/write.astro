---
import Layout from '../../layouts/Layout.astro';
import { verifySession } from '../../lib/auth';

let currentUser = null;
const session = Astro.cookies.get('session')?.value;
if (session) currentUser = await verifySession(session, Astro.locals.sessionSecret);

if (!currentUser) {
  return Astro.redirect('/auth/consent');
}

const toolId = Astro.url.searchParams.get('tool_id');
const toolName = Astro.url.searchParams.get('tool_name');

const categoryMap: Record<string, string> = {
  free: '자유게시판',
  qna: '질문답변',
  review: '🔧 툴 리뷰',
};
---
<Layout title="글쓰기 | AI코리아24" description="AI 관련 글을 자유롭게 작성하세요.">

  <main class="max-w-4xl mx-auto px-4 py-8">

    <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-8">글쓰기</h1>

    <div id="error-msg" class="hidden bg-red-50 dark:bg-red-500/20 border border-red-200 dark:border-red-500/50 text-red-700 dark:text-red-300 px-4 py-3 rounded-lg mb-6"></div>

    <form id="write-form" class="space-y-6">

      <div class="flex gap-4">
        <div class="flex-shrink-0">
          <label class="block text-sm text-gray-500 dark:text-gray-400 mb-2">카테고리</label>
          <select id="category" class="bg-white dark:bg-white/10 border border-gray-300 dark:border-gray-600 text-gray-900 dark:text-white rounded-lg px-4 py-3 w-40">
            {Object.entries(categoryMap).map(([key, label]) => (
              <option value={key} selected={key === 'review' && toolId}>{label}</option>
            ))}
          </select>
          <input type="hidden" id="tool_id" value={toolId || ''} />
          {toolName && (
            <p class="text-sm text-blue-600 dark:text-blue-400 mt-1">📌 리뷰 대상: {toolName}</p>
          )}
        </div>
        <div class="flex-1">
          <label class="block text-sm text-gray-500 dark:text-gray-400 mb-2">제목</label>
          <input type="text" id="title" maxlength="200" placeholder="제목을 입력하세요"
                 class="bg-white dark:bg-white/10 border border-gray-300 dark:border-gray-600 text-gray-900 dark:text-white rounded-lg px-4 py-3 w-full" required />
        </div>
      </div>

      <div class="flex gap-4">
        <div>
          <label class="block text-sm text-gray-500 dark:text-gray-400 mb-2">공개 범위</label>
          <select id="access_level" class="bg-white dark:bg-white/10 border border-gray-300 dark:border-gray-600 text-gray-900 dark:text-white rounded-lg px-4 py-3 w-40">
            <option value="free">무료 (전체공개)</option>
            <option value="basic">Basic (구독자)</option>
            <option value="premium">Premium (프리미엄)</option>
          </select>
        </div>
        <div>
          <label class="block text-sm text-gray-500 dark:text-gray-400 mb-2">건별 가격 (원)</label>
          <input type="number" id="price" min="0" step="100" value="0" placeholder="0이면 건별구매 불가"
                 class="bg-white dark:bg-white/10 border border-gray-300 dark:border-gray-600 text-gray-900 dark:text-white rounded-lg px-4 py-3 w-40" />
        </div>
      </div>

      <!-- 평점 (툴 리뷰용) -->
      <div id="rating-section" class="hidden">
        <label class="block text-sm text-gray-500 dark:text-gray-400 mb-2">⭐ 평점</label>
        <div class="flex gap-2 text-2xl" id="star-rating">
          {[1,2,3,4,5].map(i => (
            <span class="star cursor-pointer text-gray-400 dark:text-gray-500 hover:text-yellow-400" data-value={i}>★</span>
          ))}
        </div>
        <input type="hidden" id="rating" value="5" />
      </div>

      <div id="preview-section" class="hidden">
        <label class="block text-sm text-gray-500 dark:text-gray-400 mb-2">미리보기 내용 (비회원에게 보이는 부분)</label>
        <textarea id="preview_content" rows="4" maxlength="500" placeholder="유료 글의 맛보기 내용을 입력하세요"
                  class="bg-white dark:bg-white/10 border border-gray-300 dark:border-gray-600 text-gray-900 dark:text-white rounded-lg px-4 py-3 w-full resize-y"></textarea>
      </div>

      <div>
        <label class="block text-sm text-gray-500 dark:text-gray-400 mb-2">내용</label>
        <textarea id="content" rows="15" maxlength="10000" placeholder="내용을 입력하세요"
                  class="bg-white dark:bg-white/10 border border-gray-300 dark:border-gray-600 text-gray-900 dark:text-white rounded-lg px-4 py-3 w-full resize-y" required></textarea>
        <div class="text-right text-xs text-gray-500 mt-1">
          <span id="char-count">0</span> / 10,000
        </div>
      </div>

      <div class="flex justify-between items-center">
        <span class="text-sm text-gray-500 dark:text-gray-400">작성자: {currentUser.name || currentUser.email}</span>
        <div class="flex gap-3">
          <a href="/community" class="px-6 py-3 rounded-lg glass text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white transition">취소</a>
          <button type="submit" id="submit-btn"
                  class="px-6 py-3 rounded-lg bg-blue-600 hover:bg-blue-500 text-white font-medium transition">
            등록하기
          </button>
        </div>
      </div>

    </form>
  </main>

  <script>
    const form = document.getElementById('write-form') as HTMLFormElement;
    const contentEl = document.getElementById('content') as HTMLTextAreaElement;
    const charCount = document.getElementById('char-count') as HTMLSpanElement;
    const errorMsg = document.getElementById('error-msg') as HTMLDivElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

    contentEl.addEventListener('input', () => {
      charCount.textContent = String(contentEl.value.length);
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorMsg.classList.add('hidden');
      submitBtn.disabled = true;
      submitBtn.textContent = '등록 중...';

      const title = (document.getElementById('title') as HTMLInputElement).value.trim();
      const content = contentEl.value.trim();
      const category = (document.getElementById('category') as HTMLSelectElement).value;

      if (!title || !content) {
        errorMsg.textContent = '제목과 내용을 모두 입력하세요.';
        errorMsg.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = '등록하기';
        return;
      }

      try {
        const access_level = document.getElementById('access_level').value;
        const price = parseInt(document.getElementById('price').value) || 0;
        const preview_content = document.getElementById('preview_content')?.value?.trim() || '';

        const res = await fetch('/api/posts', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            title, content, category, access_level, price, preview_content,
            tool_id: document.getElementById('tool_id')?.value || null,
            rating: parseInt(document.getElementById('rating')?.value) || 5
          })
        });

        const data = await res.json();

        if (res.ok && data.success) {
          window.location.href = '/community/' + data.id;
        } else {
          errorMsg.textContent = data.error || '등록에 실패했습니다.';
          errorMsg.classList.remove('hidden');
        }
      } catch (err) {
        errorMsg.textContent = '네트워크 오류가 발생했습니다.';
        errorMsg.classList.remove('hidden');
      }

      submitBtn.disabled = false;
      submitBtn.textContent = '등록하기';
    });
  
    // 카테고리가 review면 평점 섹션 표시
    const categorySelect = document.getElementById('category');
    const ratingSection = document.getElementById('rating-section');
    categorySelect.addEventListener('change', () => {
      if (categorySelect.value === 'review') {
        ratingSection.classList.remove('hidden');
      } else {
        ratingSection.classList.add('hidden');
      }
    });
    // 페이지 로드 시 이미 review면 표시
    if (categorySelect.value === 'review') {
      ratingSection.classList.remove('hidden');
    }

    // 별점 클릭 처리
    document.querySelectorAll('.star').forEach(star => {
      star.addEventListener('click', () => {
        const val = parseInt(star.dataset.value);
        document.getElementById('rating').value = val;
        document.querySelectorAll('.star').forEach((s, i) => {
          s.classList.toggle('text-yellow-400', i < val);
          s.classList.toggle('text-gray-500', i >= val);
        });
      });
    });

    // access_level 변경 시 미리보기/가격 섹션 표시
    const accessSelect = document.getElementById('access_level');
    const previewSection = document.getElementById('preview-section');
    const priceInput = document.getElementById('price');
    accessSelect.addEventListener('change', () => {
      if (accessSelect.value !== 'free') {
        previewSection.classList.remove('hidden');
      } else {
        previewSection.classList.add('hidden');
        priceInput.value = '0';
      }
    });
  </script>
</Layout>
