---
import Layout from '../../layouts/Layout.astro';
import { verifySession } from '../../lib/auth';

let currentUser = null;
const session = Astro.cookies.get('session')?.value;
if (session) currentUser = await verifySession(session, Astro.locals.sessionSecret);

const { id } = Astro.params;
const db = Astro.locals.runtime?.env?.DB;
let post = null;
let comments = [];
let previewContent = '';
let isGated = false;
let pageTitle = '게시글을 찾을 수 없습니다';
let pageDesc = '게시글을 찾을 수 없습니다.';

// 미리보기 분할: 첫 번째 ### (H3) 또는 --- 구분선 기준으로 분할
function splitPreview(content: string): string {
  // H3 헤딩 (### )을 첫 번째 분할 지점으로
  const h3Match = content.match(/\n(?=### )/);
  if (h3Match && h3Match.index) {
    return content.slice(0, h3Match.index);
  }
  // --- 구분선을 두 번째 분할 지점으로
  const sepMatch = content.match(/\n---\n/);
  if (sepMatch && sepMatch.index) {
    return content.slice(0, sepMatch.index);
  }
  // 둘 다 없으면 상단 1/3
  return content.slice(0, Math.floor(content.length / 3));
}

if (db && id) {
  await db.prepare(`UPDATE posts SET views = views + 1 WHERE id = ?`).bind(id).run();
  post = await db.prepare(`
    SELECT p.*, u.name as author, u.avatar FROM posts p JOIN users u ON p.user_id = u.id WHERE p.id = ?
  `).bind(id).first();

  // SEO variables
  const categoryNames: Record<string, string> = {
    free: '자유게시판',
    qna: '질문답변',
    news: 'AI 뉴스',
    tip: '꿀팁공유',
    project: '프로젝트'
  };
  const catName = categoryNames[post?.category] || post?.category || '';
  const cleanContent = post?.content?.replace(/<[^>]*>/g, '').substring(0, 150) || '';
  pageTitle = post ? `${post.title} | AI코리아24 커뮤니티` : '게시글을 찾을 수 없습니다';
  pageDesc = post ? `[${catName}] ${cleanContent}` : '게시글을 찾을 수 없습니다.';

  if (!post) {
    return { notFound: true };
  }

  // MVP-2: visibility gate
  if (post.visibility === 'members' && !currentUser) {
    isGated = true;
    previewContent = splitPreview(post.content || '');
  }

  const commentResult = await db.prepare(`
    SELECT c.*, u.name, u.avatar FROM comments c JOIN users u ON c.user_id = u.id WHERE c.post_id = ? ORDER BY c.created_at
  `).bind(id).all();
  comments = commentResult.results || [];
}

if (Astro.request.method === 'POST' && currentUser && db) {
  const form = await Astro.request.formData();
  const content = form.get('content') as string;
  if (content) {
    await db.prepare(
      `INSERT INTO comments (post_id, user_id, content) VALUES (?, ?, ?)`
    ).bind(id, currentUser.id, content).run();
    return Astro.redirect(`/community/${id}`);
  }
}
---
<Layout title={pageTitle} description={pageDesc}>
  <div class="bg-[#0A0E1A] text-white min-h-screen">
    <div class="max-w-3xl mx-auto px-4 py-12">
      {!post ? (
        <p class="text-gray-500">게시글을 찾을 수 없습니다.</p>
      ) : (
        <>
          <div class="mb-8">
            <div class="flex items-center gap-2 mb-3">
              <span class="text-[10px] bg-white/[0.1] text-gray-300 px-2 py-0.5 rounded-full">{post.category}</span>
              <span class="text-sm text-gray-500">조회 {post.views}</span>
            </div>
            <h1 class="text-2xl font-bold mb-4">{post.title}</h1>
            <div class="flex items-center gap-3 mb-6">
              {post.avatar && <img src={post.avatar} alt="" class="w-8 h-8 rounded-full" />}
              <span class="text-sm text-gray-400">{post.author}</span>
              <span class="text-sm text-gray-600">{post.created_at?.slice(0, 10)}</span>
            </div>
            <div class="bg-white/[0.05] border border-white/[0.08] rounded-xl p-6 whitespace-pre-wrap text-gray-300 leading-relaxed">{isGated ? previewContent : post.content}</div>

            {isGated && (
              <div class="mt-6 p-8 rounded-xl border border-blue-500/30 bg-gradient-to-b from-blue-900/20 to-purple-900/20 text-center">
                <div class="text-3xl mb-3">🔒</div>
                <h3 class="text-lg font-bold text-white mb-2">전체 내용을 보려면 로그인하세요</h3>
                <p class="text-sm text-gray-400 mb-6">
                  AI코리아24 커뮤니티 회원에게 전체 강좌 콘텐츠를 제공합니다.<br/>
                  Google 계정 하나로 바로 시작할 수 있습니다.
                </p>
                <a href={`/auth/consent?redirect_to=/community/${id}`}
                   class="inline-block bg-gradient-to-r from-blue-600 to-purple-600 text-white px-8 py-3 rounded-xl font-semibold hover:from-blue-500 hover:to-purple-500 transition-all">
                  Google 로그인
                </a>
                <p class="text-xs text-gray-600 mt-4">
                  로그인하면 개인정보 수집·이용에 동의한 것으로 간주됩니다.
                </p>
              </div>
            )}
          </div>

          <div class="mb-8">
            <h3 class="font-semibold mb-4">댓글 {comments.length}개</h3>
            {comments.map((c: any) => (
              <div class="flex gap-3 py-3 border-b border-white/[0.06]">
                {c.avatar && <img src={c.avatar} alt="" class="w-7 h-7 rounded-full mt-0.5" />}
                <div>
                  <div class="flex items-center gap-2 mb-1">
                    <span class="text-sm font-medium">{c.name}</span>
                    <span class="text-xs text-gray-600">{c.created_at?.slice(0, 10)}</span>
                  </div>
                  <p class="text-sm text-gray-400">{c.content}</p>
                </div>
              </div>
            ))}
          </div>

          {currentUser ? (
            <form method="POST" class="flex gap-3">
              <input type="text" name="content" placeholder="댓글을 입력하세요" required
                class="flex-1 bg-white/[0.05] border border-white/[0.15] rounded-lg px-4 py-2.5 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-blue-500" />
              <button type="submit" class="bg-blue-600 text-white px-5 py-2.5 rounded-lg text-sm hover:bg-blue-500 transition-colors">등록</button>
            </form>
          ) : (
            <p class="text-sm text-gray-500">댓글을 작성하려면 <a href={`/auth/consent?redirect_to=/community/${id}`} class="text-blue-400">로그인</a>하세요.</p>
          )}
        </>
      )}
      <a href="/community" class="inline-block mt-8 text-sm text-gray-500 hover:text-gray-300">← 목록으로</a>
    </div>
  </div>
</Layout>
