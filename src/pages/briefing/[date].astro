---
export const prerender = false;
const { date } = Astro.params;
const runtime = (Astro.locals as any).runtime;
const db = runtime?.env?.DB;

let briefing: any = null;
let items: any[] = [];
let relatedNews: any[] = [];

if (db && date) {
  try {
    briefing = await db.prepare(
      "SELECT * FROM briefings WHERE date = ? AND status = 'published' LIMIT 1"
    ).bind(date).first();
    if (briefing) {
      const { results } = await db.prepare(
        `SELECT bi.*, n.title, n.description, n.link, n.source, n.category, n.country, n.pub_date
         FROM briefing_items bi
         LEFT JOIN news n ON bi.news_id = n.id
         WHERE bi.briefing_id = ?
         ORDER BY bi.sort_order`
      ).bind(briefing.id).all();
      items = results || [];

      const itemIds = items.map((i: any) => i.news_id).filter(Boolean);
      const placeholders = itemIds.map(() => '?').join(',');
      if (itemIds.length > 0) {
        const { results: related } = await db.prepare(
          `SELECT id, title, link, description, source, category, country, pub_date
           FROM news
           WHERE id NOT IN (${placeholders})
             AND created_at >= datetime('now', '-3 days')
           ORDER BY created_at DESC LIMIT 8`
        ).bind(...itemIds).all();
        relatedNews = related || [];
      }
    }
  } catch (e) {
    console.error(e);
  }
}

if (!briefing) {
  return Astro.redirect('/briefing/');
}

const d = new Date(date.substring(0,10) + 'T00:00:00');
const weekday = ['일','월','화','수','목','금','토'][d.getDay()];
const display = `${d.getFullYear()}년 ${d.getMonth()+1}월 ${d.getDate()}일 (${weekday})`;
---
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="icon" href="/favicon.png" />
<title>{display} AI 브리핑 - AI코리아24</title>
<script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5938862195544185" crossorigin="anonymous"></script>
<meta name="google-site-verification" content="kpr0gRmGKIFUW5dNLsfxba1aKpbV7wolSFk6cSOJZXA" />
<meta name="naver-site-verification" content="fa2baf09d65dfb84a55787b8740941430187b234" />
<meta name="description" content={`${display} AI 뉴스 브리핑 - ${items.length}건의 주요 AI 뉴스를 큐레이션했습니다.`} />
<style is:global>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:-apple-system,system-ui,'Noto Sans KR',sans-serif;background:#ffffff;color:#111111}
.container{max-width:720px;margin:0 auto;padding:20px 16px 80px}
.back{display:inline-block;color:#E63B2E;text-decoration:none;font-size:14px;margin-bottom:20px}
.back:hover{text-decoration:underline}
.header{text-align:center;margin-bottom:28px}
.header h1{font-size:28px;font-weight:800;margin-bottom:4px}
.header .sub{font-size:14px;color:#555555}
.intro{font-size:15px;color:#111111;line-height:1.7;margin-bottom:28px;padding:16px;background:#f7f7f7;border-radius:12px;border-left:4px solid #E63B2E}
.count{font-size:13px;color:#6b7280;margin-bottom:16px}
.article{background:#ffffff;border:1px solid #e5e7eb;border-radius:14px;padding:20px;margin-bottom:16px;scroll-margin-top:20px;transition:border-color .2s}
.article:hover{border-color:#E63B2E}
.article-num{display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;background:#111111;border-radius:8px;color:#fff;font-size:13px;font-weight:700;margin-right:10px;flex-shrink:0}
.article-top{display:flex;align-items:flex-start;margin-bottom:10px}
.article-title{font-size:18px;font-weight:700;color:#111111;line-height:1.5}
.article-comment{font-size:14px;color:#111111;line-height:1.6;margin-bottom:10px;padding:10px 14px;background:#f7f7f7;border-radius:8px;border-left:3px solid #E63B2E}
.article-desc{font-size:13px;color:#555555;line-height:1.6;margin-bottom:12px}
.article-footer{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px}
.article-meta{display:flex;gap:6px;flex-wrap:wrap;align-items:center;font-size:11px}
.tag{padding:3px 8px;border-radius:4px;background:#f7f7f7;color:#555555}
.tag.kr{background:#fdeaea;color:#E63B2E}
.tag.global{background:#f7f7f7;color:#555555}
.tag.policy{background:#fef3e2;color:#b45309}
.tag.benefit{background:#f5effe;color:#7c3aed}
.source-link{display:inline-flex;align-items:center;gap:4px;padding:6px 14px;background:#111111;color:#fff;border:1px solid #111111;border-radius:6px;font-size:12px;text-decoration:none;transition:all .2s}
.source-link:hover{background:#333333;border-color:#333333}
.divider{border:none;border-top:1px solid #e5e7eb;margin:32px 0}
.related-title{font-size:18px;font-weight:700;margin-bottom:14px;display:flex;align-items:center;gap:8px;border-left:4px solid #E63B2E;padding-left:12px}
.related-title .icon{font-size:20px}
.r-card{background:#ffffff;border:1px solid #e5e7eb;border-radius:10px;padding:14px;margin-bottom:10px;text-decoration:none;color:#111111;display:block;transition:border-color .2s}
.r-card:hover{border-color:#E63B2E}
.r-title{font-size:14px;font-weight:600;color:#111111;line-height:1.4;margin-bottom:4px}
.r-desc{font-size:12px;color:#555555;line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.r-meta{font-size:11px;color:#6b7280;margin-top:6px}
.deep-dive{display:flex;align-items:center;gap:10px;margin-top:12px;padding:10px 14px;background:#f7f7f7;border:1px solid #e5e7eb;border-radius:8px;text-decoration:none;transition:all .2s}
.deep-dive:hover{border-color:#E63B2E}
.deep-dive .dd-icon{font-size:16px;flex-shrink:0}
.deep-dive .dd-text{display:flex;flex-direction:column;gap:2px}
.deep-dive .dd-label{font-size:10px;font-weight:700;color:#E63B2E;letter-spacing:.05em;text-transform:uppercase}
.deep-dive .dd-title{font-size:13px;font-weight:600;color:#111111;line-height:1.4}
.nav-bar{display:flex;justify-content:center;gap:12px;margin-top:28px}
.nav-btn{padding:10px 20px;background:#ffffff;border:1px solid #e5e7eb;border-radius:8px;color:#111111;text-decoration:none;font-size:13px;transition:all .2s}
.nav-btn:hover{border-color:#E63B2E;background:#f7f7f7}
/* 통합 네비게이션 */
.site-nav{position:sticky;top:0;z-index:50;background:rgba(255,255,255,0.85);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-bottom:1px solid rgba(0,0,0,0.08)}
.nav-inner{max-width:1152px;margin:0 auto;height:56px;display:flex;align-items:center;justify-content:space-between;padding:0 16px}
.nav-logo{font-size:18px;font-weight:800;color:#111111;text-decoration:none}
.nav-links{display:flex;align-items:center;gap:24px}
.nav-link{font-size:14px;font-weight:500;color:#555555;text-decoration:none;transition:color .2s}
.nav-link:hover{color:#E63B2E}
.nav-link.active{color:#E63B2E}
.nav-right{display:flex;align-items:center;gap:8px}
.icon-btn{background:none;border:none;padding:8px;border-radius:8px;color:#555555;cursor:pointer;transition:all .2s;display:flex;align-items:center;justify-content:center}
.icon-btn:hover{background:rgba(0,0,0,0.05);color:#111111}
.mobile-only{display:none}
.mobile-menu{display:none;padding:8px 16px 12px;border-top:1px solid rgba(0,0,0,0.06)}
.mobile-menu.open{display:block}
.mobile-link{display:block;padding:10px 0;font-size:14px;color:#555555;text-decoration:none;border-bottom:1px solid rgba(0,0,0,0.04)}
.mobile-link:last-child{border-bottom:none}
.mobile-link.active{color:#E63B2E}
.mobile-link:hover{color:#E63B2E}
@media(max-width:768px){.nav-links{display:none}.mobile-only{display:flex}}

</style>
</head>
<body>
<nav class="site-nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo">AI코리아24</a>
    <div class="nav-links">
      <a href="/blog" class="nav-link">블로그</a>
      <a href="/tools" class="nav-link">AI 도구</a>
      <a href="/glossary" class="nav-link">용어사전</a>
      <a href="/briefing/" class="nav-link active">브리핑</a>
      <a href="/news" class="nav-link">뉴스</a>
    </div>
    <div class="nav-right">
      <button id="mobile-menu-btn" class="icon-btn mobile-only" aria-label="메뉴">
        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </div>
  <div id="mobile-menu" class="mobile-menu">
    <a href="/blog" class="mobile-link">블로그</a>
    <a href="/tools" class="mobile-link">AI 도구</a>
    <a href="/glossary" class="mobile-link">용어사전</a>
    <a href="/briefing/" class="mobile-link active">브리핑</a>
    <a href="/news" class="mobile-link">뉴스</a>
  </div>
</nav>

<div style="text-align:center;margin:16px auto;max-width:728px;">
  <ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-5938862195544185" data-ad-slot="3350911709" data-ad-format="auto" data-full-width-responsive="true"></ins>
  <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
</div>
<div class="container">
  <a href="/briefing/" class="back">&larr; 브리핑 목록</a>
  <div class="header">
    <h1>{display}</h1>
    <div class="sub">AI코리아24 데일리 브리핑 &middot; {items.length}건</div>
  </div>
  {briefing.intro && <div class="intro">{briefing.intro}</div>}
  {items.map((item: any, idx: number) => (
    <article class="article" id={`item-${idx+1}`}>
      <div class="article-top">
        <span class="article-num">{idx + 1}</span>
        <div class="article-title">{item.title}</div>
      </div>
      {item.comment && <div class="article-comment">{item.comment}</div>}
      <div class="article-footer">
        <div class="article-meta">
          {item.source && <span class="tag">{item.source}</span>}
          {item.country && item.country !== 'kr'
            ? <span class="tag global">해외</span>
            : <span class="tag kr">국내</span>}
          {item.category === 'policy' && <span class="tag policy">정책</span>}
          {item.category === 'benefit' && <span class="tag benefit">혜택</span>}
        </div>
        {item.link && <a href={item.link} target="_blank" rel="noopener" class="source-link">원문 보기 &rarr;</a>}
      </div>
      {item.deep_dive_url && (
        <a href={item.deep_dive_url} class="deep-dive">
          <span class="dd-icon">📖</span>
          <span class="dd-text">
            <span class="dd-label">AI코리아24 심층 분석</span>
            <span class="dd-title">이 뉴스, 더 깊이 읽기 →</span>
          </span>
        </a>
      )}
    </article>
  ))}
  {relatedNews.length > 0 && (
    <div>
      <hr class="divider" />
      <div class="related-title"><span class="icon">📰</span> 오늘의 다른 AI 뉴스</div>
      {relatedNews.map((n: any) => (
        <a href={n.link} target="_blank" rel="noopener" class="r-card">
          <div class="r-title">{n.title}</div>
          {n.description && <div class="r-desc">{n.description}</div>}
          <div class="r-meta">{n.source} {n.country !== 'kr' ? '· 해외' : ''}</div>
        </a>
      ))}
    </div>
  )}
  <div class="nav-bar">
    <a href="/briefing/" class="nav-btn">&larr; 브리핑 목록</a>
    <a href="/" class="nav-btn">메인으로 &rarr;</a>
  </div>
</div>
<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    var articles = document.querySelectorAll('.article');
    if (articles.length >= 3) {
      var adDiv = document.createElement('div');
      adDiv.style.cssText = 'margin-bottom:16px';
      adDiv.innerHTML = '<ins class="adsbygoogle" style="display:block;text-align:center" data-ad-layout="in-article" data-ad-format="fluid" data-ad-client="ca-pub-5938862195544185" data-ad-slot="3350911709"></ins>';
      articles[2].insertAdjacentElement('afterend', adDiv);
      try { (window.adsbygoogle = window.adsbygoogle || []).push({}); } catch(e) {}
    }
    var divider = document.querySelector('.divider');
    if (divider) {
      var adDiv2 = document.createElement('div');
      adDiv2.style.cssText = 'margin:24px 0';
      adDiv2.innerHTML = '<ins class="adsbygoogle" style="display:block;text-align:center" data-ad-layout="in-article" data-ad-format="fluid" data-ad-client="ca-pub-5938862195544185" data-ad-slot="3350911709"></ins>';
      divider.insertAdjacentElement('beforebegin', adDiv2);
      try { (window.adsbygoogle = window.adsbygoogle || []).push({}); } catch(e) {}
    }
  });
</script>
<div style="text-align:center;margin:16px auto;max-width:728px;">
  <ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-5938862195544185" data-ad-slot="3350911709" data-ad-format="auto" data-full-width-responsive="true"></ins>
  <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
</div>
<script is:inline>
document.addEventListener('DOMContentLoaded', function() {
  // 시안 A는 라이트 전용 — 테마 토글 제거됨(2026-10-10, AIK24-RENEWAL-01)
  var mobileBtn = document.getElementById('mobile-menu-btn');
  var mobileMenu = document.getElementById('mobile-menu');

  if (mobileBtn && mobileMenu) {
    mobileBtn.addEventListener('click', function() {
      mobileMenu.classList.toggle('open');
    });
  }
});
</script>

</body>
</html>
