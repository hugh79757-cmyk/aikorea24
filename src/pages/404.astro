---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
---
<Layout title="페이지를 찾을 수 없습니다 - AI코리아24">
  <div style="text-align:center; padding: 80px 20px;">
    <img
      src="/mascot-tiger.png"
      alt="AI 코리아24 호랑이 마스코트"
      width="240"
      height="240"
      loading="eager"
      decoding="async"
      style="max-width:60%; height:auto; margin:0 auto 8px; display:block;"
      onerror="this.onerror=null;this.src='/logo-final.webp';"
    />
    <h1 style="font-family: var(--font-sans); font-size:4rem; font-weight:700; color:#111111;">404</h1>
    <p style="font-size:1.2rem; margin:16px 0; color:#111111;">요청하신 페이지를 찾을 수 없습니다.</p>
    <a href="/" style="display:inline-block; margin-top:24px; padding:12px 28px; background:#111111; color:#fff; border-radius:8px; text-decoration:none; transition:background 0.2s;" onmouseover="this.style.background='#333333'" onmouseout="this.style.background='#111111'">
      홈으로 돌아가기
    </a>
  </div>
</Layout>