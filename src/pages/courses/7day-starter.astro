---
import Layout from '../../layouts/Layout.astro';

const runtime = (Astro.locals as any).runtime;
const db = runtime?.env?.DB;

// 강좌 정보 조회
let course = {
  slug: '7day-starter',
  title: '7일 AI 입문 — ChatGPT부터 시작하는 AI 활용법',
  description: '매일 저녁 5분, 7일 동안 AI 기초를 완성합니다. ChatGPT 사용법부터 프롬프트 작성, 이미지 생성, 업무 활용까지. 완전 무료, 커뮤니티에서 질문하며 학습하세요.',
  total_days: 7,
};

if (db) {
  const row = await db.prepare('SELECT * FROM courses WHERE slug = ?').bind('7day-starter').first();
  if (row) course = { ...course, ...row };
}

// 커리큘럼 데이터
const curriculum = [
  { day: 1, title: 'ChatGPT, 처음 시작하기', desc: '계정 생성부터 첫 대화까지, 10분이면 시작할 수 있습니다.' },
  { day: 2, title: '프롬프트, 명확하게 물어보기', desc: '똑같은 질문도 프롬프트 하나로 답변 품질이 달라집니다.' },
  { day: 3, title: '이미지 생성, 한 장으로 시작', desc: '텍스트만으로 원하는 이미지를 만드는 방법을 배웁니다.' },
  { day: 4, title: '업무에 AI 끼얹기', desc: '마케터, 개발자, 디자이너, 자영업자별 맞춤 활용법.' },
  { day: 5, title: 'AI 도구, 나에게 맞는 것 찾기', desc: '119개 도구 중 내게 딱 맞는 도구를 고르는 가이드.' },
  { day: 6, title: 'AI 용어, 더 이상 어렵지 않게', desc: 'LLM, RAG, 파인튜닝 — 핵심 용어 20선으로 정리.' },
  { day: 7, title: '다음 단계로', desc: '완강! 이제 AI코리아24 커뮤니티에서 계속 성장하세요.' },
];

const pageTitle = `${course.title} | AI코리아24`;
const pageDesc = course.description;
---

<Layout title={pageTitle} description={pageDesc}>
  <div class="bg-[#0A0E1A] text-white min-h-screen">

    {/* HERO */}
    <section class="relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-blue-900/40 via-purple-900/30 to-transparent pointer-events-none" />
      <div class="max-w-4xl mx-auto px-4 py-20 md:py-28 relative">
        <div class="text-center mb-6">
          <span class="inline-block px-3 py-1 rounded-full text-xs font-medium bg-amber-500/20 text-amber-300 mb-4">
            🎯 곧 오픈 · 알림 신청 중
          </span>
        </div>
        <h1 class="text-3xl md:text-5xl font-bold text-center leading-snug mb-4">
          AI, 처음이세요?
          <span class="block text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-purple-400 mt-2">
            7일면 충분합니다
          </span>
        </h1>
        <p class="text-lg text-gray-400 text-center max-w-2xl mx-auto mb-8 leading-relaxed">
          매일 저녁 5분, 7일 동안 AI 기초를 완성하세요.
          ChatGPT 사용법부터 프롬프트 작성, 이미지 생성, 업무 활용까지.
          커뮤니티에서 질문하며 함께 학습합니다.
        </p>

        {/* Coming Soon Notice */}
        <div class="max-w-md mx-auto mb-4 px-3 py-3 rounded-xl bg-amber-500/10 border border-amber-500/20 text-sm text-amber-300 text-center">
          📢 강좌가 곧 오픈됩니다. 준비되면 이메일로 알려드리겠습니다.
        </div>

        {/* Signup Form */}
        <div class="max-w-md mx-auto" id="signup-section">
          <form id="enroll-form" class="flex flex-col sm:flex-row gap-3">
            <input
              type="email"
              id="email-input"
              placeholder="이메일을 입력하세요"
              required
              class="flex-1 bg-white/10 border border-white/20 rounded-xl px-5 py-3.5 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-blue-500 transition"
            />
            <button
              type="submit"
              id="enroll-btn"
              class="bg-gradient-to-r from-blue-600 to-purple-600 text-white px-8 py-3.5 rounded-xl text-sm font-semibold hover:from-blue-500 hover:to-purple-500 transition-all whitespace-nowrap disabled:opacity-50 disabled:cursor-not-allowed"
            >
              오픈 알림 신청
            </button>
          </form>
          <div id="enroll-message" class="mt-4 text-sm text-center"></div>
          <p class="text-xs text-gray-400 text-center mt-3">구독 해지는 언제든 가능합니다. 스팸 메일은 없습니다.</p>
        </div>

        {/* Social proof — full-bleed */}
        <div class="-mx-4 mt-10 py-5 px-4 bg-white/[0.02] border-y border-white/[0.06]">
          <div class="flex justify-center gap-6 md:gap-8 text-center">
            <div>
              <div class="text-xl md:text-3xl font-bold text-white">7일</div>
              <div class="text-xs text-gray-400">총 학습 기간</div>
            </div>
            <div>
              <div class="text-xl md:text-3xl font-bold text-white">5분</div>
              <div class="text-xs text-gray-400">일일 학습 시간</div>
            </div>
            <div>
              <div class="text-xl md:text-3xl font-bold text-white">무료</div>
              <div class="text-xs text-gray-400">평생 무료</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* 커리큘럼 */}
    <section class="max-w-4xl mx-auto px-4 py-12 md:py-16">
      <h2 class="text-xl md:text-2xl font-bold text-center mb-2">7일 커리큘럼</h2>
      <p class="text-gray-400 text-center mb-10 md:mb-12">매일 저녁 이메일로 전송됩니다</p>

      <div class="grid gap-3 md:gap-4">
        {curriculum.map((item) => (
          <div class="flex gap-3 md:gap-4 items-start p-4 md:p-5 rounded-xl bg-white/[0.03] border border-white/[0.08] hover:bg-white/[0.06] transition">
            <div class="w-9 h-9 md:w-10 md:h-10 rounded-full bg-gradient-to-br from-blue-500 to-purple-500 flex items-center justify-center text-xs md:text-sm font-bold shrink-0">
              {item.day}
            </div>
            <div>
              <h3 class="font-semibold text-white mb-0.5 md:mb-1 leading-snug">{item.title}</h3>
              <p class="text-sm text-gray-300 leading-relaxed">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    {/* HOW IT WORKS */}
    <section class="max-w-4xl mx-auto px-4 py-12 md:py-16">
      <h2 class="text-xl md:text-2xl font-bold text-center mb-8 md:mb-12">이렇게 진행됩니다</h2>
      <div class="grid md:grid-cols-3 gap-6 md:gap-8 text-center">
        <div>
          <div class="w-12 h-12 md:w-16 md:h-16 rounded-2xl bg-blue-500/20 flex items-center justify-center mx-auto mb-3 md:mb-4">
            <svg class="w-6 h-6 md:w-8 md:h-8 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="font-semibold mb-2">1. 이메일로 신청</h3>
          <p class="text-sm text-gray-300 leading-relaxed">이메일 하나로 바로 시작합니다. 복잡한 가입 절차 없음.</p>
        </div>
        <div>
          <div class="w-12 h-12 md:w-16 md:h-16 rounded-2xl bg-purple-500/20 flex items-center justify-center mx-auto mb-3 md:mb-4">
            <svg class="w-6 h-6 md:w-8 md:h-8 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
            </svg>
          </div>
          <h3 class="font-semibold mb-2">2. 매일 저녁 이메일</h3>
          <p class="text-sm text-gray-300 leading-relaxed">18시에 오늘의 레슨이 담긴 이메일이 도착합니다. 티저를 읽고 커뮤니티에서 전체 내용을 확인하세요.</p>
        </div>
        <div>
          <div class="w-12 h-12 md:w-16 md:h-16 rounded-2xl bg-green-500/20 flex items-center justify-center mx-auto mb-3 md:mb-4">
            <svg class="w-6 h-6 md:w-8 md:h-8 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <h3 class="font-semibold mb-2">3. 커뮤니티에서 성장</h3>
          <p class="text-sm text-gray-300 leading-relaxed">로그인 후 전체 레슨을 읽고, 댓글로 질문하며 다른 수강생과 함께 배웁니다.</p>
        </div>
      </div>
    </section>

    {/* FAQ */}
    <section class="max-w-3xl mx-auto px-4 py-12 md:py-16">
      <h2 class="text-xl md:text-2xl font-bold text-center mb-8 md:mb-12">자주 묻는 질문</h2>
      <div class="space-y-4">
        {[
          { q: '진짜 무료인가요?', a: '네, 완전 무료입니다. 결제 정보를 요구하지 않습니다.' },
          { q: '하루에 얼마나 시간이 필요한가요?', a: '레슨은 5분 분량입니다. 커뮤니티 글까지 읽으면 15분 정도 소요됩니다.' },
          { q: 'AI에 대해 아무것도 몰라도 되나요?', a: '네, 초보자를 기준으로 구성했습니다. 용어부터 하나씩 설명해드립니다.' },
          { q: '이메일 외에 다른 정보가 필요한가요?', a: '이메일만 있으면 됩니다. 전체 레슨을 보려면 커뮤니티 회원가입(Google 로그인)이 필요합니다.' },
          { q: '중간에 그만두면 어떻게 되나요?', a: '언제든지 구독을 해지할 수 있습니다. 다시 시작하고 싶으면 재신청하세요.' },
        ].map((faq) => (
          <details class="group bg-white/[0.03] border border-white/[0.08] rounded-xl overflow-hidden">
            <summary class="px-4 md:px-5 py-4 cursor-pointer font-medium text-sm text-white hover:bg-white/[0.03] transition flex items-center justify-between min-h-[44px]">
              {faq.q}
              <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition shrink-0 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-4 md:px-5 pb-4 text-sm text-gray-300 leading-relaxed">
              {faq.a}
            </div>
          </details>
        ))}
      </div>
    </section>

    {/* CTA */}
    <section class="max-w-4xl mx-auto px-4 pb-20 md:pb-24">
      <div class="text-center bg-gradient-to-r from-blue-900/30 to-purple-900/30 border border-white/[0.08] rounded-2xl p-6 md:p-12">
        <h2 class="text-xl md:text-2xl font-bold mb-4">곧 오픈됩니다</h2>
        <p class="text-gray-300 mb-6 md:mb-8">알림을 신청하고 가장 먼저 시작하세요.</p>
        <a href="#signup-section"
           class="inline-block bg-gradient-to-r from-blue-600 to-purple-600 text-white w-full sm:w-auto px-8 md:px-10 py-4 rounded-xl text-sm md:text-base font-semibold hover:from-blue-500 hover:to-purple-500 transition-all">
          오픈 알림 신청
        </a>
      </div>
    </section>

  </div>
</Layout>

<script>
  const form = document.getElementById('enroll-form');
  const emailInput = document.getElementById('email-input');
  const btn = document.getElementById('enroll-btn');
  const msg = document.getElementById('enroll-message');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = emailInput.value.trim();
      if (!email) return;

      btn.disabled = true;
      btn.textContent = '처리 중...';
      msg.innerHTML = '';
      msg.className = 'mt-4 text-sm text-center';

      try {
        const res = await fetch('/api/courses/enroll', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, course_slug: '7day-starter' }),
        });
        const data = await res.json();

        if (data.ok) {
          msg.className = 'mt-4 text-sm text-center text-green-400';
          msg.innerHTML = `
            <p class="font-semibold">🎉 오픈 알림이 등록되었습니다!</p>
            <p class="text-gray-400 mt-1">준비가 완료되면 ${data.first_lesson_at}에 첫 레슨을 보내드립니다.</p>
          `;
          emailInput.value = '';
          btn.textContent = '✅ 알림 등록 완료';
        } else if (data.reason === 'already_enrolled') {
          const day = data.current_day || 0;
          msg.className = 'mt-4 text-sm text-center text-yellow-400';
          msg.innerHTML = `
            <p>이미 등록된 이메일입니다. (${day}/${data.total_days || 7}일차 진행 중)</p>
            <p class="text-gray-400 mt-1">다음 레슨: ${data.next_lesson_at ?? '곧 발송 예정'}</p>
          `;
          btn.textContent = '🔄 이미 등록됨';
        } else {
          msg.className = 'mt-4 text-sm text-center text-red-400';
          msg.textContent = data.error || '오류가 발생했습니다. 다시 시도해주세요.';
          btn.disabled = false;
          btn.textContent = '오픈 알림 신청';
        }
      } catch (err) {
        msg.className = 'mt-4 text-sm text-center text-red-400';
        msg.textContent = '네트워크 오류가 발생했습니다. 다시 시도해주세요.';
        btn.disabled = false;
        btn.textContent = '오픈 알림 신청';
      }
    });
  }
</script>
