---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allTools = (await getCollection('tools'))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const categories = [
  { id: 'all', label: '전체', emoji: '🔥' },
  { id: '글쓰기·챗봇', label: '글쓰기·챗봇', emoji: '✍️' },
  { id: '이미지 생성', label: '이미지 생성', emoji: '🎨' },
  { id: '영상·음성', label: '영상·음성', emoji: '🎬' },
  { id: '업무·생산성', label: '업무·생산성', emoji: '📊' },
  { id: '코딩·개발', label: '코딩·개발', emoji: '💻' },
  { id: '디자인', label: '디자인', emoji: '🖼️' },
  { id: '번역·학습', label: '번역·학습', emoji: '🌐' },
];

const difficultyColor = (d: string) => {
  if (d.includes('초보')) return 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200';
  if (d.includes('중급')) return 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200';
  return 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200';
};

const difficultyLabel = (d: string) => {
  if (d.includes('초보')) return '🌱 초보자 OK';
  if (d.includes('중급')) return '🔧 중급';
  return '⚡ 고급';
};
---

<Layout title="AI 도구 디렉토리" description="일반인도 바로 쓸 수 있는 AI 도구를 카테고리별로 추천합니다. 무료·유료, 한국어 지원 여부, 난이도까지 한눈에 비교하세요.">
  <div class="max-w-6xl mx-auto px-4 py-12">

    <!-- 히어로 섹션 (메인 페이지 스타일 일관) -->
    <div class="relative overflow-hidden rounded-2xl bg-[#0A0E1A] border border-gray-800/80 p-8 mb-8">
      <!-- 앰비언트 글로우 -->
      <div class="absolute top-[-30%] left-[-5%] w-[400px] h-[400px] bg-blue-600/25 rounded-full blur-[120px] animate-pulse-slow"></div>
      <div class="absolute bottom-[-20%] right-[-5%] w-[350px] h-[350px] bg-purple-600/15 rounded-full blur-[100px] animate-pulse-slow2"></div>
      <div class="relative z-10">
        <h1 class="text-3xl md:text-4xl font-bold text-white mb-3 leading-tight">
          🇰🇷 AI 도구, 한국에서 제대로 쓰는 법
        </h1>
        <p class="text-blue-200/90 max-w-2xl mb-6 text-base leading-relaxed">
          ChatGPT부터 Cursor까지, 한국어 지원 여부와 실전 사용 팁을 한눈에 비교하세요.
          AI코리아24가 초보자도 바로 쓸 수 있도록 안내합니다.
        </p>
        <div class="flex flex-wrap gap-3">
          <span class="px-3 py-1.5 bg-blue-500/15 text-blue-300 text-sm rounded-full border border-blue-500/25 font-medium">
            {allTools.length}+개 툴
          </span>
          <span class="px-3 py-1.5 bg-emerald-500/15 text-emerald-300 text-sm rounded-full border border-emerald-500/25 font-medium">
            {allTools.filter(t => t.data.koreanSupport).length}개 한국어 지원
          </span>
          <span class="px-3 py-1.5 bg-purple-500/15 text-purple-300 text-sm rounded-full border border-purple-500/25 font-medium">
            {allTools.filter(t => t.data.difficulty && t.data.difficulty.includes('초보')).length}개 초보자 가능
          </span>
        </div>
      </div>
    </div>

    <!-- 퀵 액션 칩 (태스크 기반 탐색) -->
    <div class="flex flex-wrap gap-2 mb-6">
      <a href="/tools/task/" class="px-4 py-2 bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-full text-sm border border-gray-200 dark:border-gray-700 transition-all">
        🔥 전체 태스크
      </a>
      <a href="/tools/task/글쓰기/" class="px-4 py-2 bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-full text-sm border border-gray-200 dark:border-gray-700 transition-all">
        ✍️ 글쓰기
      </a>
      <a href="/tools/task/이미지-생성/" class="px-4 py-2 bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-full text-sm border border-gray-200 dark:border-gray-700 transition-all">
        🎨 이미지 생성
      </a>
      <a href="/tools/task/코딩/" class="px-4 py-2 bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-full text-sm border border-gray-200 dark:border-gray-700 transition-all">
        💻 코딩
      </a>
      <a href="/tools/task/영상-제작/" class="px-4 py-2 bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-full text-sm border border-gray-200 dark:border-gray-700 transition-all">
        🎬 영상 제작
      </a>
      <a href="/tools/task/번역/" class="px-4 py-2 bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-full text-sm border border-gray-200 dark:border-gray-700 transition-all">
        🌐 번역
      </a>
      <a href="/tools/task/업무-자동화/" class="px-4 py-2 bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-full text-sm border border-gray-200 dark:border-gray-700 transition-all">
        🤖 업무 자동화
      </a>
    </div>

    <!-- 카테고리 필터 -->
    <div class="flex flex-wrap justify-center gap-2 mb-10" id="category-filter">
      {categories.map(cat => (
        <button
          data-category={cat.id}
          class:list={[
            'filter-btn px-4 py-2 rounded-full text-sm font-medium transition-all border',
            cat.id === 'all'
              ? 'bg-blue-600 text-white border-blue-600'
              : 'bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 border-gray-200 dark:border-gray-700 hover:border-blue-400'
          ]}
        >
          {cat.emoji} {cat.label}
        </button>
      ))}
    </div>

    <!-- 검색창 -->
    <div class="max-w-xl mx-auto mb-6">
      <div class="relative">
        <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <input type="text" id="tool-search" placeholder="툴 이름, 태그로 검색..." class="w-full pl-12 pr-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition" />
      </div>
    </div>

    <div class="flex flex-wrap justify-center gap-3 mb-6" id="advanced-filters">
      <label class="flex items-center gap-2 px-4 py-2 rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 cursor-pointer hover:border-blue-400 transition text-sm">
        <input type="checkbox" id="filter-free" class="rounded text-blue-600 focus:ring-blue-500" />
        <span>💰 무료만</span>
      </label>
      <label class="flex items-center gap-2 px-4 py-2 rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 cursor-pointer hover:border-blue-400 transition text-sm">
        <input type="checkbox" id="filter-korean" class="rounded text-blue-600 focus:ring-blue-500" />
        <span>🇰🇷 한국어 지원</span>
      </label>
      <select id="sort-order" class="px-4 py-2 rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-sm outline-none">
        <option value="order">추천순</option>
        <option value="name">이름순</option>
        <option value="updated">최신순</option>
        <option value="review">⭐ 리뷰 많은 순</option>
      </select>
    </div>

    <!-- 도구 카드 그리드 -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="tools-grid">
      {allTools.map((tool, i) => {
        const firstUc = tool.data.useCases?.slice(0, 2) || [];
        return (
        <a
          href={`/tools/${tool.id}/`}
          data-cat={tool.data.category}
          data-index={i}
          data-name={tool.data.name}
          data-tags={tool.data.tags.join(' ')}
          data-desc={tool.data.description}
          data-price={tool.data.price}
          data-korean={tool.data.koreanSupport}
          data-difficulty={tool.data.difficulty}
          data-order={tool.data.order}
          data-updated={tool.data.updated || ''}
          data-review={0}
          class="tool-card block bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5 hover:shadow-lg hover:border-blue-500 dark:hover:border-blue-500 transition-all group"
        >
          <div class="flex items-start justify-between mb-2">
            <h3 class="text-lg font-bold text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
              {tool.data.name}
            </h3>
            <div class="flex gap-1.5 flex-shrink-0">
              {tool.data.koreanSupport && (
                <span class="text-xs px-2 py-0.5 bg-green-100 dark:bg-green-600/20 text-green-700 dark:text-green-400 rounded-full border border-green-600/30" title="한국어 지원">
                  🇰🇷
                </span>
              )}
              <span class="text-xs px-2 py-0.5 bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 rounded-full">
                {tool.data.price || '—'}
              </span>
            </div>
          </div>

          <p class="text-sm text-gray-600 dark:text-gray-400 mb-3 line-clamp-2">
            {tool.data.description}
          </p>

          <div class="flex flex-wrap items-center justify-between gap-2">
            <div class="flex flex-wrap gap-1.5">
              <span class={['text-xs px-2 py-0.5 rounded-full', difficultyColor(tool.data.difficulty)]}>
                {difficultyLabel(tool.data.difficulty)}
              </span>
              {firstUc.map(uc => (
                <span class="text-xs px-2 py-0.5 bg-blue-50 dark:bg-blue-600/10 text-blue-600 dark:text-blue-400 rounded-full">
                  {uc}
                </span>
              ))}
            </div>

            <div class="flex-shrink-0">
              <span class="text-xs text-yellow-500">
                ★ —
              </span>
            </div>
          </div>
        </a>
      );})}
    </div>

    <!-- 더 보기 버튼 -->
    <div class="text-center mt-8" id="load-more-container">
      <button
        id="load-more-btn"
        class="inline-flex items-center gap-2 px-8 py-3 bg-white dark:bg-gray-800 border-2 border-blue-500 text-blue-600 dark:text-blue-400 font-medium rounded-xl hover:bg-blue-50 dark:hover:bg-blue-900/20 transition-colors"
      >
        더 보기 (<span id="load-more-count">24</span>개 남음)
      </button>
    </div>

    <!-- 도구 수 표시 -->
    <div class="text-center mt-4 text-sm text-gray-500 dark:text-gray-400">
      총 <strong id="tool-count">{allTools.length}</strong>개 도구
    </div>

    <!-- 뉴스레터 구독 CTA -->
    <div class="mt-16 bg-gradient-to-r from-blue-50 to-indigo-50 dark:from-gray-800 dark:to-gray-750 rounded-2xl p-8 border border-blue-100 dark:border-gray-700">
      <div class="text-center max-w-xl mx-auto">
        <div class="text-3xl mb-3">🚀</div>
        <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">AI 트렌드, 매일 아침 요약해드려요</h3>
        <p class="text-gray-600 dark:text-gray-400 text-sm mb-6">
          매일 아침 7시, 국내외 AI 소식을 큐레이션해서 보내드립니다. 무료입니다.
        </p>
        <form id="brevo-subscribe" class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
          <input
            type="email"
            id="subscribe-email"
            placeholder="이메일 주소를 입력하세요"
            required
            class="flex-1 px-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none text-sm"
          />
          <button
            type="submit"
            class="px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-xl transition-colors text-sm whitespace-nowrap"
          >
            무료 구독하기
          </button>
        </form>
        <p id="subscribe-message" class="mt-3 text-sm hidden"></p>
        <p class="text-xs text-gray-400 mt-2">· 언제든 구독 해지 가능</p>
      </div>
    </div>

  </div>

  <style is:global>
    .tool-card {
      transition: all 0.2s ease;
    }
    .tool-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(59, 130, 246, 0.15);
    }
    .line-clamp-2 {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    @keyframes pulse-slow { 0%, 100% { opacity: 0.25; transform: scale(1); } 50% { opacity: 0.45; transform: scale(1.08); } }
    @keyframes pulse-slow2 { 0%, 100% { opacity: 0.15; transform: scale(1); } 50% { opacity: 0.3; transform: scale(1.12); } }
    .animate-pulse-slow { animation: pulse-slow 8s ease-in-out infinite; }
    .animate-pulse-slow2 { animation: pulse-slow2 10s ease-in-out infinite 2s; }
  </style>
</Layout>

<script>
  const PAGE_SIZE = 24;
  const buttons = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.tool-card');
  const countEl = document.getElementById('tool-count');
  const loadMoreBtn = document.getElementById('load-more-btn');
  const loadMoreCount = document.getElementById('load-more-count');
  const loadMoreContainer = document.getElementById('load-more-container');

  // 현재 상태
  let activeCategory = 'all';
  // 각 카테고리별로 현재 몇 개까지 보여줄지
  const shownCount: Record<string, number> = {};

  function getVisibleCards() {
    return Array.from(cards).filter(c => {
      const cat = c.getAttribute('data-cat');
      return activeCategory === 'all' || cat === activeCategory;
    });
  }

  function applyVisibility() {
    const visible = getVisibleCards();
    const currentShown = shownCount[activeCategory] ?? PAGE_SIZE;
    let shown = 0;

    visible.forEach((card, i) => {
      if (i < currentShown) {
        (card as HTMLElement).style.display = '';
        shown++;
      } else {
        (card as HTMLElement).style.display = 'none';
      }
    });

    // 안 보이는 카드 (다른 카테고리)도 숨김
    cards.forEach(c => {
      const cat = c.getAttribute('data-cat');
      if (activeCategory !== 'all' && cat !== activeCategory) {
        (c as HTMLElement).style.display = 'none';
      }
    });

    // 카운트 업데이트
    if (countEl) countEl.textContent = String(visible.length);

    // 더 보기 버튼 상태
    const remaining = visible.length - currentShown;
    if (loadMoreContainer && loadMoreCount) {
      if (remaining > 0) {
        loadMoreContainer.style.display = '';
        loadMoreCount.textContent = String(Math.min(remaining, PAGE_SIZE));
      } else {
        loadMoreContainer.style.display = 'none';
      }
    }

    // 광고 재삽입
    insertAds();
  }

  function insertAds() {
    document.querySelectorAll('.tools-ad-unit').forEach(function(el) { el.remove(); });
    const grid = document.getElementById('tools-grid');
    if (!grid) return;
    const visibleCards = getVisibleCards().filter(c => (c as HTMLElement).style.display !== 'none');
    let adCount = 0;
    [8, 17].forEach(function(pos) {
      if (pos >= visibleCards.length || adCount >= 2) return;
      var adWrapper = document.createElement('div');
      adWrapper.className = 'tools-ad-unit';
      adWrapper.style.cssText = 'grid-column: 1 / -1; padding: 8px 0;';
      adWrapper.innerHTML = '<ins class="adsbygoogle" style="display:block;text-align:center" data-ad-layout="in-article" data-ad-format="fluid" data-ad-client="ca-pub-5938862195544185" data-ad-slot="3350911709"></ins>';
      visibleCards[pos].insertAdjacentElement('afterend', adWrapper);
      try { (window.adsbygoogle = window.adsbygoogle || []).push({}); } catch(e) {}
      adCount++;
    });
  }

  // 카테고리 필터
  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const cat = btn.getAttribute('data-category');
      if (!cat) return;
      activeCategory = cat;

      // 버튼 스타일
      buttons.forEach(b => {
        b.classList.remove('bg-blue-600', 'text-white', 'border-blue-600');
        b.classList.add('bg-white', 'dark:bg-gray-800', 'text-gray-700', 'dark:text-gray-300', 'border-gray-200', 'dark:border-gray-700');
      });
      btn.classList.add('bg-blue-600', 'text-white', 'border-blue-600');
      btn.classList.remove('bg-white', 'dark:bg-gray-800', 'text-gray-700', 'dark:text-gray-300', 'border-gray-200', 'dark:border-gray-700');

      // 해당 카테고리의 shownCount 초기화 (없으면 PAGE_SIZE)
      if (!(cat in shownCount)) {
        shownCount[cat] = PAGE_SIZE;
      }

      applyVisibility();
    });
  });

  // 더 보기 버튼
  if (loadMoreBtn) {
    loadMoreBtn.addEventListener('click', () => {
      const current = shownCount[activeCategory] ?? PAGE_SIZE;
      shownCount[activeCategory] = current + PAGE_SIZE;
      applyVisibility();
    });
  }

  // 초기 로드
  document.addEventListener('DOMContentLoaded', function() {
    // 모든 카테고리의 shownCount 초기화
    buttons.forEach(btn => {
      const cat = btn.getAttribute('data-category');
      if (cat) shownCount[cat] = PAGE_SIZE;
    });
    activeCategory = 'all';
    applyVisibility();
  });

  // === 검색/필터 기능 ===
(function() {
  const searchInput = document.getElementById('tool-search');
  const filterFree = document.getElementById('filter-free');
  const filterKorean = document.getElementById('filter-korean');
  const sortOrder = document.getElementById('sort-order');
  const cards = document.querySelectorAll('.tool-card');
  const countEl = document.getElementById('tool-count');
  const loadMoreContainer = document.getElementById('load-more-container');

  function filterAndSortCards() {
    const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
    const freeOnly = filterFree ? filterFree.checked : false;
    const koreanOnly = filterKorean ? filterKorean.checked : false;
    const sort = sortOrder ? sortOrder.value : 'order';

    // 필터링
    let visible = Array.from(cards).filter(card => {
      const cat = window.activeCategory === 'all' || card.getAttribute('data-cat') === window.activeCategory;
      const name = (card.getAttribute('data-name') || '').toLowerCase();
      const tags = (card.getAttribute('data-tags') || '').toLowerCase();
      const desc = (card.getAttribute('data-desc') || '').toLowerCase();
      const matchSearch = !query || name.includes(query) || tags.includes(query) || desc.includes(query);
      const matchFree = !freeOnly || (card.getAttribute('data-price') || '').includes('무료');
      const matchKorean = !koreanOnly || card.getAttribute('data-korean') === 'true';
      return cat && matchSearch && matchFree && matchKorean;
    });

    // 정렬
    visible.sort((a, b) => {
      if (sort === 'name') return (a.getAttribute('data-name') || '').localeCompare(b.getAttribute('data-name') || '');
      if (sort === 'updated') return (b.getAttribute('data-updated') || '').localeCompare(a.getAttribute('data-updated') || '');
      if (sort === 'review') return (parseInt(b.getAttribute('data-review')) || 0) - (parseInt(a.getAttribute('data-review')) || 0);
      return (parseInt(a.getAttribute('data-order')) || 99) - (parseInt(b.getAttribute('data-order')) || 99);
    });

    // DOM 재배열
    const grid = document.getElementById('tools-grid');
    if (!grid) return;
    visible.forEach(card => grid.appendChild(card));
    cards.forEach(card => {
      if (!visible.includes(card)) card.style.display = 'none';
      else card.style.display = '';
    });

    // 개수 업데이트
    if (countEl) countEl.textContent = String(visible.length);
    if (loadMoreContainer) {
      loadMoreContainer.style.display = visible.length > 24 ? '' : 'none';
    }
  }

  // 이벤트 연결
  if (searchInput) searchInput.addEventListener('input', filterAndSortCards);
  if (filterFree) filterFree.addEventListener('change', filterAndSortCards);
  if (filterKorean) filterKorean.addEventListener('change', filterAndSortCards);
  if (sortOrder) sortOrder.addEventListener('change', filterAndSortCards);

  // 기존 applyVisibility 함수를 확장
  const origApply = window.applyVisibility;
  if (typeof origApply === 'function') {
    const wrapped = function() { origApply(); filterAndSortCards(); };
    window.applyVisibility = wrapped;
  }

  // 카테고리 버튼 클릭 시에도 필터 재적용
  document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      setTimeout(filterAndSortCards, 50);
    });
  });
})();
</script>

<script>
document.getElementById('brevo-subscribe')?.addEventListener('submit', async (e) => {
  e.preventDefault();
  const email = document.getElementById('subscribe-email').value.trim();
  const btn = e.target.querySelector('button');
  const msg = document.getElementById('subscribe-message');

  btn.disabled = true;
  btn.textContent = '처리 중...';
  msg.classList.add('hidden');

  try {
    const res = await fetch('/api/subscribe', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email })
    });
    const data = await res.json();

    if (res.ok) {
      msg.className = 'mt-3 text-sm text-green-600 dark:text-green-400';
      msg.textContent = '✅ 구독 완료! 매일 아침 AI 브리핑을 보내드립니다.';
      e.target.querySelector('input').value = '';
    } else {
      msg.className = 'mt-3 text-sm text-red-600 dark:text-red-400';
      msg.textContent = data.error || '오류가 발생했습니다. 다시 시도해주세요.';
    }
  } catch (err) {
    msg.className = 'mt-3 text-sm text-red-600 dark:text-red-400';
    msg.textContent = '네트워크 오류입니다. 다시 시도해주세요.';
  } finally {
    btn.disabled = false;
    btn.textContent = '무료 구독하기';
    msg.classList.remove('hidden');
  }
});
</script>
