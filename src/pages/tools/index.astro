---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allTools = (await getCollection('tools'))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const newTools = [...allTools]
  .filter(t => t.data.updated)
  .sort((a, b) => (b.data.updated || '').localeCompare(a.data.updated || ''))
  .slice(0, 6);

const popularTools = [...allTools]
  .filter(t => t.data.koreanSupport)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .slice(0, 8);

const categories = [
  { id: 'all', label: '전체', emoji: '🔥' },
  { id: '글쓰기·챗봇', label: '글쓰기·챗봇', emoji: '✍️' },
  { id: '이미지 생성', label: '이미지 생성', emoji: '🎨' },
  { id: '영상·음성', label: '영상·음성', emoji: '🎬' },
  { id: '업무·생산성', label: '업무·생산성', emoji: '📊' },
  { id: '코딩·개발', label: '코딩·개발', emoji: '💻' },
  { id: '디자인', label: '디자인', emoji: '🖼️' },
  { id: '번역·학습', label: '번역·학습', emoji: '🌐' },
];

const catAccent: Record<string, string> = {
  '글쓰기·챗봇': 'from-violet-500 to-purple-600',
  '이미지 생성': 'from-pink-500 to-rose-600',
  '영상·음성': 'from-orange-500 to-red-500',
  '업무·생산성': 'from-emerald-500 to-teal-600',
  '코딩·개발': 'from-cyan-500 to-blue-600',
  '디자인': 'from-fuchsia-500 to-pink-600',
  '번역·학습': 'from-amber-500 to-yellow-600',
};
const defaultAccent = 'from-gray-500 to-gray-600';

const difficultyColor = (d: string) => {
  if (d.includes('초보')) return 'bg-emerald-100 text-emerald-700 border-emerald-200 dark:bg-emerald-500/15 dark:text-emerald-400 dark:border-emerald-500/30';
  if (d.includes('중급')) return 'bg-amber-100 text-amber-700 border-amber-200 dark:bg-amber-500/15 dark:text-amber-400 dark:border-amber-500/30';
  return 'bg-rose-100 text-rose-700 border-rose-200 dark:bg-rose-500/15 dark:text-rose-400 dark:border-rose-500/30';
};

const difficultyLabel = (d: string) => {
  if (d.includes('초보')) return '초보자 OK';
  if (d.includes('중급')) return '중급';
  return '고급';
};

import { TASK_COUNT } from '../../config/tasks';
---

<Layout title="AI 도구 디렉토리" description="일반인도 바로 쓸 수 있는 AI 도구를 카테고리별로 추천합니다. 무료·유료, 한국어 지원 여부, 난이도까지 한눈에 비교하세요.">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-8 sm:py-12">

    <!-- ========== 히어로 섹션 (항상 다크) ========== -->
    <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-[#0B1120] via-[#0F172A] to-[#1E1B4B] border border-white/[0.06] p-6 sm:p-10 mb-10">
      <div class="absolute top-[-40%] left-[-10%] w-[500px] h-[500px] bg-blue-600/20 rounded-full blur-[140px]"></div>
      <div class="absolute bottom-[-30%] right-[-5%] w-[400px] h-[400px] bg-purple-600/15 rounded-full blur-[120px]"></div>
      <div class="relative z-10">
        <div class="flex items-center gap-2 mb-3">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-blue-500/15 border border-blue-500/25 rounded-full text-blue-300 text-xs font-medium">
            <span class="w-1.5 h-1.5 bg-blue-400 rounded-full animate-pulse"></span>
            AI 도구 디렉토리
          </span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white mb-3 leading-tight tracking-tight">
          한국에서 <span class="bg-gradient-to-r from-blue-400 via-cyan-300 to-purple-400 bg-clip-text text-transparent">제대로 쓰는</span> AI
        </h1>
        <p class="text-blue-50/80 max-w-2xl mb-8 text-base sm:text-lg leading-relaxed">
          ChatGPT부터 Cursor까지, 한국어 지원 여부와 실전 사용 팁을 한눈에 비교하세요.
        </p>
        <div class="flex flex-wrap gap-2.5 mb-6">
          <div class="flex items-center gap-2 px-4 py-2.5 bg-white/[0.06] backdrop-blur-sm rounded-xl border border-white/[0.08]">
            <span class="text-2xl font-bold text-white">{allTools.length}<span class="text-blue-300 text-lg">+</span></span>
            <span class="text-xs text-blue-100/70 leading-tight font-medium">개 AI 도구</span>
          </div>
          <div class="flex items-center gap-2 px-4 py-2.5 bg-white/[0.06] backdrop-blur-sm rounded-xl border border-white/[0.08]">
            <span class="text-2xl font-bold text-emerald-400">{allTools.filter(t => t.data.koreanSupport).length}</span>
            <span class="text-xs text-blue-100/70 leading-tight font-medium">한국어 지원</span>
          </div>
          <div class="flex items-center gap-2 px-4 py-2.5 bg-white/[0.06] backdrop-blur-sm rounded-xl border border-white/[0.08]">
            <span class="text-2xl font-bold text-amber-400">{TASK_COUNT}</span>
            <span class="text-xs text-blue-100/70 leading-tight font-medium">태스크</span>
          </div>
        </div>
        <a href="/tools/submit/"
           class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white text-sm font-medium rounded-xl transition-all shadow-lg shadow-blue-500/20 hover:shadow-blue-500/30">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          도구 제출하기
        </a>
      </div>
    </div>

    <!-- ========== 퀵 태스크 칩 ========== -->
    <div class="flex flex-wrap gap-2 mb-8">
      <a href="/tools/task/" class="px-4 py-2 bg-blue-50 hover:bg-blue-100 text-blue-700 rounded-full text-sm border border-blue-200 transition-all dark:bg-blue-500/10 dark:hover:bg-blue-500/20 dark:text-blue-300 dark:border-blue-500/20">
        🔥 전체 태스크
      </a>
      {[
        { slug: '글쓰기', emoji: '✍️' },
        { slug: '이미지-생성', emoji: '🎨' },
        { slug: '코딩', emoji: '💻' },
        { slug: '영상-제작', emoji: '🎬' },
        { slug: '번역', emoji: '🌐' },
        { slug: '업무-자동화', emoji: '🤖' },
      ].map(t => (
        <a href={`/tools/task/${t.slug}/`}
           class="px-4 py-2 bg-gray-50 hover:bg-gray-100 text-gray-700 rounded-full text-sm border border-gray-200 transition-all dark:bg-white/[0.04] dark:hover:bg-white/[0.08] dark:text-gray-300 dark:hover:text-white dark:border-white/[0.08] dark:hover:border-white/[0.15]">
          {t.emoji} {t.slug.replace(/-/g, ' ')}
        </a>
      ))}
    </div>

    <!-- ========== 🆕 최근 등록 ========== -->
    {newTools.length > 0 && (
    <section class="mb-12">
      <div class="flex items-center justify-between mb-5">
        <div class="flex items-center gap-3">
          <h2 class="text-xl font-bold text-gray-900 dark:text-white">최신 등록</h2>
          <span class="px-2 py-0.5 bg-emerald-100 text-emerald-700 text-[11px] font-semibold rounded-full border border-emerald-200 dark:bg-emerald-500/15 dark:text-emerald-400 dark:border-emerald-500/25">NEW</span>
        </div>
        <span class="text-xs text-gray-500">매일 업데이트</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {newTools.map(tool => {
          const accent = catAccent[tool.data.category] || defaultAccent;
          return (
            <a href={`/tools/${tool.id}/`}
               class="group relative flex flex-col bg-white rounded-2xl border border-gray-200 overflow-hidden hover:border-blue-300 transition-all duration-300 hover:shadow-xl hover:shadow-blue-500/5 hover:-translate-y-0.5 dark:bg-[#111827]/80 dark:border-white/[0.06] dark:hover:border-white/[0.15]">
              <div class={`h-1 w-full bg-gradient-to-r ${accent}`}></div>
              <div class="p-5 flex-1 flex flex-col">
                <div class="flex items-start justify-between mb-2">
                  <div class="flex items-center gap-2 min-w-0">
                    <h3 class="text-base font-bold text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors truncate">
                      {tool.data.name}
                    </h3>
                    {tool.data.koreanSupport && (
                      <span class="flex-shrink-0 text-[10px] px-1.5 py-0.5 bg-blue-100 text-blue-700 rounded border border-blue-200 font-medium dark:bg-blue-500/15 dark:text-blue-400 dark:border-blue-500/20">KR</span>
                    )}
                  </div>
                  <span class="flex-shrink-0 text-[10px] px-2 py-0.5 bg-emerald-100 text-emerald-700 rounded-full border border-emerald-200 font-semibold ml-2 dark:bg-emerald-500/15 dark:text-emerald-400 dark:border-emerald-500/20">
                    NEW
                  </span>
                </div>
                <p class="text-sm text-gray-600 dark:text-gray-400 line-clamp-2 mb-3 flex-1">{tool.data.description}</p>
                <div class="flex items-center justify-between pt-3 border-t border-gray-100 dark:border-white/[0.05]">
                  <span class="text-xs text-gray-500 dark:text-gray-500">{tool.data.category}</span>
                  <span class="text-xs font-medium text-gray-600 dark:text-gray-400">{tool.data.price || '—'}</span>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </section>
    )}

    <!-- ========== 🔥 인기 도구 ========== -->
    {popularTools.length > 0 && (
    <section class="mb-12">
      <div class="flex items-center gap-3 mb-5">
        <h2 class="text-xl font-bold text-gray-900 dark:text-white">인기 도구</h2>
        <span class="px-2 py-0.5 bg-amber-100 text-amber-700 text-[11px] font-semibold rounded-full border border-amber-200 dark:bg-amber-500/15 dark:text-amber-400 dark:border-amber-500/25">HOT</span>
      </div>
      <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden dark:bg-[#111827]/60 dark:border-white/[0.06]">
        <div class="hidden sm:grid grid-cols-[auto_1fr_auto_auto_auto] gap-4 px-5 py-3 border-b border-gray-100 text-[11px] text-gray-500 font-medium uppercase tracking-wider dark:border-white/[0.06]">
          <span class="w-8">#</span>
          <span>도구</span>
          <span class="w-24 text-center">카테고리</span>
          <span class="w-20 text-center">가격</span>
          <span class="w-16 text-center">상태</span>
        </div>
        {popularTools.map((tool, i) => (
          <a href={`/tools/${tool.id}/`}
             class="group grid grid-cols-[auto_1fr] sm:grid-cols-[auto_1fr_auto_auto_auto] gap-4 items-center px-5 py-3.5 border-b border-gray-100 last:border-0 hover:bg-gray-50 transition-colors dark:border-white/[0.04] dark:hover:bg-white/[0.03]">
            <span class:list={[
              "w-8 h-8 flex items-center justify-center rounded-lg text-sm font-bold",
              i < 3 ? "bg-amber-100 text-amber-700 border border-amber-200 dark:bg-gradient-to-br dark:from-amber-500/20 dark:to-orange-500/20 dark:text-amber-400 dark:border-amber-500/20" : "bg-gray-100 text-gray-500 dark:bg-white/[0.04] dark:text-gray-500"
            ]}>
              {i + 1}
            </span>
            <div class="min-w-0">
              <div class="flex items-center gap-2">
                <span class="font-semibold text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors truncate text-sm">
                  {tool.data.name}
                </span>
                {tool.data.koreanSupport && (
                  <span class="flex-shrink-0 text-[10px] px-1.5 py-0.5 bg-blue-100 text-blue-700 rounded border border-blue-200 font-medium dark:bg-blue-500/15 dark:text-blue-400 dark:border-blue-500/20">KR</span>
                )}
              </div>
              <p class="text-xs text-gray-500 truncate mt-0.5">{tool.data.description}</p>
            </div>
            <span class="hidden sm:block w-24 text-center text-xs text-gray-500">{tool.data.category}</span>
            <span class="hidden sm:block w-20 text-center text-xs font-medium text-gray-600 dark:text-gray-400">{tool.data.price || '—'}</span>
            <span class:list={[
              "hidden sm:flex w-16 justify-center text-[10px] px-2 py-0.5 rounded-full border font-medium",
              difficultyColor(tool.data.difficulty)
            ]}>
              {difficultyLabel(tool.data.difficulty)}
            </span>
          </a>
        ))}
      </div>
    </section>
    )}

    <!-- ========== 구분선 ========== -->
    <div class="flex items-center gap-4 mb-8">
      <div class="flex-1 h-px bg-gray-200 dark:bg-gradient-to-r dark:from-transparent dark:via-white/[0.08] dark:to-transparent"></div>
      <span class="text-xs text-gray-500 font-medium tracking-wider uppercase">전체 도구</span>
      <div class="flex-1 h-px bg-gray-200 dark:bg-gradient-to-r dark:from-transparent dark:via-white/[0.08] dark:to-transparent"></div>
    </div>

    <!-- ========== 카테고리 필터 ========== -->
    <div class="flex flex-wrap justify-center gap-2 mb-6" id="category-filter">
      {categories.map(cat => (
        <button
          data-category={cat.id}
          class:list={[
            'filter-btn px-4 py-2 rounded-xl text-sm font-medium transition-all border',
            cat.id === 'all'
              ? 'bg-blue-600 text-white border-blue-500 shadow-lg shadow-blue-500/20'
              : 'bg-gray-100 text-gray-600 border-gray-200 hover:bg-gray-200 hover:text-gray-900 dark:bg-white/[0.04] dark:text-gray-400 dark:border-white/[0.08] dark:hover:bg-white/[0.08] dark:hover:text-white dark:hover:border-white/[0.15]'
          ]}
        >
          {cat.emoji} {cat.label}
        </button>
      ))}
    </div>

    <!-- ========== 검색 + 필터 ========== -->
    <div class="max-w-2xl mx-auto mb-4">
      <div class="relative">
        <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <input type="text" id="tool-search" placeholder="도구 이름, 태그로 검색..."
          class="w-full pl-12 pr-4 py-3.5 rounded-xl bg-white border border-gray-200 text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-blue-500/40 focus:border-blue-500/40 outline-none transition text-sm dark:bg-[#111827]/80 dark:border-white/[0.08] dark:text-white dark:placeholder-gray-500" />
      </div>
    </div>

    <div class="flex flex-wrap justify-center gap-3 mb-8" id="advanced-filters">
      <label class="flex items-center gap-2 px-4 py-2 rounded-xl border border-gray-200 bg-gray-50 cursor-pointer hover:bg-gray-100 transition text-sm text-gray-600 dark:border-white/[0.08] dark:bg-white/[0.03] dark:text-gray-400 dark:hover:bg-white/[0.06] dark:hover:border-white/[0.15]">
        <input type="checkbox" id="filter-free" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500/40 dark:border-gray-600 dark:text-blue-500 dark:bg-gray-700" />
        <span>💰 무료만</span>
      </label>
      <label class="flex items-center gap-2 px-4 py-2 rounded-xl border border-gray-200 bg-gray-50 cursor-pointer hover:bg-gray-100 transition text-sm text-gray-600 dark:border-white/[0.08] dark:bg-white/[0.03] dark:text-gray-400 dark:hover:bg-white/[0.06] dark:hover:border-white/[0.15]">
        <input type="checkbox" id="filter-korean" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500/40 dark:border-gray-600 dark:text-blue-500 dark:bg-gray-700" />
        <span>🇰🇷 한국어 지원</span>
      </label>
      <select id="sort-order" class="px-4 py-2 rounded-xl border border-gray-200 bg-gray-50 text-sm text-gray-600 outline-none cursor-pointer dark:border-white/[0.08] dark:bg-white/[0.03] dark:text-gray-400">
        <option value="order">추천순</option>
        <option value="name">이름순</option>
        <option value="updated">최신순</option>
        <option value="review">⭐ 리뷰 순</option>
      </select>
    </div>

    <!-- ========== 도구 카드 그리드 ========== -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4" id="tools-grid">
      {allTools.map((tool, i) => {
        const accent = catAccent[tool.data.category] || defaultAccent;
        const firstUc = tool.data.useCases?.slice(0, 2) || [];
        return (
        <a
          href={`/tools/${tool.id}/`}
          data-cat={tool.data.category}
          data-index={i}
          data-name={tool.data.name}
          data-tags={tool.data.tags.join(' ')}
          data-desc={tool.data.description}
          data-price={tool.data.price}
          data-korean={tool.data.koreanSupport}
          data-difficulty={tool.data.difficulty}
          data-order={tool.data.order}
          data-updated={tool.data.updated || ''}
          data-review={0}
          class="tool-card group relative flex flex-col bg-white rounded-2xl border border-gray-200 overflow-hidden hover:border-blue-300 transition-all duration-300 hover:shadow-xl hover:shadow-blue-500/5 hover:-translate-y-0.5 dark:bg-[#111827]/60 dark:border-white/[0.06] dark:hover:border-white/[0.12]"
        >
          <div class={`h-0.5 w-full bg-gradient-to-r ${accent}`}></div>
          <div class="p-4 sm:p-5 flex-1 flex flex-col">
            <div class="flex items-start justify-between mb-2">
              <h3 class="text-sm sm:text-base font-bold text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors leading-snug pr-2">
                {tool.data.name}
              </h3>
              <div class="flex gap-1 flex-shrink-0">
                {tool.data.koreanSupport && (
                  <span class="text-[10px] px-1.5 py-0.5 bg-blue-100 text-blue-700 rounded border border-blue-200 font-medium dark:bg-blue-500/15 dark:text-blue-400 dark:border-blue-500/20" title="한국어 지원">
                    KR
                  </span>
                )}
              </div>
            </div>
            <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 line-clamp-2 mb-3 flex-1 leading-relaxed">
              {tool.data.description}
            </p>
            <div class="flex items-center justify-between gap-2 pt-3 border-t border-gray-100 dark:border-white/[0.05]">
              <div class="flex items-center gap-1.5 min-w-0">
                <span class:list={[
                  "text-[10px] px-2 py-0.5 rounded-full border font-medium",
                  difficultyColor(tool.data.difficulty)
                ]}>
                  {difficultyLabel(tool.data.difficulty)}
                </span>
                {firstUc.length > 0 && (
                  <span class="text-[10px] text-gray-500 truncate">{firstUc[0]}</span>
                )}
              </div>
              <span class="text-[11px] font-medium text-gray-600 dark:text-gray-500 flex-shrink-0">{tool.data.price || '—'}</span>
            </div>
          </div>
        </a>
        );
      })}
    </div>

    <!-- ========== 더 보기 ========== -->
    <div class="text-center mt-8" id="load-more-container">
      <button
        id="load-more-btn"
        class="inline-flex items-center gap-2 px-8 py-3 bg-gray-100 border border-gray-200 text-gray-700 font-medium rounded-xl hover:bg-gray-200 hover:text-gray-900 transition-all dark:bg-white/[0.04] dark:border-white/[0.1] dark:text-gray-300 dark:hover:bg-white/[0.08] dark:hover:text-white dark:hover:border-white/[0.2]"
      >
        더 보기 (<span id="load-more-count">24</span>개)
      </button>
    </div>

    <div class="text-center mt-4 text-sm text-gray-500">
      총 <strong id="tool-count" class="text-gray-700 dark:text-gray-400">{allTools.length}</strong>개 도구
    </div>

    <!-- ========== 뉴스레터 CTA (항상 다크) ========== -->
    <div class="mt-16 relative overflow-hidden rounded-2xl bg-gradient-to-br from-[#0F172A] to-[#1E1B4B] border border-white/[0.06] p-8 sm:p-10">
      <div class="absolute top-[-20%] right-[-5%] w-[300px] h-[300px] bg-purple-600/15 rounded-full blur-[100px]"></div>
      <div class="relative z-10 text-center max-w-xl mx-auto">
        <div class="text-3xl mb-3">📬</div>
        <h3 class="text-xl font-bold text-white mb-2">매일 아침 AI 뉴스를 받아보세요</h3>
        <p class="text-gray-300 text-sm mb-6">
          국내외 AI 소식을 큐레이션해서 이메일로 보내드립니다. 무료입니다.
        </p>
        <form id="brevo-subscribe" class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
          <input
            type="email"
            id="subscribe-email"
            placeholder="이메일 주소를 입력하세요"
            required
            class="flex-1 px-4 py-3 rounded-xl bg-white/[0.06] border border-white/[0.1] text-white placeholder-gray-500 focus:ring-2 focus:ring-blue-500/40 focus:border-blue-500/40 outline-none text-sm"
          />
          <button
            type="submit"
            class="px-6 py-3 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-medium rounded-xl transition-all text-sm whitespace-nowrap shadow-lg shadow-blue-500/20"
          >
            무료 구독
          </button>
        </form>
        <p id="subscribe-message" class="mt-3 text-sm hidden"></p>
        <p class="text-xs text-gray-500 mt-3">언제든 구독 해지 가능</p>
      </div>
    </div>

  </div>

  <style is:global>
    .tool-card { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
    .tool-card:hover { box-shadow: 0 8px 30px -8px rgba(59, 130, 246, 0.15), 0 0 0 1px rgba(255,255,255,0.05); }
    .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .filter-btn.active { background: linear-gradient(135deg, #2563eb, #4f46e5); color: white; border-color: #3b82f6; box-shadow: 0 4px 15px -3px rgba(59, 130, 246, 0.3); }
  </style>
</Layout>

<script>
  const PAGE_SIZE = 24;
  const buttons = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.tool-card');
  const countEl = document.getElementById('tool-count');
  const loadMoreBtn = document.getElementById('load-more-btn');
  const loadMoreCount = document.getElementById('load-more-count');
  const loadMoreContainer = document.getElementById('load-more-container');

  let activeCategory = 'all';
  const shownCount: Record<string, number> = {};

  function getVisibleCards() {
    return Array.from(cards).filter(c => {
      const cat = c.getAttribute('data-cat');
      return activeCategory === 'all' || cat === activeCategory;
    });
  }

  function applyVisibility() {
    const visible = getVisibleCards();
    const currentShown = shownCount[activeCategory] ?? PAGE_SIZE;
    visible.forEach((card, i) => {
      (card as HTMLElement).style.display = i < currentShown ? '' : 'none';
    });
    cards.forEach(c => {
      const cat = c.getAttribute('data-cat');
      if (activeCategory !== 'all' && cat !== activeCategory) {
        (c as HTMLElement).style.display = 'none';
      }
    });
    if (countEl) countEl.textContent = String(visible.length);
    const remaining = visible.length - currentShown;
    if (loadMoreContainer && loadMoreCount) {
      if (remaining > 0) {
        loadMoreContainer.style.display = '';
        loadMoreCount.textContent = String(Math.min(remaining, PAGE_SIZE));
      } else {
        loadMoreContainer.style.display = 'none';
      }
    }
  }

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const cat = btn.getAttribute('data-category');
      if (!cat) return;
      activeCategory = cat;
      buttons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      if (!(cat in shownCount)) shownCount[cat] = PAGE_SIZE;
      applyVisibility();
    });
  });

  if (loadMoreBtn) {
    loadMoreBtn.addEventListener('click', () => {
      shownCount[activeCategory] = (shownCount[activeCategory] ?? PAGE_SIZE) + PAGE_SIZE;
      applyVisibility();
    });
  }

  document.addEventListener('DOMContentLoaded', function() {
    buttons.forEach(btn => {
      const cat = btn.getAttribute('data-category');
      if (cat) shownCount[cat] = PAGE_SIZE;
    });
    activeCategory = 'all';
    applyVisibility();
  });

  (function() {
    const searchInput = document.getElementById('tool-search');
    const filterFree = document.getElementById('filter-free');
    const filterKorean = document.getElementById('filter-korean');
    const sortOrder = document.getElementById('sort-order');

    function filterAndSortCards() {
      const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
      const freeOnly = filterFree ? (filterFree as HTMLInputElement).checked : false;
      const koreanOnly = filterKorean ? (filterKorean as HTMLInputElement).checked : false;
      const sort = sortOrder ? (sortOrder as HTMLSelectElement).value : 'order';

      let visible = Array.from(cards).filter(card => {
        const cat = (window as any).activeCategory === 'all' || card.getAttribute('data-cat') === (window as any).activeCategory;
        const name = (card.getAttribute('data-name') || '').toLowerCase();
        const tags = (card.getAttribute('data-tags') || '').toLowerCase();
        const desc = (card.getAttribute('data-desc') || '').toLowerCase();
        const matchSearch = !query || name.includes(query) || tags.includes(query) || desc.includes(query);
        const matchFree = !freeOnly || (card.getAttribute('data-price') || '').includes('무료');
        const matchKorean = !koreanOnly || card.getAttribute('data-korean') === 'true';
        return cat && matchSearch && matchFree && matchKorean;
      });

      visible.sort((a, b) => {
        if (sort === 'name') return (a.getAttribute('data-name') || '').localeCompare(b.getAttribute('data-name') || '');
        if (sort === 'updated') return (b.getAttribute('data-updated') || '').localeCompare(a.getAttribute('data-updated') || '');
        if (sort === 'review') return (parseInt(b.getAttribute('data-review') || '0') || 0) - (parseInt(a.getAttribute('data-review') || '0') || 0);
        return (parseInt(a.getAttribute('data-order') || '99') || 99) - (parseInt(b.getAttribute('data-order') || '99') || 99);
      });

      const grid = document.getElementById('tools-grid');
      if (!grid) return;
      visible.forEach(card => grid.appendChild(card));
      cards.forEach(card => {
        (card as HTMLElement).style.display = visible.includes(card) ? '' : 'none';
      });
      if (countEl) countEl.textContent = String(visible.length);
      if (loadMoreContainer) loadMoreContainer.style.display = visible.length > 24 ? '' : 'none';
    }

    if (searchInput) searchInput.addEventListener('input', filterAndSortCards);
    if (filterFree) filterFree.addEventListener('change', filterAndSortCards);
    if (filterKorean) filterKorean.addEventListener('change', filterAndSortCards);
    if (sortOrder) sortOrder.addEventListener('change', filterAndSortCards);
    document.querySelectorAll('.filter-btn').forEach(btn => {
      btn.addEventListener('click', () => setTimeout(filterAndSortCards, 50));
    });
  })();
</script>

<script>
document.getElementById('brevo-subscribe')?.addEventListener('submit', async (e) => {
  e.preventDefault();
  const email = (document.getElementById('subscribe-email') as HTMLInputElement).value.trim();
  const btn = (e.target as HTMLFormElement).querySelector('button');
  const msg = document.getElementById('subscribe-message');
  if (btn) { btn.disabled = true; btn.textContent = '처리 중...'; }
  if (msg) msg.classList.add('hidden');
  try {
    const res = await fetch('/api/subscribe', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email })
    });
    const data = await res.json();
    if (res.ok) {
      if (msg) { msg.className = 'mt-3 text-sm text-emerald-600 dark:text-emerald-400'; msg.textContent = '구독 완료!'; }
      (e.target as HTMLFormElement).querySelector('input').value = '';
    } else {
      if (msg) { msg.className = 'mt-3 text-sm text-rose-600 dark:text-rose-400'; msg.textContent = data.error || '오류'; }
    }
  } catch {
    if (msg) { msg.className = 'mt-3 text-sm text-rose-600 dark:text-rose-400'; msg.textContent = '네트워크 오류'; }
  } finally {
    if (btn) { btn.disabled = false; btn.textContent = '무료 구독'; }
    if (msg) msg.classList.remove('hidden');
  }
});
</script>
