---
export const prerender = false;
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// AIK24-TOOLSORT-01 (2026-10-18 대표님 결정): order 동점일 때는 컬렉션 기본 순서(파일명
//   알파벳순)가 그대로 유지돼, 제출 승인 건이 상단 고정 대역(order=-1, 14장) 중간에 박혔다
//   (실측: SpriteFrame 11번째 / AITraining.jobs 3번째). updated 최신순을 2차 키로 넣어
//   신규가 대역 맨 앞으로 온다. updated 까지 같은 건은 여전히 파일명 순(안정 정렬)이라
//   새로고침마다 순서가 흔들리지 않는다.
const mdTools: any[] = (await getCollection('tools'))
  .sort((a, b) =>
    (a.data.order ?? 99) - (b.data.order ?? 99)
    || String(b.data.updated ?? '').localeCompare(String(a.data.updated ?? '')));

// D1 사용자 등록 도구 합성 (42-02: published-only, price_detail || price_model, fail-soft 200)
let d1Rows: any[] = [];
try {
  const db = env.DB;
  if (db) {
    const res = await db.prepare(
      'SELECT slug, name, url, category, description, price_model, price_detail, screenshot_url, korean_support, difficulty, use_cases, tags, tasks, detail_markdown, created_at FROM tool_submissions WHERE status=\'published\' ORDER BY created_at DESC'
    ).all();
    d1Rows = res?.results ?? [];
  }
} catch (e) {
  console.error('[tools/index] tool_submissions 조회 실패 (fail-soft):', e);
  d1Rows = [];
}

const parseJsonArray = (v: any): string[] => {
  try {
    const a = typeof v === 'string' ? JSON.parse(v) : v;
    return Array.isArray(a) ? a.map((x) => String(x)) : [];
  } catch {
    return [];
  }
};

const d1Tools: any[] = d1Rows.map((r) => ({
  id: String(r.slug),
  isD1: true,
  data: {
    name: String(r.name ?? ''),
    description: String(r.description ?? ''),
    category: String(r.category ?? '기타'),
    price: (r.price_detail && String(r.price_detail).trim()) || r.price_model || '—',
    koreanSupport: Number(r.korean_support) === 1,
    difficulty: (r.difficulty && String(r.difficulty).trim()) || '중급',
    tags: parseJsonArray(r.tags),
    useCases: r.use_cases ? String(r.use_cases).split(',').map((s: string) => s.trim()).filter(Boolean) : [],
    order: -1,
    updated: String(r.created_at ?? '').slice(0, 10),
    screenshotUrl: (r.screenshot_url && String(r.screenshot_url).trim()) || null,
  },
}));

// D1 최신순 상단 + md 기존 순서
// 2026-10-13 중복 정리: D1 published 건과 md 슬러그가 같으면 목록에 카드가 2장 뜬다.
// 상세 페이지([id].astro)는 md 엔트리가 존재하면 md 를 렌더하므로, 카드도 md 만 남겨 카드↔상세를 일치시킨다.
// (md 짝이 없는 신규 제작자 제출 건은 D1 카드가 그대로 MAKER 배지로 노출된다.)
const mdSlugs = new Set(mdTools.map((t) => t.id));
const d1Only = d1Tools.filter((t) => !mdSlugs.has(t.id));
// md 카드가 D1 행을 통째로 대체하므로 screenshot_url 이 함께 사라졌다.
// 그 결과 등록된 스크린샷이 목록에서 영영 안 보였다(2026-10-13).
// md 우선 원칙은 그대로 두고, md 에 image 가 없는 슬러그에만 D1 스크린샷을 물려준다.
const d1Shot = new Map(d1Tools.map((t) => [t.id, t.data.screenshotUrl]));
const mdWithShot: any[] = mdTools.map((t) => {
  const shot = d1Shot.get(t.id);
  return shot && !t.data.image
    ? { ...t, data: { ...t.data, screenshotUrl: shot } }
    : t;
});
const allTools: any[] = [...d1Only, ...mdWithShot];

// AIK24-TOOLSYNC-06 (2026-10-18 대표님 결정) — '최신 등록'·'인기 도구' 섹션 폐지.
//   · 최신 등록: md `updated` 상위 6칸 회전 창. 수집기가 매일 06:00 에 2~11개를 자동 등록해
//     이틀이면 밀려나고, D1 전용(제출 승인) 툴은 updated=created_at 이라 승인해도 상단에 못 올라온다.
//   · 인기 도구: 투표·조회 데이터가 아니라 koreanSupport + order 정렬이라 인기도가 아니었다.
//   · 두 섹션 모두 아래 전체 도구 그리드(필터·검색·정렬 보유)의 부분집합이라 중복이었다.
// 신규 노출은 그리드 카드의 '최근 7일 NEW' 배지가 맡는다.
const KST_OFFSET_MS = 9 * 60 * 60 * 1000;
const DAY_MS = 24 * 60 * 60 * 1000;
const todayKst = new Date(Date.now() + KST_OFFSET_MS).toISOString().slice(0, 10);
const newCutoffKst = new Date(Date.now() + KST_OFFSET_MS - 7 * DAY_MS).toISOString().slice(0, 10);
const isNewTool = (t: any): boolean => {
  const u = String(t?.data?.updated ?? '').slice(0, 10);
  return u !== '' && u >= newCutoffKst && u <= todayKst;
};

const categories = [
  { id: 'all', label: '전체', emoji: '🔥' },
  { id: '글쓰기·챗봇', label: '글쓰기·챗봇', emoji: '✍️' },
  { id: '이미지 생성', label: '이미지 생성', emoji: '🎨' },
  { id: '영상·음성', label: '영상·음성', emoji: '🎬' },
  { id: '업무·생산성', label: '업무·생산성', emoji: '📊' },
  { id: '코딩·개발', label: '코딩·개발', emoji: '💻' },
  { id: '디자인', label: '디자인', emoji: '🖼️' },
  { id: '번역·학습', label: '번역·학습', emoji: '🌐' },
];

const catAccent: Record<string, string> = {
  '글쓰기·챗봇': '',
  '이미지 생성': '',
  '영상·음성': ' to-red-500',
  '업무·생산성': '',
  '코딩·개발': '',
  '디자인': '',
  '번역·학습': '',
};
const defaultAccent = 'from-gray-500 to-gray-600';

const difficultyColor = (d: string) => {
  if (d.includes('초보')) return 'bg-gray-100 text-[#111111] border-[#e5e5e5] dark:bg-[#333333]/15 dark:text-[#555555] dark:border-[#e5e5e5]/30';
  if (d.includes('중급')) return 'bg-gray-100 text-[#111111] border-[#e5e5e5] dark:bg-[#333333]/15 dark:text-[#555555] dark:border-[#e5e5e5]/30';
  return 'bg-gray-100 text-[#111111] border-[#e5e5e5] dark:bg-[#333333]/15 dark:text-[#555555] dark:border-[#e5e5e5]/30';
};

const difficultyLabel = (d: string) => {
  if (d.includes('초보')) return '초보자 OK';
  if (d.includes('중급')) return '중급';
  return '고급';
};

import { TASK_COUNT } from '../../config/tasks';
---

<Layout title="AI 도구 디렉토리" description="일반인도 바로 쓸 수 있는 AI 도구를 카테고리별로 추천합니다. 무료·유료, 한국어 지원 여부, 난이도까지 한눈에 비교하세요.">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-8 sm:py-12">

    <!-- ========== 히어로 섹션 (AIK24-RENEWAL-02: 다크 → 흰 배경 + 빨간 버티컜) ========== -->
    <div class="relative overflow-hidden rounded-2xl bg-white border border-gray-200 p-6 sm:p-10 mb-10">
      <div class="relative z-10">
        <div class="flex items-center gap-2 mb-3">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-gray-50 border border-gray-200 rounded-full text-[#555555] text-xs font-medium">
            <span class="w-1.5 h-1.5 bg-[#E63B2E] rounded-full animate-pulse"></span>
            AI 도구 디렉토리
          </span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#111111] mb-3 leading-tight tracking-tight" style="border-left: 6px solid #E63B2E; padding-left: 24px;">
          한국에서 <span class="text-[#E63B2E]">제대로 쓰는</span> AI
        </h1>
        <p class="text-[#555555] max-w-2xl mb-8 text-base sm:text-lg leading-relaxed">
          ChatGPT부터 Cursor까지, 한국어 지원 여부와 실전 사용 팁을 한눈에 비교하세요.
        </p>
        <div class="flex flex-wrap gap-2.5 mb-6">
          <div class="flex items-center gap-2 px-4 py-2.5 bg-gray-50 rounded-xl border border-gray-200">
            <span class="text-2xl font-bold text-[#111111]">{allTools.length}<span class="text-gray-500 text-lg">+</span></span>
            <span class="text-xs text-[#555555] leading-tight font-medium">개 AI 도구</span>
          </div>
          <div class="flex items-center gap-2 px-4 py-2.5 bg-gray-50 rounded-xl border border-gray-200">
            <span class="text-2xl font-bold text-[#111111]">{allTools.filter(t => t.data.koreanSupport).length}</span>
            <span class="text-xs text-[#555555] leading-tight font-medium">한국어 지원</span>
          </div>
          <div class="flex items-center gap-2 px-4 py-2.5 bg-gray-50 rounded-xl border border-gray-200">
            <span class="text-2xl font-bold text-[#111111]">{TASK_COUNT}</span>
            <span class="text-xs text-[#555555] leading-tight font-medium">태스크</span>
          </div>
        </div>
        <a href="/tools/submit/" class="inline-flex items-center gap-2 px-5 py-2.5 bg-[#111111] hover:bg-[#333333] text-white text-sm font-medium rounded-xl transition-all">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          도구 제출하기
        </a>
      </div>
    </div>

    <!-- ========== 퀵 태스크 칩 ========== -->
    <div class="flex flex-wrap gap-2 mb-8">
      <a href="/tools/task/" class="px-4 py-2 bg-gray-100 hover:bg-gray-100 text-[#111111] rounded-full text-sm border border-[#e5e5e5] transition-all dark:bg-[#333333]/10 dark:hover:bg-[#333333]/20 dark:text-gray-500 dark:border-[#e5e5e5]/20">
        🔥 전체 태스크
      </a>
      {[
        { slug: '글쓰기', emoji: '✍️' },
        { slug: '이미지-생성', emoji: '🎨' },
        { slug: '코딩', emoji: '💻' },
        { slug: '영상-제작', emoji: '🎬' },
        { slug: '번역', emoji: '🌐' },
        { slug: '업무-자동화', emoji: '🤖' },
      ].map(t => (
        <a href={`/tools/task/${t.slug}/`} class="px-4 py-2 bg-gray-50 hover:bg-gray-100 text-gray-700 rounded-full text-sm border border-gray-200 transition-all   dark:text-gray-300 dark:hover:text-white  dark:hover:border-[#e5e5e5]">
          {t.emoji} {t.slug.replace(/-/g, ' ')}
        </a>
      ))}
    </div>

    <!-- ========== 등록 정책 ========== -->
    <section id="policy" class="mb-8 scroll-mt-24">
      <div class="border border-gray-200 rounded-2xl p-8 bg-white">
        <div class="flex items-start gap-4">
          <div class="w-1 self-stretch bg-red-600 rounded-full flex-shrink-0"></div>
          <div>
            <h2 class="text-xl font-bold text-gray-900 mb-2">AI 툴 등록 정책</h2>
            <p class="text-sm text-gray-600 mb-6">AI코리아24 도구 디렉토리는 정확하고 정직한 AI 도구 정보를 전합니다. 무료·유료 무관하게 등록할 수 있습니다.</p>
            <h3 class="font-bold text-gray-900 mb-2">등록 가능한 도구</h3>
            <ul class="text-sm text-gray-700 space-y-1.5 mb-6 list-disc pl-5">
              <li>AI 기능을 핵심으로 포함하는 공식 서비스 또는 검증된 오픈소스</li>
              <li>무료·유료 무관 (요금제는 명시합니다)</li>
              <li>한국어 지원 시 우선 검토</li>
            </ul>
            <h3 class="font-bold text-gray-900 mb-2">등록되지 않는 도구</h3>
            <ul class="text-sm text-gray-700 space-y-1.5 mb-6 list-disc pl-5">
              <li>모델명을 도메인·서비스명으로 쓰는 서드파티 래퍼 (원본 개발사의 공식 서비스가 아닌 경우)</li>
              <li>공식 서비스를 사칭하거나 오인하게 만드는 사이트</li>
              <li>AI와 무관한 서비스, 피싱·사기 목적의 사이트</li>
            </ul>
            <p class="text-xs text-gray-500">모든 제출은 관리자 검토 후 공개됩니다 (보통 24시간 이내).</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ========== 구분선 ========== -->
    <div class="flex items-center gap-4 mb-8">
      <div class="flex-1 h-px bg-gray-200 bg-[#111111] dark:from-transparent dark:via-white/[0.08] dark:to-transparent"></div>
      <span class="text-xs text-gray-500 font-medium tracking-wider uppercase">전체 도구</span>
      <div class="flex-1 h-px bg-gray-200 bg-[#111111] dark:from-transparent dark:via-white/[0.08] dark:to-transparent"></div>
    </div>

    <!-- ========== 카테고리 필터 ========== -->
    <div class="flex flex-wrap justify-center gap-2 mb-6" id="category-filter">
      {categories.map(cat => (
        <button
          data-category={cat.id}
          class:list={[
            'filter-btn px-4 py-2 rounded-xl text-sm font-medium transition-all border',
            cat.id === 'all'
              ? 'bg-[#111111] text-white border-[#e5e5e5] shadow-lg shadow-[#e5e5e5]/20'
              : 'bg-gray-100 text-gray-600 border-gray-200 hover:bg-gray-200 hover:text-gray-900  dark:text-gray-400   dark:hover:text-white dark:hover:border-[#e5e5e5]'
          ]}
        >
          {cat.emoji} {cat.label}
        </button>
      ))}
    </div>

    <!-- ========== 검색 + 필터 ========== -->
    <div class="max-w-2xl mx-auto mb-4">
      <div class="relative">
        <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <input type="text" id="tool-search" placeholder="도구 이름, 태그로 검색..." class="w-full pl-12 pr-4 py-3.5 rounded-xl bg-white border border-gray-200 text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-[#111111]/40 focus:border-[#e5e5e5]/40 outline-none transition text-sm dark:bg-[#111827]/80  dark:text-white dark:placeholder-gray-500" />
      </div>
    </div>

    <div class="flex flex-wrap justify-center gap-3 mb-8" id="advanced-filters">
      <label class="flex items-center gap-2 px-4 py-2 rounded-xl border border-gray-200 bg-gray-50 cursor-pointer hover:bg-gray-100 transition text-sm text-gray-600   dark:text-gray-400  dark:hover:border-[#e5e5e5]">
        <input type="checkbox" id="filter-free" class="rounded border-gray-300 text-[#111111] focus:ring-[#111111]/40 dark:border-gray-600 dark:text-[#555555] dark:bg-gray-700" />
        <span>💰 무료만</span>
      </label>
      <label class="flex items-center gap-2 px-4 py-2 rounded-xl border border-gray-200 bg-gray-50 cursor-pointer hover:bg-gray-100 transition text-sm text-gray-600   dark:text-gray-400  dark:hover:border-[#e5e5e5]">
        <input type="checkbox" id="filter-korean" class="rounded border-gray-300 text-[#111111] focus:ring-[#111111]/40 dark:border-gray-600 dark:text-[#555555] dark:bg-gray-700" />
        <span>🇰🇷 한국어 지원</span>
      </label>
      <select id="sort-order" class="px-4 py-2 rounded-xl border border-gray-200 bg-gray-50 text-sm text-gray-600 outline-none cursor-pointer   dark:text-gray-400">
        <option value="order">추천순</option>
        <option value="name">이름순</option>
        <option value="updated">최신순</option>
      </select>
    </div>

    <!-- ========== 도구 카드 그리드 ========== -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4" id="tools-grid">
      {allTools.map((tool, i) => {
        const accent = catAccent[tool.data.category] || defaultAccent;
        const firstUc = tool.data.useCases?.slice(0, 2) || [];
        return (
        <a
          href={`/tools/${tool.id}/`}
          data-cat={tool.data.category}
          data-index={i}
          data-name={tool.data.name}
          data-tags={tool.data.tags.join(' ')}
          data-desc={tool.data.description}
          data-price={tool.data.price}
          data-korean={tool.data.koreanSupport}
          data-difficulty={tool.data.difficulty}
          data-order={tool.data.order}
          data-updated={tool.data.updated || ''}
          class="tool-card group relative flex flex-col bg-white rounded-2xl border border-gray-200 overflow-hidden hover:border-[#e5e5e5] transition-all duration-300 hover:shadow-xl hover:shadow-[#e5e5e5]/5 hover:-translate-y-0.5 dark:bg-[#111827]/60  dark:hover:border-[#e5e5e5]"
        >
          <div class={`h-0.5 w-full bg-[#111111] ${accent}`}></div>
          {(tool.data.image || tool.data.screenshotUrl) && (
            <div class="w-full aspect-[16/9] overflow-hidden bg-gray-100 dark:bg-[#111827]/40 border-b border-gray-100 dark:border-[#e5e5e5]/10">
              <img src={tool.data.image || tool.data.screenshotUrl} alt={`${tool.data.name} 미리보기`} loading="lazy" decoding="async" class="w-full h-full object-cover" />
            </div>
          )}
          <div class="p-4 sm:p-5 flex-1 flex flex-col">
            <div class="flex items-start justify-between mb-2">
              <h3 class="text-sm sm:text-base font-bold text-gray-900 dark:text-white group-hover:text-[#111111] dark:group-hover:text-[#555555] transition-colors leading-snug pr-2">
                {tool.data.name}
              </h3>
              <div class="flex gap-1 flex-shrink-0">
                {(tool as any).isD1 && (
                  <span class="text-xs font-bold px-2 py-0.5 bg-gray-100 text-[#111111] rounded-full border border-[#e5e5e5] dark:bg-[#333333]/15 dark:text-[#555555] dark:border-[#e5e5e5]/20">MAKER</span>
                )}
                {isNewTool(tool) && (
                  <span class="text-[10px] px-1.5 py-0.5 bg-[#E63B2E] text-white rounded font-bold" title="최근 7일 내 등록·갱신">NEW</span>
                )}
                {tool.data.koreanSupport && (
                  <span class="text-[10px] px-1.5 py-0.5 bg-gray-100 text-[#111111] rounded border border-[#e5e5e5] font-medium dark:bg-[#333333]/15 dark:text-[#555555] dark:border-[#e5e5e5]/20" title="한국어 지원">
                    KR
                  </span>
                )}
              </div>
            </div>
            <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 line-clamp-2 mb-3 flex-1 leading-relaxed">
              {tool.data.description}
            </p>
            <div class="flex items-center justify-between gap-2 pt-3 border-t border-gray-100 ">
              <div class="flex items-center gap-1.5 min-w-0">
                <span class:list={[
                  "text-[10px] px-2 py-0.5 rounded-full border font-medium",
                  difficultyColor(tool.data.difficulty)
                ]}>
                  {difficultyLabel(tool.data.difficulty)}
                </span>
                {firstUc.length > 0 && (
                  <span class="text-[10px] text-gray-500 truncate">{firstUc[0]}</span>
                )}
              </div>
              <span class="text-[11px] font-medium text-gray-600 dark:text-gray-500 flex-shrink-0">{tool.data.price || '—'}</span>
            </div>
          </div>
        </a>
        );
      })}
    </div>

    <!-- ========== 더 보기 ========== -->
    <div class="text-center mt-8" id="load-more-container">
      <button id="load-more-btn" class="inline-flex items-center gap-2 px-8 py-3 bg-gray-100 border border-gray-200 text-gray-700 font-medium rounded-xl hover:bg-gray-200 hover:text-gray-900 transition-all   dark:text-gray-300  dark:hover:text-white dark:hover:border-[#e5e5e5]"
      >
        더 보기 (<span id="load-more-count">24</span>개)
      </button>
    </div>

    <div class="text-center mt-4 text-sm text-gray-500">
      총 <strong id="tool-count" class="text-gray-700 dark:text-gray-400">{allTools.length}</strong>개 도구
    </div>

    <!-- ========== 뉴스레터 CTA (UI-01: 흰 배경 + 검은 텍스트 — 다크 텍스트를 흰 배경 위에 두면 안 보임) ========== -->
    <div class="mt-16 relative overflow-hidden rounded-2xl  border border-gray-200 p-8 sm:p-10">
      <div class="absolute top-[-20%] right-[-5%] w-[300px] h-[300px] bg-[#111111]/15 rounded-full blur-[100px]"></div>
      <div class="relative z-10 text-center max-w-xl mx-auto">
        <h3 class="text-xl font-bold text-gray-900 mb-2">매일 아침 AI 뉴스를 받아보세요</h3>
        <p class="text-gray-600 text-sm mb-6">
          국내외 AI 소식을 큐레이션해서 이메일로 보내드립니다. 무료입니다.
        </p>
        <form id="brevo-subscribe" class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
          <input type="email" id="subscribe-email" placeholder="이메일 주소를 입력하세요"
            required class="flex-1 px-4 py-3 rounded-xl bg-gray-50 border border-gray-200 text-gray-900 placeholder-gray-500 focus:ring-2 focus:ring-[#111111]/40 focus:border-[#e5e5e5]/40 outline-none text-sm"
          />
          <button type="submit" class="px-6 py-3 bg-[#111111] text-white font-medium rounded-xl transition-all text-sm whitespace-nowrap shadow-lg shadow-[#e5e5e5]/20"
          >
            무료 구독
          </button>
        </form>
        <p id="subscribe-message" class="mt-3 text-sm hidden"></p>
        <p class="text-xs text-gray-500 mt-3">언제든 구독 해지 가능</p>
      </div>
    </div>

  </div>

  <style is:global>
    .tool-card { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
    .tool-card:hover { box-shadow: 0 8px 30px -8px rgba(59, 130, 246, 0.15), 0 0 0 1px rgba(255,255,255,0.05); }
    .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .filter-btn.active { background: linear-gradient(135deg, #2563eb, #4f46e5); color: white; border-color: #3b82f6; box-shadow: 0 4px 15px -3px rgba(59, 130, 246, 0.3); }
  </style>
</Layout>

<script>
  // AIK24-TOOLSFILTER-01 (2026-10-19 대표님 보고): 카테고리 버튼을 누르면 목록이 0장이 되던 버그.
  //   원인: 이 블록의 뒷부분(검색·정렬)이 `window.activeCategory` 를 읽었는데, 그 값을 아무도
  //   설정하지 않아 항상 undefined 였다 → 버튼 클릭 → 모든 카드가 조건 탈락 →
  //   413장 전부 display:none + '총 0개 도구'.
  //   실측(수정 전 라이브): 클릭 전 보이는 카드 24장 → '전체' 클릭 후 0장.
  //   구조: 필터·검색·정렬·페이지네이션을 이 블록 **하나**가 소유한다(상태 1개 = 화면 1개).
  //   이전에는 두 부분이 각자 카드를 숨겨서 검색·필터를 쓰면 페이지네이션이 풀렸다
  //   (전체 413장이 한꺼번에 나오고, '더 보기'를 누르면 오히려 48장으로 줄어드는 모순).
  (function () {
    const PAGE_SIZE = 24;
    const cards = Array.from(document.querySelectorAll('.tool-card')) as HTMLElement[];
    const grid = document.getElementById('tools-grid');
    const countEl = document.getElementById('tool-count');
    const loadMoreBtn = document.getElementById('load-more-btn');
    const loadMoreCount = document.getElementById('load-more-count');
    const loadMoreContainer = document.getElementById('load-more-container');
    const buttons = Array.from(document.querySelectorAll('.filter-btn')) as HTMLElement[];
    const searchInput = document.getElementById('tool-search') as HTMLInputElement | null;
    const filterFree = document.getElementById('filter-free') as HTMLInputElement | null;
    const filterKorean = document.getElementById('filter-korean') as HTMLInputElement | null;
    const sortOrder = document.getElementById('sort-order') as HTMLSelectElement | null;

    let activeCategory = 'all';
    let query = '';
    let freeOnly = false;
    let koreanOnly = false;
    let sort = 'order';
    let shown = PAGE_SIZE;

    const attr = (c: HTMLElement, k: string) => (c.getAttribute(k) || '').toLowerCase();

    function matchedCards(): HTMLElement[] {
      const q = query.toLowerCase().trim();
      return cards.filter((c) => {
        if (activeCategory !== 'all' && c.getAttribute('data-cat') !== activeCategory) return false;
        if (freeOnly && !(c.getAttribute('data-price') || '').includes('무료')) return false;
        if (koreanOnly && c.getAttribute('data-korean') !== 'true') return false;
        if (!q) return true;
        return attr(c, 'data-name').includes(q) || attr(c, 'data-tags').includes(q) || attr(c, 'data-desc').includes(q);
      });
    }

    function apply() {
      const visible = matchedCards();
      const inList = new Set(visible);
      // Array.prototype.sort 는 안정 정렬 — updated 까지 같은 카드는 서버 렌더 순서(파일명 순)가 유지된다.
      visible.sort((a, b) => {
        if (sort === 'name') return (a.getAttribute('data-name') || '').localeCompare(b.getAttribute('data-name') || '');
        if (sort === 'updated') return (b.getAttribute('data-updated') || '').localeCompare(a.getAttribute('data-updated') || '');
        const byOrder = (parseInt(a.getAttribute('data-order') || '99', 10) || 99) - (parseInt(b.getAttribute('data-order') || '99', 10) || 99);
        if (byOrder !== 0) return byOrder;
        // AIK24-TOOLSORT-01: 서버 렌더와 동일한 2차 키(updated 최신순) — '추천순'을 눌러도 같은 순서.
        return (b.getAttribute('data-updated') || '').localeCompare(a.getAttribute('data-updated') || '');
      });
      // DOM 순서를 '조건에 맞는 카드(정렬됨) → 나머지'로 정리한다.
      // 그래야 페이지네이션이 항상 목록 앞에서부터 잘리고, 카테고리를 바꿔도 순서가 꼬이지 않는다.
      if (grid) {
        visible.forEach((c) => grid.appendChild(c));
        cards.filter((c) => !inList.has(c)).forEach((c) => grid.appendChild(c));
      }
      visible.forEach((c, i) => { c.style.display = i < shown ? '' : 'none'; });
      cards.filter((c) => !inList.has(c)).forEach((c) => { c.style.display = 'none'; });
      if (countEl) countEl.textContent = String(visible.length);
      const remaining = visible.length - shown;
      if (loadMoreContainer && loadMoreCount) {
        loadMoreContainer.style.display = remaining > 0 ? '' : 'none';
        loadMoreCount.textContent = String(Math.min(Math.max(remaining, 0), PAGE_SIZE));
      }
    }

    // 카테고리를 바꾸면 그 카테고리의 처음 24장부터 보여준다(이전에 펼친 상태를 물려받지 않는다).
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-category');
        if (!cat) return;
        activeCategory = cat;
        shown = PAGE_SIZE;
        buttons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        apply();
      });
    });

    if (loadMoreBtn) {
      loadMoreBtn.addEventListener('click', () => {
        shown += PAGE_SIZE;
        apply();
      });
    }
    if (searchInput) searchInput.addEventListener('input', () => { query = searchInput.value; shown = PAGE_SIZE; apply(); });
    if (filterFree) filterFree.addEventListener('change', () => { freeOnly = filterFree.checked; shown = PAGE_SIZE; apply(); });
    if (filterKorean) filterKorean.addEventListener('change', () => { koreanOnly = filterKorean.checked; shown = PAGE_SIZE; apply(); });
    if (sortOrder) sortOrder.addEventListener('change', () => { sort = sortOrder.value; apply(); });

    // 초기 1회 적용 — SSR 은 413장을 모두 내려주므로 화면에는 24장만 보이게 맞춘다(수정 전과 동일).
    apply();
  })();
</script>

<script>
document.getElementById('brevo-subscribe')?.addEventListener('submit', async (e) => {
  e.preventDefault();
  const email = (document.getElementById('subscribe-email') as HTMLInputElement).value.trim();
  const btn = (e.target as HTMLFormElement).querySelector('button');
  const msg = document.getElementById('subscribe-message');
  if (btn) { btn.disabled = true; btn.textContent = '처리 중...'; }
  if (msg) msg.classList.add('hidden');
  try {
    const res = await fetch('/api/subscribe', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email })
    });
    const data = await res.json();
    if (res.ok) {
      if (msg) { msg.className = 'mt-3 text-sm text-[#111111] dark:text-[#555555]'; msg.textContent = '구독 완료!'; }
      (e.target as HTMLFormElement).querySelector('input').value = '';
    } else {
      if (msg) { msg.className = 'mt-3 text-sm text-[#111111] dark:text-[#555555]'; msg.textContent = data.error || '오류'; }
    }
  } catch {
    if (msg) { msg.className = 'mt-3 text-sm text-[#111111] dark:text-[#555555]'; msg.textContent = '네트워크 오류'; }
  } finally {
    if (btn) { btn.disabled = false; btn.textContent = '무료 구독'; }
    if (msg) msg.classList.remove('hidden');
  }
});
</script>
