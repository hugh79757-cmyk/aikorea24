---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allTools = await getCollection('tools');
const categories = [...new Set(allTools.map(t => t.data.category))];
---

<Layout title="AI 툴 등록하기 | AI코리아24" description="AI코리아24에 새로운 AI 툴을 등록하세요.">
  <div class="max-w-2xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-4">🛠️ AI 툴 등록하기</h1>
    <p class="text-gray-600 dark:text-gray-400 mb-8">아직 등록되지 않은 AI 툴을 추천해주세요. 검토 후 디렉토리에 추가됩니다.</p>
    <form action="/api/tools/submit" method="POST" class="space-y-6">
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">툴 이름 *</label>
        <input type="text" name="name" required class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 outline-none" placeholder="예: ChatGPT" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">공식 URL *</label>
        <input type="url" name="url" required class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 outline-none" placeholder="https://chat.openai.com" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">한 줄 설명 *</label>
        <textarea name="description" required rows="2" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 outline-none" placeholder="이 툴을 한 줄로 설명해주세요"></textarea>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">카테고리</label>
          <select name="category" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 outline-none">
            {categories.map(cat => <option value={cat}>{cat}</option>)}
            <option value="기타">기타</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">가격</label>
          <select name="price" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 outline-none">
            <option value="무료">무료</option>
            <option value="무료 / 유료">무료 / 유료</option>
            <option value="유료">유료</option>
          </select>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <input type="checkbox" name="koreanSupport" value="true" class="rounded text-blue-600" id="ks" />
        <label for="ks" class="text-sm">한국어 지원</label>
      </div>
      <button type="submit" class="w-full py-3 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl transition-colors">등록 제출하기</button>
      <p class="text-xs text-gray-400 text-center">제출 후 운영자가 검토하여 추가합니다 (1-2일 소요).</p>
    </form>
    <div class="mt-8 text-center">
      <a href="/tools/" class="text-blue-600 dark:text-blue-400 hover:underline text-sm">← 전체 도구 목록으로</a>
    </div>
  </div>
</Layout>
