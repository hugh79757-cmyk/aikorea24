---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { TASKS as ALL_TASKS } from '../../config/tasks';

const TASK_BASE = '/tools/task/';

export async function getStaticPaths() {
  const tools = await getCollection('tools');
  return tools.map(tool => ({
    params: { id: tool.id },
    props: { tool },
  }));
}

const { tool } = Astro.props;
const { Content } = await render(tool);

const difficultyColor = (d: string) => {
  if (d.includes('초보')) return 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200';
  if (d.includes('중급')) return 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200';
  return 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200';
};

const taskLinks = (tool.data.tasks ?? []).filter((s: string) => ALL_TASKS[s]).map((s: string) => ({
  slug: s,
  title: ALL_TASKS[s].title,
}));
---

<Layout
  title={`${tool.data.name} 사용법과 가격, 한국어 지원 여부 총정리 | AI코리아24`}
  description={`${tool.data.description} 가격과 한국어 지원 여부, 난이도를 한눈에 비교하고 추천 대상을 확인하세요.`}
  type="article"
>
  <div class="max-w-3xl mx-auto px-4 py-12">
    <nav class="text-sm text-gray-500 dark:text-gray-400 mb-6">
      <a href="/" class="hover:text-blue-600">홈</a>
      <span class="mx-1">/</span>
      <a href="/tools/" class="hover:text-blue-600">AI 도구</a>
      <span class="mx-1">/</span>
      <span class="text-gray-900 dark:text-white">{tool.data.name}</span>
    </nav>

    <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 p-8 mb-8">
      <div class="flex items-start justify-between mb-4">
        <h1 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">
          {tool.data.name} 사용법과 가격, 추천 이유
        </h1>
        {tool.data.featured && (
          <span class="text-sm bg-blue-100 text-blue-700 dark:bg-blue-900 dark:text-blue-300 px-3 py-1 rounded-full whitespace-nowrap">⭐ 추천</span>
        )}
      </div>
      <p class="text-gray-600 dark:text-gray-400 mb-6">{tool.data.description}</p>
      <div class="flex flex-wrap gap-3 mb-6">
        <span class="text-sm bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 px-3 py-1.5 rounded-lg" title="카테고리">📂 {tool.data.category}</span>
        <span class="text-sm bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 px-3 py-1.5 rounded-lg" title="가격">💰 {tool.data.price}</span>
        <span class="text-sm bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 px-3 py-1.5 rounded-lg" title="한국어 지원">🇰🇷 한국어 {tool.data.koreanSupport ? '지원' : '미지원'}</span>
        <span class:list={['text-sm px-3 py-1.5 rounded-lg', difficultyColor(tool.data.difficulty)]} title="난이도">📊 {tool.data.difficulty}</span>
      </div>
      {tool.data.useCases && tool.data.useCases.length > 0 && (
        <div class="mb-6">
          <h3 class="text-sm font-semibold text-gray-500 dark:text-gray-400 mb-2">활용 사례</h3>
          <div class="flex flex-wrap gap-2">
            {tool.data.useCases.map((uc: string) => (
              <span class="text-xs bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 px-2.5 py-1 rounded-full">{uc}</span>
            ))}
          </div>
        </div>
      )}
      <a href={tool.data.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-medium px-6 py-3 rounded-xl transition-colors">
        🔗 {tool.data.name} 바로가기
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
      </a>
    </div>

    <article class="prose prose-lg dark:prose-invert max-w-none mb-8">
      <Content />
    </article>

    {taskLinks.length > 0 && (
      <div class="bg-gray-50 dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700 rounded-xl p-6 mb-8">
        <h3 class="text-sm font-semibold text-gray-500 dark:text-gray-400 mb-3">🔗 이 툴이 사용되는 태스크</h3>
        <div class="flex flex-wrap gap-2">
          {taskLinks.map((tl: { slug: string; title: string }) => (
            <a href={TASK_BASE + tl.slug + '/'} class="text-sm bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 hover:bg-blue-100 dark:hover:bg-blue-900/50 px-3 py-1.5 rounded-full transition-colors">
              {tl.title} →
            </a>
          ))}
        </div>
      </div>
    )}

    {tool.data.relatedPost && (
      <div class="bg-gray-50 dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700 rounded-xl p-6 mb-8">
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-2">📖 관련 블로그 글</p>
        <a href={tool.data.relatedPost} class="text-blue-600 dark:text-blue-400 hover:underline font-medium">자세한 사용법 보러 가기 →</a>
      </div>
    )}

    <div class="flex justify-between items-center pt-6 border-t border-gray-200 dark:border-gray-700">
      <div>
        {tool.data.updated && (
          <p class="text-xs text-gray-400 dark:text-gray-500">최종 업데이트: {tool.data.updated}</p>
        )}
      </div>
      <a href="/tools/" class="text-blue-600 dark:text-blue-400 hover:underline font-medium">← 전체 도구 목록</a>
    </div>
  </div>
</Layout>
