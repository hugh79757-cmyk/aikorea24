---
export const prerender = true;
import Layout from '../../../layouts/Layout.astro';
import { TASKS, TASK_SLUGS } from '../../../config/tasks';
import { getCollection } from 'astro:content';

const allTools = await getCollection('tools');

// 각 태스크별 툴 개수 계산
const taskCounts: Record<string, number> = {};
for (const slug of TASK_SLUGS) {
  taskCounts[slug] = allTools.filter(t => (t.data.tasks ?? []).includes(slug)).length;
}

// 카테고리별 그룹핑
const CATEGORIES: Record<string, string[]> = {
  "문서·텍스트": ["pdf-요약", "유튜브-요약", "글쓰기", "이메일-작성", "번역", "요약", "맞춤법-교정", "보고서-작성", "이력서", "카피라이팅"],
  "문서·텍스트 (심화)": ["문서-번역", "자기소개서", "기획서", "회의록", "프레젠테이션"],
  "이미지·디자인": ["이미지-생성-무료", "이미지-생성", "배경-제거", "썸네일-제작", "로고-디자인", "ppt-발표", "인포그래픽"],
  "이미지·디자인 (심화)": ["아이콘-디자인", "일러스트", "UI-디자인", "웹디자인"],
  "영상·음성": ["영상-제작", "영상-편집", "자막-생성", "음성-변환", "더빙", "음악-생성", "텍스트-음성"],
  "영상·음성 (심화)": ["음성-녹음", "팟캐스트", "배경음악"],
  "업무·생산성": ["회의-요약", "일정-관리", "데이터-분석", "엑셀-자동화", "업무-자동화", "챗봇-구축"],
  "업무·생산성 (심화)": ["메모-정리", "프로젝트-관리", "자동화-워크플로우", "CRM"],
  "코딩·개발": ["코딩", "코드-리뷰", "노코드"],
  "코딩·개발 (심화)": ["바이브코딩", "API-개발", "디버깅", "테스트"],
  "학습·리서치": ["논문-요약", "영어-학습", "리서치"],
  "학습·리서치 (심화)": ["자격증-학습", "면접-준비", "제2외국어"],
  "마케팅·SNS": ["sns-콘텐츠", "seo-최적화", "광고-카피", "블로그-작성"],
  "마케팅·SNS (심화)": ["유튜브-편집", "마케팅-자동화", "콘텐츠-기획", "브랜드-네이밍"],
  "전문 분야": ["의료-상담", "법률-검토", "부동산-분석", "투자-분석", "회계-경리", "고객-상담"],
};
---

<Layout
  title="AI 도구 태스크별 추천 — 할 일별 AI 툴 한눈에 비교 | AI코리아24"
  description="PDF 요약, 이미지 생성, 영상 제작, 번역 등 태스크별로 최적의 AI 도구를 비교해보세요. 무료/유료, 한국어 지원 여부까지 확인 가능합니다."
>
  <div class="max-w-4xl mx-auto px-4 py-12">
    <nav class="text-sm text-gray-500 dark:text-gray-400 mb-6">
      <a href="/" class="hover:text-blue-600">홈</a>
      <span class="mx-1">/</span>
      <a href="/tools/" class="hover:text-blue-600">AI 도구</a>
      <span class="mx-1">/</span>
      <span class="text-gray-900 dark:text-white">태스크별 추천</span>
    </nav>

    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
      태스크별 AI 도구 추천
    </h1>
    <p class="text-gray-600 dark:text-gray-400 mb-10 text-lg">
      하고 싶은 일을 선택하세요. 각 태스크에 최적화된 AI 도구를 무료/유료, 한국어 지원 여부와 함께 비교해드립니다.
    </p>

    {Object.entries(CATEGORIES).map(([catName, slugs]) => {
      const validSlugs = slugs.filter(s => TASKS[s]);
      if (validSlugs.length === 0) return null;
      return (
        <section class="mb-12">
          <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4 pb-2 border-b border-gray-200 dark:border-gray-700">
            {catName}
          </h2>
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {validSlugs.map(slug => {
              const task = TASKS[slug];
              const count = taskCounts[slug] ?? 0;
              return (
                <a
                  href={`/tools/task/${slug}/`}
                  class="block bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 hover:border-blue-400 dark:hover:border-blue-500 transition-colors"
                >
                  <h3 class="font-semibold text-gray-900 dark:text-white mb-1">
                    {task.title}
                  </h3>
                  <p class="text-sm text-gray-500 dark:text-gray-400">
                    {count > 0 ? `관련 툴 ${count}개` : '준비 중'}
                  </p>
                </a>
              );
            })}
          </div>
        </section>
      );
    })}
  </div>
</Layout>