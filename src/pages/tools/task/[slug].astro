---
export const prerender = true;
import Layout from '../../../layouts/Layout.astro';
import { TASKS, TASK_SLUGS } from '../../../config/tasks';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return TASK_SLUGS.map(slug => ({
    params: { slug },
    props: { slug },
  }));
}

const { slug } = Astro.props;
const taskInfo = TASKS[slug];
if (!taskInfo) {
  return Astro.redirect('/tools/task/');
}

const allTools = await getCollection('tools');
const taskTools = allTools
  .filter(t => (t.data.tasks ?? []).includes(slug))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

// 최소 5개 미만이면 리다이렉트
if (taskTools.length < 5) {
  return Astro.redirect('/tools/task/');
}

const year = new Date().getFullYear();
const pageTitle = `${taskInfo.title} ${taskTools.length}가지 — 무료·유료 완벽 비교 (${year}년) | AI코리아24`;
const pageDesc = `${taskInfo.kw} 찾고 계신가요? 무료부터 유료까지, 한국어 지원 여부까지 한눈에 비교했습니다.`;

// 관련 태스크 (같은 카테고리의 다른 태스크)
const relatedTasks = TASK_SLUGS
  .filter(s => s !== slug)
  .slice(0, 5);
---

<Layout
  title={pageTitle}
  description={pageDesc}
>
  <div class="max-w-4xl mx-auto px-4 py-12">
    <nav class="text-sm text-gray-500 dark:text-gray-400 mb-6">
      <a href="/" class="hover:text-blue-600">홈</a>
      <span class="mx-1">/</span>
      <a href="/tools/" class="hover:text-blue-600">AI 도구</a>
      <span class="mx-1">/</span>
      <a href="/tools/task/" class="hover:text-blue-600">태스크별 추천</a>
      <span class="mx-1">/</span>
      <span class="text-gray-900 dark:text-white">{taskInfo.title}</span>
    </nav>

    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
      {taskInfo.title} {taskTools.length}가지 — 무료·유료 완벽 비교 ({year}년 최신)
    </h1>

    <section class="bg-blue-50 dark:bg-blue-900/20 border border-blue-100 dark:border-blue-800 rounded-xl p-5 mb-10">
      <p class="text-gray-700 dark:text-gray-300 leading-relaxed">
        <strong>{taskInfo.kw}</strong>을 찾고 계신가요? 이 글에서는 <strong>{taskTools.length}가지</strong> 추천 AI 도구를 가격, 한국어 지원, 난이도별로 비교해드립니다. 무료 도구부터 전문가용 유료 도구까지, 예산과 니즈에 맞는 최적의 도구를 찾아보세요.
      </p>
    </section>

    <!-- 한눈에 비교표 -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">한눈에 비교표</h2>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse bg-white dark:bg-gray-800 rounded-xl overflow-hidden">
          <thead>
            <tr class="bg-gray-100 dark:bg-gray-700">
              <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700 dark:text-gray-300">순위</th>
              <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700 dark:text-gray-300">툴명</th>
              <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700 dark:text-gray-300">가격</th>
              <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700 dark:text-gray-300">한국어</th>
              <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700 dark:text-gray-300">난이도</th>
            </tr>
          </thead>
          <tbody>
            {taskTools.map((tool, i) => (
              <tr class="border-t border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-750">
                <td class="px-4 py-3 text-sm text-gray-500 dark:text-gray-400">{i + 1}</td>
                <td class="px-4 py-3">
                  <a href={`/tools/${tool.id}/`} class="text-blue-600 dark:text-blue-400 hover:underline font-medium">
                    {tool.data.name}
                  </a>
                </td>
                <td class="px-4 py-3 text-sm text-gray-700 dark:text-gray-300">{tool.data.price}</td>
                <td class="px-4 py-3 text-sm">{tool.data.koreanSupport ? '✅ 지원' : '❌ 미지원'}</td>
                <td class="px-4 py-3 text-sm text-gray-700 dark:text-gray-300">{tool.data.difficulty}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- 추천 툴 상세 -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">추천 툴 상세</h2>
      {taskTools.map((tool, i) => (
        <div class="mb-10 pb-8 border-b border-gray-200 dark:border-gray-700 last:border-0">
          <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3" id={`tool-${tool.id}`}>
            {i + 1}위. <a href={`/tools/${tool.id}/`} class="text-blue-600 dark:text-blue-400 hover:underline">{tool.data.name}</a>
            {tool.data.featured && <span class="text-sm ml-2 text-yellow-500">⭐</span>}
          </h3>
          <p class="text-gray-600 dark:text-gray-400 mb-4">{tool.data.description}</p>
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="bg-gray-50 dark:bg-gray-800/50 rounded-lg p-4">
              <p class="text-xs text-gray-400 dark:text-gray-500 mb-1">💰 가격</p>
              <p class="text-sm text-gray-700 dark:text-gray-300">{tool.data.price}</p>
            </div>
            <div class="bg-gray-50 dark:bg-gray-800/50 rounded-lg p-4">
              <p class="text-xs text-gray-400 dark:text-gray-500 mb-1">🇰🇷 한국어</p>
              <p class="text-sm text-gray-700 dark:text-gray-300">{tool.data.koreanSupport ? '지원 (한국어 UI/문서 있음)' : '미지원 (영어 사용 필요)'}</p>
            </div>
          </div>
          {tool.data.useCases && tool.data.useCases.length > 0 && (
            <div class="mt-3 flex flex-wrap gap-1.5">
              {tool.data.useCases.slice(0, 4).map((uc: string) => (
                <span class="text-xs bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 px-2 py-1 rounded-full">{uc}</span>
              ))}
            </div>
          )}
          <div class="mt-3">
            <a href={`/tools/${tool.id}/`} class="text-sm text-blue-600 dark:text-blue-400 hover:underline font-medium">
              자세히 보기 →
            </a>
          </div>
        </div>
      ))}
    </section>

    <!-- 어떤 툴을 선택할까? -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">어떤 툴을 선택할까?</h2>
      <div class="space-y-6">
        <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-6">
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">무료로만 쓰고 싶다면</h3>
          <p class="text-gray-600 dark:text-gray-400">
            위 목록에서 <strong>무료</strong> 또는 <strong>무료/월 N만원</strong>으로 표시된 도구부터 시작하세요.
            대부분의 AI 도구는 무료 플랜에서도 핵심 기능을 사용할 수 있습니다.
            사용량이 많아지면 그때 유료 전환을 고려해도 늦지 않습니다.
          </p>
        </div>
        <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-6">
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">한국어가 반드시 필요하다면</h3>
          <p class="text-gray-600 dark:text-gray-400">
            비교표에서 <strong>✅ 지원</strong>으로 표시된 도구를 선택하세요. 한국어 UI를 제공하는 도구는
            초보자도 부담 없이 시작할 수 있고, 한국어 고객 지원이 가능한 경우가 많습니다.
          </p>
        </div>
        <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-6">
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">처음 써보는 초보자라면</h3>
          <p class="text-gray-600 dark:text-gray-400">
            <strong>초보자 OK</strong> 난이도의 도구를 고르세요. 회원가입만 하면 바로 사용할 수 있고,
            튜토리얼이나 가이드가 잘 갖춰져 있습니다. 무료 플랜으로 부담 없이 시작해보세요.
          </p>
        </div>
      </div>
    </section>

    <!-- 자주 묻는 질문 -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">자주 묻는 질문</h2>
      <div class="space-y-4">
        <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-5">
          <h3 class="font-semibold text-gray-900 dark:text-white mb-2">Q. {taskInfo.kw}는 무료로 사용할 수 있나요?</h3>
          <p class="text-gray-600 dark:text-gray-400">
            네, 위 목록에서 '무료' 또는 '무료/월 N만원'으로 표시된 도구는 무료 플랜이 있습니다.
            다만 무료 플랜은 사용 횟수나 기능에 제한이 있을 수 있으니, 비교표를 참고해 선택하세요.
          </p>
        </div>
        <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-5">
          <h3 class="font-semibold text-gray-900 dark:text-white mb-2">Q. 한국어를 지원하는 {taskInfo.kw} 도구는?</h3>
          <p class="text-gray-600 dark:text-gray-400">
            비교표에서 '✅ 지원'으로 표시된 도구가 한국어를 공식 지원합니다. 한국어 UI, 문서,
            고객 지원이 제공되므로 언어 장벽 없이 사용할 수 있습니다. ChatGPT, Claude 등이 대표적입니다.
          </p>
        </div>
        <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-5">
          <h3 class="font-semibold text-gray-900 dark:text-white mb-2">Q. 일반인도 {taskInfo.kw}를 쓸 수 있나요?</h3>
          <p class="text-gray-600 dark:text-gray-400">
            네, 대부분의 AI 도구는 일반인도 쉽게 사용할 수 있도록 설계되었습니다.
            '초보자 OK' 난이도의 도구는 특별한 기술 지식 없이도 바로 시작할 수 있습니다.
          </p>
        </div>
        <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-5">
          <h3 class="font-semibold text-gray-900 dark:text-white mb-2">Q. 이 중 가장 좋은 도구는 무엇인가요?</h3>
          <p class="text-gray-600 dark:text-gray-400">
            '가장 좋은' 도구는 사용 목적과 예산에 따라 다릅니다. 무료로 시작하려면 1~3위 도구를,
            전문적인 작업이 필요하다면 유료 도구를 고려해보세요. 각 도구의 상세 페이지에서 더 자세한 정보를 확인할 수 있습니다.
          </p>
        </div>
      </div>
    </section>

    <!-- 관련 태스크 -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">관련 태스크</h2>
      <div class="flex flex-wrap gap-3">
        {relatedTasks.map(s => {
          const t = TASKS[s];
          if (!t) return null;
          return (
            <a href={`/tools/task/${s}/`} class="text-sm bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 hover:bg-blue-50 dark:hover:bg-blue-900/30 hover:text-blue-700 dark:hover:text-blue-300 px-4 py-2 rounded-full transition-colors">
              {t.title} →
            </a>
          );
        })}
      </div>
    </section>

    <div class="text-center pt-6 border-t border-gray-200 dark:border-gray-700">
      <p class="text-xs text-gray-400 dark:text-gray-500 mb-2">
        최종 업데이트: {new Date().toISOString().slice(0, 10)}
      </p>
      <a href="/tools/task/" class="text-blue-600 dark:text-blue-400 hover:underline font-medium">
        ← 모든 태스크 보기
      </a>
    </div>
  </div>
</Layout>