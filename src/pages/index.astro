---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/home/HeroSection.astro';
import BriefingSection from '../components/home/BriefingSection.astro';
import CourseSection from '../components/home/CourseSection.astro';
import LatestBlog from '../components/home/LatestBlog.astro';
import CtaSection from '../components/home/CtaSection.astro';
import SubProjects from '../components/home/SubProjects.astro';
import OpenSourceBanner from '../components/home/OpenSourceBanner.astro';
import SubscribeBanner from '../components/home/SubscribeBanner.astro';
import ContentHub from '../components/home/ContentHub.astro';

// --- 블로그 데이터는 클라이언트 사이드에서 로딩 ---
const recentPosts: any[] = [];
const coursePosts: any[] = [];

// --- 브리핑 데이터 ---
let briefing: any = null;
let briefingItems: any[] = [];

try {
  const runtime = (Astro.locals as any).runtime;
  const db = runtime?.env?.DB;
  if (db) {
    briefing = await db.prepare(
      "SELECT * FROM briefings WHERE status = 'published' ORDER BY id DESC LIMIT 1"
    ).first();

    if (briefing) {
      const { results } = await db.prepare(
        `SELECT bi.sort_order, bi.comment,
                n.id as news_id, n.title, n.link, n.description, n.source, n.category, n.country, n.pub_date
         FROM briefing_items bi
         JOIN news n ON bi.news_id = n.id
         WHERE bi.briefing_id = ?
         ORDER BY bi.sort_order`
      ).bind(briefing.id).all();
      briefingItems = results || [];
    }
  }
} catch (e) {
  console.error('Briefing fetch error:', e);
}
---
<Layout title="AI코리아24" description="매일 아침 직접 선별한 AI 뉴스 브리핑과 실전 강좌. AI, 누구나 쓸 수 있습니다.">
  <div class="bg-white dark:bg-[#0A0E1A] text-gray-900 dark:text-white min-h-screen relative overflow-hidden transition-colors">

    <!-- 앰비언트 글로우 배경 -->
    <div class="fixed inset-0 pointer-events-none z-0">
      <div class="absolute top-[-20%] left-[-10%] w-[600px] h-[600px] bg-blue-600/20 rounded-full blur-[150px] animate-pulse-slow"></div>
      <div class="absolute top-[30%] right-[-10%] w-[500px] h-[500px] bg-purple-600/15 rounded-full blur-[150px] animate-pulse-slow2"></div>
      <div class="absolute bottom-[-10%] left-[30%] w-[400px] h-[400px] bg-cyan-500/10 rounded-full blur-[120px] animate-pulse-slow3"></div>
    </div>

    <HeroSection />
    <BriefingSection briefing={briefing} items={briefingItems} />
    <SubscribeBanner />
    <LatestBlog posts={recentPosts} />
    <CourseSection posts={coursePosts} />
    <OpenSourceBanner />
    <SubProjects />
    <CtaSection />

  </div>

  <script is:inline src="https://cdn.jsdelivr.net/npm/particles.js@2.0.0/particles.min.js"></script>
  <script is:inline>
    // 블로그 데이터 클라이언트 사이드 로딩
    async function loadBlogData() {
      try {
        const res = await fetch('/api/home-content');
        const data = await res.json();
        
        // RecentBlog 컴포넌트 렌더링
        const blogContainer = document.getElementById('latest-blog-posts');
        if (blogContainer && data.recentPosts?.length > 0) {
          blogContainer.innerHTML = data.recentPosts.map(post => {
            const rawDate = post.data.date?.substring(0, 10) || '';
            const [y, m, d] = rawDate.split('-').map(Number);
            const dateFormatted = y ? `${y}년 ${m}월 ${d}일` : '';
            const categoryEmoji = {'AI 도구': '🛠️', 'AI 강좌': '📚', 'AI 뉴스': '📰', 'AI 지원사업': '💰', 'AI 체험': '🧪', '재테크': '💎'}[post.data.category] || '✍️';
            return `
              <a href="/blog/${post.slug}/" class="group block bg-white dark:bg-white/[0.03] rounded-2xl border border-gray-200 dark:border-white/[0.06] overflow-hidden hover:border-blue-400 dark:hover:border-blue-500/30 transition-all duration-300 hover:shadow-lg hover:shadow-blue-500/5">
                <div class="p-5">
                  <div class="flex items-center gap-2 mb-3">
                    <span class="text-xs px-2.5 py-1 bg-blue-50 dark:bg-blue-500/10 text-blue-600 dark:text-blue-400 rounded-full font-medium">${categoryEmoji} ${post.data.category || 'AI 뉴스'}</span>
                    <span class="text-xs text-gray-400 dark:text-gray-500">${dateFormatted}</span>
                  </div>
                  <h3 class="font-bold text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-2 mb-2">${post.data.title}</h3>
                  <p class="text-sm text-gray-500 dark:text-gray-400 line-clamp-2">${post.data.description || ''}</p>
                </div>
              </a>`;
          }).join('');
        }

        // CourseSection 컴포넌트 렌더링
        const courseContainer = document.getElementById('course-posts');
        if (courseContainer && data.coursePosts?.length > 0) {
          courseContainer.innerHTML = data.coursePosts.map(post => {
            const rawDate = post.data.date?.substring(0, 10) || '';
            const [y, m, d] = rawDate.split('-').map(Number);
            const dateFormatted = y ? `${y}년 ${m}월 ${d}일` : '';
            const tags = post.data.tags || [];
            const level = tags.find(t => t.startsWith('강좌'))?.replace('강좌', 'Step ') || (tags.includes('입문') ? '입문' : tags.includes('실습') ? '실습' : '강좌');
            return `
              <a href="/blog/${post.slug}/" class="group block bg-white dark:bg-white/[0.03] rounded-2xl border border-gray-200 dark:border-white/[0.06] overflow-hidden hover:border-purple-400 dark:hover:border-purple-500/30 transition-all duration-300 hover:shadow-lg hover:shadow-purple-500/5">
                <div class="p-5">
                  <div class="flex items-center gap-2 mb-3">
                    <span class="text-xs px-2.5 py-1 bg-purple-50 dark:bg-purple-500/10 text-purple-600 dark:text-purple-400 rounded-full font-medium">📚 ${level}</span>
                    <span class="text-xs text-gray-400 dark:text-gray-500">${dateFormatted}</span>
                  </div>
                  <h3 class="font-bold text-gray-900 dark:text-white group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors line-clamp-2 mb-2">${post.data.title}</h3>
                  <p class="text-sm text-gray-500 dark:text-gray-400 line-clamp-2">${post.data.description || ''}</p>
                </div>
              </a>`;
          }).join('');
        }
      } catch (e) { console.error('Blog load error:', e); }
    }

    document.addEventListener('DOMContentLoaded', function() {
      loadBlogData();

      if (typeof particlesJS !== 'undefined' && document.getElementById('particles-js')) {
        particlesJS('particles-js', {
          particles: {
            number: { value: 50, density: { enable: true, value_area: 800 } },
            color: { value: ['#3B82F6', '#8B5CF6', '#06B6D4', '#60A5FA'] },
            shape: { type: 'circle' },
            opacity: { value: 0.5, random: true, anim: { enable: true, speed: 0.5, opacity_min: 0.1, sync: false } },
            size: { value: 2.5, random: true, anim: { enable: true, speed: 1, size_min: 0.5, sync: false } },
            line_linked: { enable: true, distance: 120, color: '#6366F1', opacity: 0.2, width: 1 },
            move: { enable: true, speed: 0.8, direction: 'none', random: true, straight: false, out_mode: 'out' }
          },
          interactivity: {
            detect_on: 'canvas',
            events: { onhover: { enable: true, mode: 'grab' }, onclick: { enable: true, mode: 'push' }, resize: true },
            modes: { grab: { distance: 120, line_linked: { opacity: 0.5 } }, push: { particles_nb: 2 } }
          },
          retina_detect: true
        });
      }
    });
  </script>

  <style is:global>
    @keyframes pulse-slow { 0%, 100% { opacity: 0.2; transform: scale(1); } 50% { opacity: 0.35; transform: scale(1.1); } }
    @keyframes pulse-slow2 { 0%, 100% { opacity: 0.15; transform: scale(1); } 50% { opacity: 0.25; transform: scale(1.15); } }
    @keyframes pulse-slow3 { 0%, 100% { opacity: 0.1; transform: scale(1); } 50% { opacity: 0.2; transform: scale(1.05); } }
    .animate-pulse-slow { animation: pulse-slow 8s ease-in-out infinite; }
    .animate-pulse-slow2 { animation: pulse-slow2 12s ease-in-out infinite 2s; }
    .animate-pulse-slow3 { animation: pulse-slow3 10s ease-in-out infinite 4s; }
  </style>
</Layout>
