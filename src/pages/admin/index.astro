<html lang="ko">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="icon" href="/favicon.png" />
<title>AI코리아24 관리자</title>
<style is:global>
*{margin:0;padding:0;box-sizing:border-box}
body{background:#0f172a !important;color:#e2e8f0 !important;font-family:-apple-system,BlinkMacSystemFont,sans-serif;padding:20px}
h1{font-size:1.4rem;margin-bottom:4px}
.date{color:#94a3b8;font-size:.85rem;margin-bottom:12px}
.status{font-size:.85rem;margin-bottom:12px;color:#94a3b8}
.intro-label{color:#3b82f6;font-size:.9rem;font-weight:600;margin-bottom:6px}
textarea.intro{width:100% !important;height:80px;background:#1e293b !important;color:#e2e8f0 !important;border:1px solid #334155;border-radius:8px;padding:10px;font-size:.9rem;resize:vertical;margin-bottom:14px}
.fbar{display:flex;gap:8px;margin-bottom:14px;flex-wrap:wrap}
.fbtn{background:#1e293b !important;color:#94a3b8 !important;border:1px solid #334155;padding:6px 14px;border-radius:6px;cursor:pointer;font-size:.8rem;transition:all .1s}
.fbtn.on{background:#3b82f6 !important;color:#fff !important;border-color:#3b82f6}
.fbtn:active{transform:scale(.95)}
.card{background:#1e293b !important;border:2px solid #334155;border-radius:8px;padding:14px;margin-bottom:10px;cursor:pointer;transition:border-color .1s}
.card.sel{border-color:#3b82f6}
.card h3{font-size:.95rem;margin-bottom:4px;display:inline}
.card .meta{font-size:.75rem;color:#64748b;margin-bottom:6px}
.card .desc{font-size:.82rem;color:#94a3b8;line-height:1.4}
.card .link-btn{display:inline-block;margin-top:6px;padding:3px 10px;background:#334155;color:#93c5fd;border:1px solid #475569;border-radius:4px;font-size:.75rem;text-decoration:none;cursor:pointer}
.card .link-btn:hover{background:#475569;color:#bfdbfe}
.card .ck{display:inline-block;width:20px;height:20px;border:2px solid #475569;border-radius:4px;text-align:center;line-height:18px;margin-right:8px;font-size:14px;vertical-align:middle}
.card.sel .ck{background:#3b82f6;border-color:#3b82f6;color:#fff}
.card .cmt{margin-top:8px;display:none}
.card.sel .cmt{display:block}
.card .cmt textarea{width:100% !important;min-height:52px;background:#0f172a !important;color:#f8fafc !important;border:1px solid #475569 !important;border-radius:6px;padding:8px 10px;font-size:.85rem;resize:vertical;font-family:inherit;line-height:1.4}
.card .cmt textarea::placeholder{color:#64748b !important}
.bot{position:fixed;bottom:0;left:0;right:0;background:#1e293b !important;border-top:1px solid #334155;padding:12px 20px;display:flex;justify-content:space-between;align-items:center;z-index:100}
.bot .cnt{color:#3b82f6;font-weight:600}
.bot .pub{background:#2563eb;color:#fff;border:none;padding:10px 24px;border-radius:8px;cursor:pointer;font-size:.9rem;font-weight:600}
.bot .pub:disabled{background:#334155;color:#64748b;cursor:not-allowed}
.bot .del{background:#dc2626;color:#fff;border:none;padding:8px 16px;border-radius:6px;cursor:pointer;font-size:.8rem;display:none}
.msg{margin:0 16px;font-size:.85rem}
.msg.ok{color:#4ade80}
.msg.err{color:#f87171}
.loading{text-align:center;padding:40px;color:#64748b}
#list{padding-bottom:80px}
.overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:200;justify-content:center;align-items:center}
.overlay.show{display:flex}
.popup{background:#1e293b;border:1px solid #334155;border-radius:12px;padding:20px;width:90%;max-width:480px;max-height:80vh;overflow-y:auto}
.popup h2{font-size:1.1rem;margin-bottom:12px;color:#e2e8f0}
.popup .hint{font-size:.78rem;color:#64748b;margin-bottom:12px}
.ord-item{display:flex;align-items:center;gap:10px;background:#0f172a;border:1px solid #334155;border-radius:8px;padding:10px 12px;margin-bottom:8px;cursor:grab;user-select:none}
.ord-item:active{cursor:grabbing;border-color:#3b82f6}
.ord-item .num{color:#3b82f6;font-weight:700;font-size:1.1rem;min-width:24px}
.ord-item .ttl{flex:1;font-size:.88rem;color:#e2e8f0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ord-item .arrows{display:flex;flex-direction:column;gap:2px}
.ord-item .arr{background:none;border:1px solid #475569;color:#94a3b8;width:26px;height:22px;border-radius:4px;cursor:pointer;font-size:.7rem;display:flex;align-items:center;justify-content:center}
.ord-item .arr:hover{background:#334155;color:#fff}
.popup .actions{display:flex;gap:10px;margin-top:14px;justify-content:flex-end}
.popup .btn-cancel{background:#334155;color:#94a3b8;border:none;padding:8px 18px;border-radius:6px;cursor:pointer;font-size:.85rem}
.popup .btn-publish{background:#2563eb;color:#fff;border:none;padding:8px 24px;border-radius:6px;cursor:pointer;font-size:.85rem;font-weight:600}
.popup .btn-publish:disabled{background:#334155;color:#64748b;cursor:not-allowed}
.dd-item{background:#0f172a;border:1px solid #334155;border-radius:8px;padding:12px;margin-bottom:10px}
.dd-item .dd-num{color:#3b82f6;font-weight:700;font-size:.85rem;margin-bottom:4px}
.dd-item .dd-ttl{font-size:.88rem;color:#e2e8f0;margin-bottom:8px;line-height:1.4}
.dd-item .dd-input{width:100%;background:#1e293b;color:#e2e8f0;border:1px solid #475569;border-radius:6px;padding:7px 10px;font-size:.82rem;outline:none;transition:border-color .15s}
.dd-item .dd-input:focus{border-color:#3b82f6}
.dd-item .dd-input.linked{border-color:#4ade80;background:#0f2a1a}
.dd-item .dd-status{font-size:.72rem;margin-top:4px;height:14px}
.dd-item .dd-status.ok{color:#4ade80}
.dd-item .dd-status.err{color:#f87171}
.dd-link-btn{background:#7c3aed;color:#fff;border:none;padding:8px 16px;border-radius:6px;cursor:pointer;font-size:.8rem;font-weight:600;margin-left:8px}
.dd-link-btn:hover{background:#6d28d9}
</style>
</head>
<body>
<div style="display:flex;gap:8px;margin-bottom:16px">
<a href="/admin/" style="color:#fff;text-decoration:none;padding:6px 14px;border-radius:6px;font-size:.85rem;background:#3b82f6;border:1px solid #3b82f6">브리핑</a>
<a href="/admin/event/" style="color:#94a3b8;text-decoration:none;padding:6px 14px;border-radius:6px;font-size:.85rem;background:#1e293b;border:1px solid #334155">이벤트</a>
</div>
<h1>AI코리아24 브리핑 작성</h1>
<div class="date" id="dinfo"></div>
<div class="status" id="curStatus">확인 중...</div>
<div class="intro-label">오늘의 인사이트 (브리핑 서두)</div>
<textarea class="intro" id="introText" placeholder="오늘 AI 업계의 핵심 흐름을 한두 문장으로..."></textarea>
<div class="fbar" id="fbar"></div>
<div class="fbar" id="dbar">
  <button class="fbtn" data-d="1">오늘</button>
  <button class="fbtn on" data-d="3">3일</button>
  <button class="fbtn" data-d="7">7일</button>
  <button class="fbtn" data-d="14">14일</button>
</div>
<div id="list"></div>
<div class="overlay" id="orderOverlay">
<div class="popup">
<h2>발행 순서 정하기</h2>
<div class="hint">드래그 또는 화살표로 순서를 조정하세요. 1번이 카드뉴스 헤드라인이 됩니다.</div>
<div id="orderList"></div>
<div class="actions">
<button class="btn-cancel" id="orderCancel">취소</button>
<button class="btn-publish" id="orderConfirm">이 순서로 발행</button>
</div>
</div>
</div>

<!-- Deep Dive 연결 팝업 -->
<div class="overlay" id="ddOverlay">
<div class="popup" style="max-width:560px">
<h2>📖 심층글 연결</h2>
<div class="hint">각 브리핑 아이템에 블로그 심층글 URL을 입력하세요. 비워두면 연결이 해제됩니다.</div>
<div id="ddList"></div>
<div class="actions">
<button class="btn-cancel" id="ddCancel">닫기</button>
<button class="btn-publish" id="ddSaveAll">전체 저장</button>
</div>
</div>
</div>

<div class="bot">
  <span class="cnt" id="cnt">0건 선택</span>
  <button class="del" id="delbtn">삭제</button>
  <span class="msg" id="msg"></span>
  <button class="pub" id="pub" disabled>브리핑 발행</button>
    <button class="email-btn" id="emailBtn" style="display:none;background:#7c3aed;color:#fff;border:none;padding:10px 24px;border-radius:8px;cursor:pointer;font-size:.9rem;font-weight:600;margin-left:8px;">📧 이메일 발송</button>
    <button class="dd-link-btn" id="ddBtn" style="display:none">📖 심층글 연결</button>
</div>

<script is:inline>
document.addEventListener("DOMContentLoaded", function(){
  var today = (function(){var d=new Date(Date.now()+9*3600*1000);return d.toISOString().split('T')[0];})();
  document.getElementById('dinfo').textContent = today + ' 브리핑';

  function esc(s){if(!s)return'';return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');}

  var allNews = [];
  var sel = {};
  var cmts = {};
  var newsCache = {};
  var days = 3;
  var currentFilter = 'all';
  var loadId = 0;
  var abortCtrl = null;

  // === 필터 바 ===
  var ftrs = [
    {k:'all',l:'전체'},{k:'kr',l:'국내'},{k:'global',l:'해외'},
    {k:'policy',l:'정책'},{k:'benefit',l:'혜택'},
    {k:'senior',l:'시니어'},{k:'startup',l:'스타트업'},{k:'grant',l:'지원사업'}
  ];
  var fbar = document.getElementById('fbar');
  ftrs.forEach(function(f,i){
    var b = document.createElement('button');
    b.className = 'fbtn' + (i===0?' on':'');
    b.textContent = f.l;
    b.setAttribute('data-f', f.k);
    fbar.appendChild(b);
  });
  fbar.addEventListener('click', function(e){
    var b = e.target.closest('.fbtn');
    if(!b) return;
    fbar.querySelectorAll('.fbtn').forEach(function(x){x.classList.remove('on')});
    b.classList.add('on');
    currentFilter = b.getAttribute('data-f');
    load(currentFilter);
  });

  // === 날짜 바 ===
  document.getElementById('dbar').addEventListener('click', function(e){
    var b = e.target.closest('.fbtn');
    if(!b) return;
    e.currentTarget.querySelectorAll('.fbtn').forEach(function(x){x.classList.remove('on')});
    b.classList.add('on');
    days = parseInt(b.getAttribute('data-d'));
    load(currentFilter);
  });

  // === 그리기 (DocumentFragment 사용) ===
  function draw(){
    var list = document.getElementById('list');
    var frag = document.createDocumentFragment();
    for(var i=0;i<allNews.length;i++){
      var n = allNews[i];
      var isSel = !!sel[n.id];
      var card = document.createElement('div');
      card.className = 'card' + (isSel ? ' sel' : '');
      card.setAttribute('data-nid', n.id);

      var badge = (n.country && n.country !== 'kr') ? '해외' : '국내';
      var cat = n.category ? ' ' + n.category : '';
      var desc = (n.description || '').substring(0, 120);
      var src = n.source || '';
      var date = (n.pub_date || n.created_at || '').substring(0, 10);

      card.innerHTML =
        '<div><span class="ck">'+(isSel?'✓':'')+'</span><h3>'+esc(n.title)+'</h3> <small>'+badge+cat+'</small></div>'+
        '<div class="meta">'+esc(src)+' · '+date+'</div>'+
        '<div class="desc">'+esc(desc)+'...</div>'+
        '<a class="link-btn" href="'+esc(n.link)+'" target="_blank" rel="noopener">원문 보기 ↗</a>'+
        '<div class="cmt"><textarea placeholder="이 뉴스가 왜 중요한지..." data-cid="'+n.id+'">'+(cmts[n.id]||'')+'</textarea>'+
        '<div style="font-size:.75rem;color:#64748b;margin-top:2px">나의 코멘트</div></div>';

      frag.appendChild(card);
    }
    list.innerHTML = '';
    list.appendChild(frag);
  }

  function upd(){
    var n = 0;
    for(var k in sel) if(sel[k]) n++;
    document.getElementById('cnt').textContent = n + '건 선택';
    document.getElementById('pub').disabled = (n === 0);
  }

  // === 카드 클릭 ===
  document.getElementById('list').addEventListener('click', function(e){
    if(e.target.tagName === 'TEXTAREA' || e.target.tagName === 'A') return;
    var card = e.target.closest('.card');
    if(!card) return;
    var nid = parseInt(card.getAttribute('data-nid'));
    if(sel[nid]){ delete sel[nid]; card.classList.remove('sel'); }
    else { sel[nid] = true; card.classList.add('sel'); }
    // 체크마크만 업데이트 (전체 리드로 안함)
    var ck = card.querySelector('.ck');
    if(ck) ck.textContent = sel[nid] ? '✓' : '';
    upd();
  });

  document.getElementById('list').addEventListener('input', function(e){
    var cid = e.target.getAttribute('data-cid');
    if(cid) cmts[parseInt(cid)] = e.target.value;
  });

  // === 뉴스 로드 (AbortController로 이전 요청 취소) ===
  function load(filter){
    if(abortCtrl) abortCtrl.abort();
    abortCtrl = new AbortController();
    var thisId = ++loadId;

    document.getElementById('list').innerHTML = '<div class="loading">로딩 중...</div>';

    fetch('/api/briefing/news/?filter='+filter+'&days='+days+'&limit=100', {signal: abortCtrl.signal})
      .then(function(r){return r.json()})
      .then(function(data){
        if(thisId !== loadId) return;
        allNews = Array.isArray(data) ? data : (data.results || []);
        for(var j=0;j<allNews.length;j++) newsCache[allNews[j].id] = allNews[j];
        draw();
        upd();
      })
      .catch(function(e){
        if(e.name === 'AbortError') return;
        document.getElementById('list').innerHTML = '<div class="loading">로드 실패: '+e.message+'</div>';
      });
  }

  // === 브리핑 상태 확인 ===
  function checkStatus(){
    fetch('/api/briefing/latest/')
      .then(function(r){return r.json()})
      .then(function(d){
        var st = document.getElementById('curStatus');
        var db = document.getElementById('delbtn');
        var eb = document.getElementById('emailBtn');
        if(!st) return;
            if(d && d.briefing && d.briefing.date === today){
              st.innerHTML = '오늘 브리핑 발행됨: <b>'+(d.items?d.items.length:0)+'건</b>';
              st.style.color = '#4ade80';
              if(db) db.style.display = 'inline-block';
              if(eb) eb.style.display = 'inline-block';
            } else {
              st.textContent = '오늘 발행된 브리핑 없음';
              st.style.color = '#94a3b8';
              if(db) db.style.display = 'none';
              if(eb) eb.style.display = 'none';
            }
            var ddBtnEl = document.getElementById('ddBtn');
            if(ddBtnEl) ddBtnEl.style.display = 'inline-block';
      })
      .catch(function(e){ console.log('checkStatus:', e); });
  }
  checkStatus();

  // === 삭제 ===
  document.getElementById('delbtn').addEventListener('click', function(){
    if(!confirm('오늘 브리핑을 삭제하시겠습니까?')) return;
    var msg = document.getElementById('msg');
    fetch('/api/briefing/publish/',{method:'DELETE',headers:{'Content-Type':'application/json'},body:JSON.stringify({date:today})})
      .then(function(r){return r.json()})
      .then(function(d){
        msg.className = d.ok ? 'msg ok' : 'msg err';
        msg.textContent = d.ok ? '삭제 완료' : '실패: '+(d.error||'');
        checkStatus();
      })
      .catch(function(e){ msg.className='msg err'; msg.textContent='에러: '+e; });
  });

  // === 발행 ===
  var orderedItems = [];

  function getSelectedItems(){
    var items = [];
    for(var k in sel){
      if(sel[k]){
        var nid = parseInt(k);
        var cached = newsCache[nid];
        var title = cached ? cached.title : '뉴스 #'+nid;
        items.push({news_id:nid, comment:cmts[nid]||'', title:title});
      }
    }
    return items;
  }

  function renderOrderList(){
    var ol = document.getElementById('orderList');
    ol.innerHTML = '';
    for(var i=0;i<orderedItems.length;i++){
      var item = orderedItems[i];
      var div = document.createElement('div');
      div.className = 'ord-item';
      div.setAttribute('data-idx', i);
      div.innerHTML = '<span class="num">'+(i+1)+'</span><span class="ttl">'+item.title+'</span><span class="arrows"><button class="arr" data-dir="up">▲</button><button class="arr" data-dir="down">▼</button></span>';
      ol.appendChild(div);
    }
  }

  document.addEventListener('click', function(e){
    var btn = e.target.closest('.arr');
    if(!btn) return;
    var dir = btn.getAttribute('data-dir');
    var item = btn.closest('.ord-item');
    var idx = parseInt(item.getAttribute('data-idx'));
    if(dir==='up' && idx>0){
      var tmp = orderedItems[idx-1];
      orderedItems[idx-1] = orderedItems[idx];
      orderedItems[idx] = tmp;
      renderOrderList();
    } else if(dir==='down' && idx<orderedItems.length-1){
      var tmp2 = orderedItems[idx+1];
      orderedItems[idx+1] = orderedItems[idx];
      orderedItems[idx] = tmp2;
      renderOrderList();
    }
  });

  document.getElementById('pub').addEventListener('click', function(){
    var items = getSelectedItems();
    if(items.length===0){alert('뉴스를 선택해주세요');return;}
    orderedItems = items;
    renderOrderList();
    document.getElementById('orderOverlay').classList.add('show');
  });

  document.getElementById('orderCancel').addEventListener('click', function(){
    document.getElementById('orderOverlay').classList.remove('show');
  });

  document.getElementById('orderOverlay').addEventListener('click', function(e){
    if(e.target === this) this.classList.remove('show');
  });

  document.getElementById('orderConfirm').addEventListener('click', function(){
    var confirmBtn = this;
    confirmBtn.disabled = true;
    confirmBtn.textContent = '발행 중...';
    var intro = document.getElementById('introText').value;
    var pub = document.getElementById('pub');
    var msg = document.getElementById('msg');

    var submitItems = [];
    for(var i=0;i<orderedItems.length;i++){
      submitItems.push({news_id:orderedItems[i].news_id, comment:orderedItems[i].comment});
    }

    fetch('/api/briefing/publish/',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({date:today,intro:intro,items:submitItems})})
      .then(function(r){return r.json()})
      .then(function(d){
        document.getElementById('orderOverlay').classList.remove('show');
        confirmBtn.disabled = false;
        confirmBtn.textContent = '이 순서로 발행';
        if(d.ok){
          msg.className='msg ok'; msg.textContent='발행 완료! '+d.items_count+'건';
          pub.textContent='발행 완료!';
          checkStatus();
          setTimeout(function(){ pub.textContent='브리핑 발행'; pub.disabled=false; msg.textContent=''; }, 3000);
        } else {
          msg.className='msg err'; msg.textContent='실패: '+(d.error||'');
        }
      })
      .catch(function(e){
        document.getElementById('orderOverlay').classList.remove('show');
        confirmBtn.disabled = false;
        confirmBtn.textContent = '이 순서로 발행';
        msg.className='msg err'; msg.textContent='에러: '+e.message;
      });
  });


    // === Deep Dive 연결 (날짜 선택 방식) ===
    function loadDdItems(briefingId){
      var ddList = document.getElementById('ddList');
      ddList.innerHTML = '<div class="loading">로딩 중...</div>';

      fetch('/api/briefing/deepdive/?briefing_id='+briefingId)
        .then(function(r){return r.json()})
        .then(function(items){
          if(!Array.isArray(items)||items.length===0){
            ddList.innerHTML = '<div style="color:#64748b;font-size:.85rem;padding:12px">해당 날짜의 브리핑 아이템이 없습니다.</div>';
            return;
          }
          ddList.innerHTML = '';
          for(var i=0;i<items.length;i++){
            var it = items[i];
            var div = document.createElement('div');
            div.className = 'dd-item';
            var hasUrl = it.deep_dive_url && it.deep_dive_url !== '';
            div.innerHTML =
              '<div class="dd-num">'+(i+1)+'번 아이템</div>'+
              '<div class="dd-ttl">'+esc(it.title||'제목 없음')+'</div>'+
              '<input class="dd-input'+(hasUrl?' linked':'')+'" type="url" '+
                'placeholder="https://aikorea24.kr/blog/..." '+
                'data-item-id="'+it.id+'" '+
                'value="'+esc(it.deep_dive_url||'')+'">'+
              '<div class="dd-status" id="dds-'+it.id+'">'+(hasUrl?'<span style="color:#4ade80">&#10003; 연결됨</span>':'')+'</div>';
            ddList.appendChild(div);
          }
        })
        .catch(function(e){
          ddList.innerHTML = '<div style="color:#f87171">로드 실패: '+e.message+'</div>';
        });
    }

    function openDdOverlay(){
      // 날짜 선택 UI를 ddList 상단에 먼저 렌더링
      var ddList = document.getElementById('ddList');
      var defaultDate = today;
      ddList.innerHTML =
        '<div style="margin-bottom:14px">'+
          '<label style="font-size:.8rem;color:#94a3b8;display:block;margin-bottom:6px">브리핑 날짜 선택</label>'+
          '<div style="display:flex;gap:8px;align-items:center">'+
            '<input type="date" id="ddDatePicker" value="'+defaultDate+'" '+
              'style="background:#0f172a;color:#e2e8f0;border:1px solid #475569;border-radius:6px;padding:6px 10px;font-size:.85rem;outline:none">'+
            '<button id="ddDateLoad" style="background:#3b82f6;color:#fff;border:none;padding:6px 14px;border-radius:6px;cursor:pointer;font-size:.82rem;font-weight:600">불러오기</button>'+
          '</div>'+
        '</div>'+
        '<div id="ddItemsWrap"></div>';

      document.getElementById('ddOverlay').classList.add('show');

      // 날짜 변경 시 아이템 로드
      function loadByDate(dateVal){
        var wrap = document.getElementById('ddItemsWrap');
        if(!wrap) return;
        wrap.innerHTML = '<div class="loading">로딩 중...</div>';
        // 날짜로 briefing_id 조회
        fetch('/api/briefing/latest/?date='+dateVal)
          .then(function(r){return r.json()})
          .then(function(d){
            if(!d || !d.briefing){
              wrap.innerHTML = '<div style="color:#64748b;font-size:.85rem;padding:8px">해당 날짜의 브리핑이 없습니다.</div>';
              return;
            }
            var briefingId = d.briefing.id;
            fetch('/api/briefing/deepdive/?briefing_id='+briefingId)
              .then(function(r){return r.json()})
              .then(function(items){
                if(!Array.isArray(items)||items.length===0){
                  wrap.innerHTML = '<div style="color:#64748b;font-size:.85rem;padding:8px">아이템이 없습니다.</div>';
                  return;
                }
                wrap.innerHTML = '';
                for(var i=0;i<items.length;i++){
                  var it = items[i];
                  var div = document.createElement('div');
                  div.className = 'dd-item';
                  var hasUrl = it.deep_dive_url && it.deep_dive_url !== '';
                  div.innerHTML =
                    '<div class="dd-num">'+(i+1)+'번 아이템</div>'+
                    '<div class="dd-ttl">'+esc(it.title||'제목 없음')+'</div>'+
                    '<input class="dd-input'+(hasUrl?' linked':'')+'" type="url" '+
                      'placeholder="https://aikorea24.kr/blog/..." '+
                      'data-item-id="'+it.id+'" '+
                      'value="'+esc(it.deep_dive_url||'')+'">'+
                    '<div class="dd-status" id="dds-'+it.id+'">'+(hasUrl?'<span style="color:#4ade80">&#10003; 연결됨</span>':'')+'</div>';
                  wrap.appendChild(div);
                }
              })
              .catch(function(e){
                wrap.innerHTML = '<div style="color:#f87171">아이템 로드 실패: '+e.message+'</div>';
              });
          })
          .catch(function(e){
            wrap.innerHTML = '<div style="color:#f87171">브리핑 조회 실패: '+e.message+'</div>';
          });
      }

      // 초기 로드 (오늘 날짜)
      loadByDate(defaultDate);

      // 불러오기 버튼
      var loadBtn = document.getElementById('ddDateLoad');
      if(loadBtn){
        loadBtn.addEventListener('click', function(){
          var dp = document.getElementById('ddDatePicker');
          if(dp && dp.value) loadByDate(dp.value);
        });
      }
    }

    // === 이메일 발송 ===
    document.getElementById('emailBtn')?.addEventListener('click', function(){
      var btn = this;
      var msg = document.getElementById('msg');
      btn.disabled = true;
      btn.textContent = '발송 중...';
      msg.className = 'msg';
      msg.textContent = '이메일 발송 중입니다...';

      fetch('/api/briefing/send-email/', { method: 'POST' })
        .then(function(r){ return r.json(); })
        .then(function(d){
          btn.disabled = false;
          btn.textContent = '📧 이메일 발송';
          if(d.ok){
            msg.className = 'msg ok';
            msg.textContent = '✅ ' + d.message;
          } else {
            msg.className = 'msg err';
            msg.textContent = '❌ ' + (d.error || '발송 실패');
          }
        })
        .catch(function(e){
          btn.disabled = false;
          btn.textContent = '📧 이메일 발송';
          msg.className = 'msg err';
          msg.textContent = '❌ 에러: ' + e.message;
        });
    });

    var ddBtnMain = document.getElementById('ddBtn');
    if(ddBtnMain) ddBtnMain.addEventListener('click', openDdOverlay);

    var ddCancelBtn = document.getElementById('ddCancel');
    if(ddCancelBtn) ddCancelBtn.addEventListener('click', function(){
      document.getElementById('ddOverlay').classList.remove('show');
    });

    var ddOverlayEl = document.getElementById('ddOverlay');
    if(ddOverlayEl) ddOverlayEl.addEventListener('click', function(e){
      if(e.target===this) this.classList.remove('show');
    });

    var ddSaveBtn = document.getElementById('ddSaveAll');
    if(ddSaveBtn) ddSaveBtn.addEventListener('click', function(){
      var saveBtn = this;
      saveBtn.disabled = true;
      saveBtn.textContent = '저장 중...';
      var inputs = document.querySelectorAll('#ddItemsWrap .dd-input, #ddList .dd-input');
      var total = inputs.length;
      var done = 0;
      if(total===0){saveBtn.disabled=false;saveBtn.textContent='전체 저장';return;}
      for(var i=0;i<inputs.length;i++){
        (function(inp){
          var itemId = parseInt(inp.getAttribute('data-item-id'));
          var urlVal = inp.value.trim();
          fetch('/api/briefing/deepdive/',{
            method:'PATCH',
            headers:{'Content-Type':'application/json'},
            body:JSON.stringify({item_id:itemId, deep_dive_url:urlVal||null})
          })
          .then(function(r){return r.json()})
          .then(function(d){
            var st = document.getElementById('dds-'+itemId);
            if(d.ok){
              if(urlVal){inp.classList.add('linked');if(st)st.innerHTML='<span style="color:#4ade80">&#10003; 저장됨</span>';}
              else{inp.classList.remove('linked');if(st)st.innerHTML='';}
            } else {
              if(st)st.innerHTML='<span style="color:#f87171">오류: '+(d.error||'')+'</span>';
            }
          })
          .catch(function(){
            var st = document.getElementById('dds-'+itemId);
            if(st)st.innerHTML='<span style="color:#f87171">실패</span>';
          })
          .finally(function(){
            done++;
            if(done>=total){saveBtn.disabled=false;saveBtn.textContent='전체 저장';}
          });
        })(inputs[i]);
      }
    });

  load('all');
});
</script>

</body>
</html>
