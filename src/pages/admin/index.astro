---
export const prerender = false;

import { verifySession } from '../../lib/auth';

const ADMIN_EMAILS = ['twinssn@gmail.com'];

let isAuth = false;
const session = Astro.cookies.get('session')?.value;
if (session) {
  const user = await verifySession(session, Astro.locals.sessionSecret);
  if (user) {
    isAuth = ADMIN_EMAILS.includes(user.email);
  }
}

if (!isAuth) {
  return new Response('Unauthorized', { status: 401 });
}

// AIK24-RENEWAL-01 D-1: 뉴스 브리핑 수동 페이지 폐기.
// 뉴스는 전부 자동 발행으로 전환되어 이 편집 화면을 쓰지 않는다(무료 LLM).
// 원본 721줄 편집 UI는 /tmp/admin_index_backup.astro 에 백업.
---
<html lang="ko">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>AI코리아24 관리자</title>
<style is:global>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:-apple-system,BlinkMacSystemFont,'Pretendard',sans-serif;background:#0A0E1A;color:#fff;padding:40px 20px}
.wrap{max-width:560px;margin:0 auto}
h1{font-size:1.3rem;margin-bottom:8px}
p{color:#94a3b8;font-size:.9rem;line-height:1.6;margin-bottom:20px}
a{color:#fff;text-decoration:none;padding:8px 16px;border-radius:6px;font-size:.85rem;background:#3b82f6;display:inline-block}
a:hover{background:#2563eb}
</style>
</head>
<body>
<div class="wrap">
<h1>관리자</h1>
<p>뉴스 브리핑 수동 작성 기능은 폐기되었습니다. 뉴스는 자동 발행으로 전환되었습니다.</p>
<a href="/admin/tools/">도구 관리 바로가기</a>
</div>
</body>
</html>
