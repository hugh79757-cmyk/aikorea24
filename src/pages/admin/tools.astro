---
export const prerender = false;

import { env } from 'cloudflare:workers';
import { verifySession } from '../../lib/auth';
import { getCollection } from 'astro:content';
import { findDuplicates, dedupeIndex } from '../../lib/tool-duplicates';
import type { IndexEntry, DupHit } from '../../lib/tool-duplicates';

// Phase 3-C Wave B: 관리자 검토 큐 (pending 목록 + 승인/반려)
// Auth gate: admin/index.astro와 동일 패턴 (비관리자 → 401)
const ADMIN_EMAILS = ['twinssn@gmail.com'];

let isAuth = false;
const session = Astro.cookies.get('session')?.value;
if (session) {
  const user = await verifySession(session, Astro.locals.sessionSecret);
  if (user) {
    isAuth = ADMIN_EMAILS.includes(user.email);
  }
}

if (!isAuth) {
  return new Response('Unauthorized', { status: 401 });
}

type QueueRow = {
  slug: string;
  name: string;
  url: string;
  category: string;
  category_custom: string | null;
  description: string;
  price_model: string | null;
  price_detail: string | null;
  user_id: number;
  owner_email: string | null;
  created_at: string;
};

let pending: QueueRow[] = [];
let published: QueueRow[] = [];
let retired: QueueRow[] = [];
let counts = { pending: 0, published: 0, retired: 0 };
let dbError = '';
const ROW_COLS = `t.slug, t.name, t.url, t.category, t.category_custom, t.description,
        t.price_model, t.price_detail, t.user_id, t.created_at,
        (SELECT email FROM users WHERE id = t.user_id) AS owner_email`;
try {
  const db = env.DB;
  if (!db) {
    dbError = 'DB 없음';
  } else {
    const { results } = await db
      .prepare(
        `SELECT ${ROW_COLS}
           FROM tool_submissions t WHERE t.status = 'pending' ORDER BY t.created_at DESC`
      )
      .all();
    pending = (results as QueueRow[]) || [];
    const { results: pub } = await db
      .prepare(
        `SELECT ${ROW_COLS}
           FROM tool_submissions t WHERE t.status = 'published' ORDER BY t.created_at DESC`
      )
      .all();
    published = (pub as QueueRow[]) || [];
    const { results: ret } = await db
      .prepare(
        `SELECT ${ROW_COLS}, t.rejection_reason, t.updated_at
           FROM tool_submissions t WHERE t.status = 'retired' ORDER BY t.updated_at DESC`
      )
      .all();
    retired = (ret as QueueRow[]) || [];
    const { results: agg } = await db
      .prepare(`SELECT status, COUNT(*) AS c FROM tool_submissions GROUP BY status`)
      .all();
    for (const r of (agg as any[]) || []) {
      const s = String(r.status);
      if (s === 'pending') counts.pending = r.c;
      else if (s === 'published') counts.published = r.c;
      else if (s === 'retired') counts.retired = r.c;
    }
  }
} catch (e: any) {
  dbError = e?.message || '조회 실패';
}

// AIK24-TOOLDUP-NOTICE-01: 검토 화면 중복 노티스
// 인덱스 = 현재 목록에 실제로 노출되는 것(md 컬렉션) + 승인된 submission. 같은 슬러그는 md 를 남긴다.
// 조회가 실패해도 큐 자체는 떠야 하므로 fail-soft (이 경우 dupIndex 가 비어 노티스만 사라진다).
let dupIndex: IndexEntry[] = [];
try {
  const mdEntries: IndexEntry[] = (await getCollection('tools')).map((t: any) => ({
    slug: String(t.id ?? t.slug ?? ''),
    name: String(t.data?.name ?? ''),
    url: String(t.data?.url ?? ''),
    source: 'md' as const,
  }));
  const subEntries: IndexEntry[] = published.map((r) => ({
    slug: r.slug,
    name: r.name,
    url: r.url,
    source: 'submission' as const,
  }));
  dupIndex = dedupeIndex([...mdEntries, ...subEntries]);
} catch (e) {
  console.error('[admin/tools] 중복 인덱스 구성 실패 (fail-soft):', e);
  dupIndex = [];
}

const dups = (row: QueueRow, excludeSameSlug: boolean): DupHit[] =>
  dupIndex.length
    ? findDuplicates({ slug: row.slug, name: row.name, url: row.url }, dupIndex, { excludeSameSlug })
    : [];

const pendingDups = new Map<string, DupHit[]>();
for (const r of pending) pendingDups.set(r.slug, dups(r, false));
const publishedDups = new Map<string, DupHit[]>();
for (const r of published) publishedDups.set(r.slug, dups(r, true));
const pendingView = pending.map((r) => ({ ...r, dups: pendingDups.get(r.slug) ?? [] }));
const publishedView = published.map((r) => ({ ...r, dups: publishedDups.get(r.slug) ?? [] }));
const pendingDupCount = pendingView.filter((r) => r.dups.length > 0).length;
---
<html lang="ko">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>도구 검토 큐 — AI코리아24 관리자</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{background:#0f172a;color:#e2e8f0;font-family:-apple-system,BlinkMacSystemFont,sans-serif;padding:20px}
h1{font-size:1.3rem;margin-bottom:4px}
.sub{color:#94a3b8;font-size:.85rem;margin-bottom:14px}
.counts{display:flex;gap:8px;margin-bottom:14px;flex-wrap:wrap}
.pill{font-size:.8rem;padding:4px 12px;border-radius:999px;border:1px solid #334155;background:#1e293b;color:#94a3b8}
.pill b{color:#e2e8f0}
.card{background:#1e293b;border:1px solid #334155;border-radius:10px;padding:14px;margin-bottom:10px}
.card h3{font-size:.95rem;margin-bottom:4px}
.card .meta{font-size:.75rem;color:#64748b;margin-bottom:6px}
.card .desc{font-size:.85rem;color:#cbd5e1;line-height:1.5;margin-bottom:8px}
.card a{color:#93c5fd;font-size:.8rem;word-break:break-all}
.row{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap}
.btn{border:none;padding:8px 18px;border-radius:6px;cursor:pointer;font-size:.85rem;font-weight:600}
.btn.approve{background:#16a34a;color:#fff}
.btn.reject{background:#dc2626;color:#fff}
.btn:disabled{background:#334155;color:#64748b;cursor:not-allowed}
.reason{flex:1;min-width:200px;background:#0f172a;color:#e2e8f0;border:1px solid #475569;border-radius:6px;padding:8px 10px;font-size:.85rem}
.msg{font-size:.85rem;margin-top:8px;min-height:1.2em}
.msg.ok{color:#4ade80}
.msg.err{color:#f87171}
.empty{text-align:center;padding:40px;color:#64748b}
.dberr{background:#7f1d1d;border:1px solid #ef4444;border-radius:8px;padding:12px;margin-bottom:14px;font-size:.85rem}
.dupbox{border-radius:8px;padding:9px 11px;margin-top:10px;font-size:.8rem;line-height:1.5}
.dupbox.exact{background:#450a0a;border:1px solid #ef4444;color:#fecaca}
.dupbox.likely{background:#422006;border:1px solid #d97706;color:#fde68a}
.dupbox b{color:#fff;font-size:.84rem}
.dupbox code{background:#0f172a;padding:1px 5px;border-radius:4px;color:#93c5fd}
.dupbox .hit{margin-top:3px}
.dupbox .hint{color:#94a3b8;margin-top:5px;font-size:.75rem}
.dupnone{font-size:.75rem;color:#475569;margin-top:9px}
.modal{position:fixed;inset:0;z-index:100;display:flex;align-items:center;justify-content:center;padding:16px}
.modal[hidden]{display:none}
.modal-backdrop{position:absolute;inset:0;background:rgba(2,6,23,.78)}
.modal-box{position:relative;background:#1e293b;border:1px solid #475569;border-radius:12px;padding:18px;max-width:540px;width:100%;max-height:86vh;overflow:auto;box-shadow:0 24px 60px rgba(0,0,0,.55)}
.modal-box h3{font-size:1.02rem;margin-bottom:10px}
.modal-row{display:flex;gap:8px;margin-top:16px;justify-content:flex-end;flex-wrap:wrap}
.btn.ghost{background:#334155;color:#cbd5e1}
.modal-ack{display:flex;gap:8px;align-items:flex-start;margin-top:12px;font-size:.8rem;color:#fecaca;background:#450a0a;border:1px solid #ef4444;border-radius:8px;padding:9px 11px;cursor:pointer;line-height:1.45}
.modal-ack[hidden]{display:none}
.modal-ack input{margin-top:2px;flex:none}
.mk-tool{font-size:.85rem;line-height:1.65;margin-bottom:10px;color:#cbd5e1}
.mk-tool code{background:#0f172a;padding:1px 5px;border-radius:4px;color:#93c5fd;font-size:.78rem}
.mk-url{font-size:.72rem;color:#64748b;word-break:break-all}
.mk-box{border-radius:8px;padding:10px 12px;font-size:.82rem;line-height:1.55}
.mk-box.exact{background:#450a0a;border:1px solid #ef4444;color:#fecaca}
.mk-box.likely{background:#422006;border:1px solid #d97706;color:#fde68a}
.mk-box.clean{background:#052e16;border:1px solid #16a34a;color:#bbf7d0}
.mk-box b{color:#fff;display:block;margin-bottom:5px;font-size:.88rem}
.mk-hit{margin-top:4px}
.mk-hit code{background:#0f172a;padding:1px 5px;border-radius:4px;color:#93c5fd}
.mk-hit a{color:#93c5fd}
.mk-hint{color:#94a3b8;margin-top:7px;font-size:.76rem}
</style>
</head>
<body>
<h1>🛠️ 도구 검토 큐</h1>
<p class="sub">pending 제출을 승인(published) 또는 반려(retired)합니다. Wave B 범위: 큐 + 승인 API만.</p>
<div class="counts">
  <span class="pill">🟡 검토중 <b>{counts.pending}</b></span>
  <span class="pill">🟢 공개 <b>{counts.published}</b></span>
  <span class="pill">🔴 반려 <b>{counts.retired}</b></span>
  <span class="pill">⚠️ 중복 의심 <b>{pendingDupCount}</b></span>
</div>
{dbError ? <div class="dberr">DB 오류: {dbError}</div> : null}
{pending.length === 0 && !dbError ? (
  <div class="empty">검토 대기 중인 도구가 없습니다 🎉</div>
) : null}
<div id="list">
{pendingView.map((t) => (
  <div class="card" data-slug={t.slug} data-dup={t.dups.length ? t.dups[0].level : ''} data-name={t.name} data-url={t.url} data-dups={JSON.stringify(t.dups.slice(0, 3))}>
    <h3>{t.name}</h3>
    <div class="meta">/{t.slug}/ · {t.category}{t.category_custom ? ` (${t.category_custom})` : ''} · {t.price_detail?.trim() || t.price_model || '—'} · {t.owner_email || `user#${t.user_id}`} · {t.created_at}</div>
    <p class="desc">{t.description}</p>
    <a href={t.url} target="_blank" rel="noopener">{t.url}</a>
    {t.dups.length ? (
      <div class={`dupbox ${t.dups[0].level}`}>
        <b>{t.dups[0].level === 'exact' ? '이미 중복입니다' : '중복 의심'}</b>
        <span> · {t.dups[0].reason}</span>
        {t.dups.slice(0, 3).map((h) => (
          <div class="hit">
            → <strong>{h.name}</strong> <code>/{h.slug}/</code> ({h.source === 'md' ? '목록' : '승인됨'}){' '}
            <a href={`/tools/${h.slug}/`} target="_blank" rel="noopener">보기 →</a>
          </div>
        ))}
        <div class="hint">
          {t.dups[0].level === 'exact'
            ? '승인하면 같은 제품이 목록에 두 번 노출됩니다. 기존 항목을 갱신하려면 이 제출은 반려하세요.'
            : '같은 제품인지 확인한 뒤 승인하세요. 다른 제품이면 그대로 승인해도 됩니다.'}
        </div>
      </div>
    ) : (
      <p class="dupnone">✓ 기존 목록과 중복 없음</p>
    )}
    <div class="row">
      <button type="button" class="btn approve" data-act="approve">승인 → 공개</button>
      <input class="reason" type="text" placeholder="반려 사유 (반려 시 필수)" maxlength="200" />
      <button type="button" class="btn reject" data-act="reject">반려</button>
    </div>
    <p class="msg"></p>
  </div>
))}
</div>
<h2 style="font-size:1rem;margin:18px 0 10px">🟢 공개됨 ({published.length})</h2>
{published.length === 0 && !dbError ? (
  <div class="empty" style="padding:20px">공개된 도구가 없습니다.</div>
) : null}
{publishedView.map((t) => (
  <div class="card" data-slug={t.slug}>
    <h3>{t.name}</h3>
    <div class="meta">/{t.slug}/ · {t.category}{t.category_custom ? ` (${t.category_custom})` : ''} · {t.price_detail?.trim() || t.price_model || '—'} · {t.owner_email || `user#${t.user_id}`} · {t.created_at}</div>
    <p class="desc">{t.description}</p>
    <a href={`/tools/${t.slug}/`} target="_blank" rel="noopener">상세 페이지 보기 →</a>
    {t.dups.length ? (
      <div class={`dupbox ${t.dups[0].level}`}>
        <b>{t.dups[0].level === 'exact' ? '이미 중복입니다' : '중복 의심'}</b>
        <span> · {t.dups[0].reason}</span>
        {t.dups.slice(0, 3).map((h) => (
          <div class="hit">
            → <strong>{h.name}</strong> <code>/{h.slug}/</code> ({h.source === 'md' ? '목록' : '승인됨'}){' '}
            <a href={`/tools/${h.slug}/`} target="_blank" rel="noopener">보기 →</a>
          </div>
        ))}
        <div class="hint">이미 공개된 항목입니다. 정리하려면 공개 취소 후 목록에서 제거하세요.</div>
      </div>
    ) : null}
    <div class="row">
      <button type="button" class="btn reject" data-act="unpublish">공개 취소</button>
    </div>
    <p class="msg"></p>
  </div>
))}
<h2 style="font-size:1rem;margin:18px 0 10px">🔴 반려됨 ({retired.length})</h2>
{retired.length === 0 && !dbError ? (
  <div class="empty" style="padding:20px">반려된 도구가 없습니다.</div>
) : null}
{retired.map((t) => (
  <div class="card" data-slug={t.slug}>
    <h3>{t.name}</h3>
    <div class="meta">/{t.slug}/ · {t.category}{t.category_custom ? ` (${t.category_custom})` : ''} · {t.owner_email || `user#${t.user_id}`} · {(t as any).updated_at}</div>
    <p class="desc">{t.description}</p>
    <p class="meta">사유: {(t as any).rejection_reason || '—'}</p>
  </div>
))}
<div id="approve-modal" class="modal" hidden>
  <div class="modal-backdrop" data-modal-close="1"></div>
  <div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="approve-modal-title">
    <h3 id="approve-modal-title">⚠️ 승인 확인 — 공개로 전환</h3>
    <div id="approve-modal-body"></div>
    <label class="modal-ack" id="approve-modal-ack-wrap" hidden>
      <input type="checkbox" id="approve-modal-ack" />
      <span>이미 목록에 있는 도구임을 확인했습니다. 그래도 승인합니다.</span>
    </label>
    <div class="modal-row">
      <button type="button" class="btn ghost" data-modal-close="1">취소</button>
      <button type="button" class="btn approve" id="approve-modal-ok">승인 → 공개</button>
    </div>
  </div>
</div>
<script>
import { describeApproveWarning } from '../../lib/tool-duplicates';

// AIK24-TOOLDUP-NOTICE-02 (2026-11-19): 승인 버튼은 항상 경고 창을 거친다.
// 이전 구현은 중복 배지가 있을 때만 window.confirm 을 띄웠고, 창을 닫거나 ESC 로
// 넘기면 확인 없이 공개됐다. 지금은 승인 요청 자체가 창의 '승인 → 공개' 버튼에서만 나간다.
const modal = document.getElementById('approve-modal');
const modalBody = document.getElementById('approve-modal-body');
const modalOk = document.getElementById('approve-modal-ok');
const modalAckWrap = document.getElementById('approve-modal-ack-wrap');
const modalAck = document.getElementById('approve-modal-ack');
let pendingApprove = null;

function parseDups(card) {
  try {
    const raw = card.getAttribute('data-dups') || '[]';
    const arr = JSON.parse(raw);
    return Array.isArray(arr) ? arr : [];
  } catch {
    return [];
  }
}

function closeApproveModal() {
  modal.hidden = true;
  modalBody.replaceChildren();
  pendingApprove = null;
}

function setModalOkEnabled(on) {
  modalOk.disabled = !on;
}

function openApproveModal(card, btn, slug, msg, reason) {
  const dups = parseDups(card);
  const w = describeApproveWarning(dups);

  modalBody.replaceChildren();

  const head = document.createElement('div');
  head.className = 'mk-tool';
  const nm = document.createElement('strong');
  nm.textContent = card.getAttribute('data-name') || '(이름 없음)';
  head.appendChild(nm);
  head.appendChild(document.createTextNode(' '));
  const sl = document.createElement('code');
  sl.textContent = '/' + slug + '/';
  head.appendChild(sl);
  const url = card.getAttribute('data-url') || '';
  if (url) {
    const u = document.createElement('div');
    u.className = 'mk-url';
    u.textContent = url;
    head.appendChild(u);
  }
  modalBody.appendChild(head);

  const box = document.createElement('div');
  box.className = 'mk-box ' + w.level;
  const title = document.createElement('b');
  title.textContent = w.title;
  box.appendChild(title);

  if (dups.length) {
    const reasonLine = document.createElement('div');
    reasonLine.textContent = '근거: ' + (dups[0].reason || '—');
    box.appendChild(reasonLine);
  }

  for (const h of dups.slice(0, 3)) {
    const line = document.createElement('div');
    line.className = 'mk-hit';
    line.appendChild(document.createTextNode('→ '));
    const sn = document.createElement('strong');
    sn.textContent = h.name || h.slug;
    line.appendChild(sn);
    line.appendChild(document.createTextNode(' '));
    const sc = document.createElement('code');
    sc.textContent = '/' + h.slug + '/';
    line.appendChild(sc);
    line.appendChild(document.createTextNode(' (' + (h.source === 'md' ? '목록' : '승인됨') + ') '));
    const a = document.createElement('a');
    a.href = '/tools/' + h.slug + '/';
    a.target = '_blank';
    a.rel = 'noopener';
    a.textContent = '보기 →';
    line.appendChild(a);
    box.appendChild(line);
  }

  const hint = document.createElement('div');
  hint.className = 'mk-hint';
  hint.textContent = w.hint;
  box.appendChild(hint);
  modalBody.appendChild(box);

  // exact 등급은 체크박스로 한 번 더 확인해야 승인 버튼이 열린다.
  const needAck = w.level === 'exact';
  modalAckWrap.hidden = !needAck;
  modalAck.checked = false;
  setModalOkEnabled(!needAck);

  pendingApprove = { card, btn, slug, msg, reason };
  modal.hidden = false;
  (needAck ? modalAck : modalOk).focus();
}

modal.querySelectorAll('[data-modal-close]').forEach((el) => {
  el.addEventListener('click', closeApproveModal);
});
modalAck.addEventListener('change', () => setModalOkEnabled(modalAck.checked));
modalOk.addEventListener('click', () => {
  const p = pendingApprove;
  closeApproveModal();
  if (p) runReview(p.card, p.btn, p.slug, p.msg, 'approve', p.reason);
});
document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape' && !modal.hidden) closeApproveModal();
});

async function runReview(card, btn, slug, msg, action, reason) {
  if (action === 'reject' && !reason) {
    if (msg) { msg.textContent = '❌ 반려 사유를 입력해주세요.'; msg.className = 'msg err'; }
    return;
  }
  btn.disabled = true;
  try {
    const res = await fetch('/api/admin/tools/review/', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ slug, action, reason: reason || undefined }),
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) {
      if (msg) { msg.textContent = '❌ ' + (data.error || '실패'); msg.className = 'msg err'; }
      return;
    }
    if (msg) {
      msg.textContent = action === 'approve' ? '✅ 공개됨 (published)' : '✅ 반려됨 (retired)';
      msg.className = 'msg ok';
    }
    card.querySelectorAll('.btn').forEach((b) => (b.disabled = true));
  } catch {
    if (msg) { msg.textContent = '❌ 네트워크 오류'; msg.className = 'msg err'; }
  } finally {
    if (!msg || !msg.classList.contains('ok')) btn.disabled = false;
  }
}

document.querySelectorAll('.card').forEach((card) => {
  const slug = card.getAttribute('data-slug');
  const msg = card.querySelector('.msg');
  const reasonInput = card.querySelector('.reason');
  card.querySelectorAll('.btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const act = btn.getAttribute('data-act');
      const reason = ((reasonInput && reasonInput.value) || '').trim();

      if (act === 'unpublish') {
        let r = reason;
        if (!r) r = (window.prompt('공개 취소 사유를 입력해주세요.') || '').trim();
        if (!r) {
          if (msg) { msg.textContent = '❌ 반려 사유를 입력해주세요.'; msg.className = 'msg err'; }
          return;
        }
        runReview(card, btn, slug, msg, 'reject', r);
        return;
      }

      if (act === 'reject') {
        runReview(card, btn, slug, msg, 'reject', reason);
        return;
      }

      if (act === 'approve') {
        openApproveModal(card, btn, slug, msg, reason);
      }
    });
  });
});
</script>
</body>
</html>
