<section class="py-16 px-4 bg-white">
  <div class="max-w-4xl mx-auto text-center">
    <div class="bg-white border-2 border-gray-200 rounded-2xl p-10">
      <h2 class="text-3xl font-bold text-[#111111] mb-4" style="font-family: var(--font-sans);">
        AI, 지금 바로 시작하세요
      </h2>
      <p class="text-gray-600 text-lg mb-8">
        어렵지 않습니다. ChatGPT 하나부터 차근차근, AI코리아24가 안내합니다.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-8">
        <a href="/blog" class="bg-[#111111] text-white font-semibold px-8 py-3 rounded-lg hover:bg-[#333333] transition">
          블로그 보기
        </a>
        <a href="/tools" class="border-2 border-[#111111] text-[#111111] font-semibold px-8 py-3 rounded-lg hover:bg-gray-50 transition">
          AI 툴 둘러보기
        </a>
      </div>
      <!-- 이메일 구독 폼 -->
      <div class="mt-8 pt-6 border-t border-gray-200">
        <p class="text-sm text-gray-600 mb-3" style="border-left: 4px solid #E63B2E; padding-left: 12px; display: inline-block;">📧 매일 아침 AI 브리핑 받아보기</p>
        <form id="home-subscribe" class="flex flex-col sm:flex-row gap-2 max-w-md mx-auto mt-4">
          <input type="email" id="home-email" placeholder="이메일 주소" required
            class="flex-1 px-4 py-2.5 rounded-lg bg-white border border-gray-300 text-[#111111] placeholder:text-gray-400 text-sm focus:ring-2 focus:ring-[#E63B2E] focus:border-transparent outline-none" />
          <button type="submit"
            class="px-5 py-2.5 bg-[#111111] text-white font-medium rounded-lg text-sm hover:bg-[#333333] transition-colors whitespace-nowrap">
            무료로 구독하기
          </button>
        </form>
        <p id="home-subscribe-msg" class="text-xs mt-2 text-gray-600 hidden"></p>
      </div>
    </div>
  </div>
</section>

<script>
document.getElementById('home-subscribe')?.addEventListener('submit', async (e) => {
  e.preventDefault();
  const input = document.getElementById('home-email');
  const msg = document.getElementById('home-subscribe-msg');
  const btn = e.target.querySelector('button');
  const email = input.value.trim();

  btn.disabled = true;
  btn.textContent = '처리 중...';
  msg.classList.add('hidden');

  try {
    const res = await fetch('/api/subscribe', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email })
    });
    const data = await res.json();

    if (res.ok) {
      msg.className = 'text-xs mt-2 text-[#E63B2E]';
      msg.textContent = '✅ 구독 완료! 매일 아침 AI 브리핑을 보내드립니다.';
      input.value = '';
    } else {
      msg.className = 'text-xs mt-2 text-red-600';
      msg.textContent = data.error || '오류가 발생했습니다.';
    }
  } catch (err) {
    msg.className = 'text-xs mt-2 text-red-600';
    msg.textContent = '네트워크 오류입니다.';
  } finally {
    btn.disabled = false;
    btn.textContent = '무료로 구독하기';
    msg.classList.remove('hidden');
  }
});
</script>
