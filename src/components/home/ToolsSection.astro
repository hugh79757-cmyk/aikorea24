---
import { env } from 'cloudflare:workers';
import ToolRow from '../tools/ToolRow.astro';

// AIK24-TOOLS-UX-01 작업5 (2차): 가로 스크롤 캐러셀 → 작업 1과 동일한 한 줄 행 리스트 5건.
// 소스 오브 트루스: scripts/auto_email_sender.py:95-105 get_tools() 와 동일한 UNION 쿼리
//   (md 동기화본 tools ∪ 사용자 등록본 tool_submissions(published)) ORDER BY updated_at DESC
// 이메일 뉴스레터와 같은 컬렉션에서 최신순으로 가져온다.
// AIK24-D1-READ-01: 분기마다 LIMIT 을 거는 bounded UNION — 전체 상위 N개는 반드시
//   각 분기의 상위 N개 안에 있다. (예전 511행+24행 전수 스캔 → 1,055행 읽기와 달리
//   뷰 1회당 읽기 행을 제한한다.) updated_at DESC, id ASC 로 동일 순서를 확정한다.

const QUERY_LIMIT = 8; // 이름 없는 행 방어분 — 아래에서 필터 후 5건만 노출
const DISPLAY_COUNT = 5;

type ToolRowDb = {
  src: number;
  name: string;
  slug: string;
  tagline: string;
  category: string;
  price: string;
  korean_support: number;
  difficulty: string;
  updated_at: string;
  url: string;
  price_model: string;
  logo_url: string;
};

let tools: ToolRowDb[] = [];
try {
  const db = env.DB;
  if (db) {
    const res = await db.prepare(
      `SELECT name, slug, tagline, category, price, korean_support, difficulty, updated_at, url, price_model, logo_url, src FROM (
         SELECT * FROM (
           SELECT 0 AS src, id AS rid, name, slug, tagline, category, price, korean_support, difficulty,
                  updated_at, url, NULL AS price_model, NULL AS logo_url
           FROM tools ORDER BY updated_at DESC, id ASC LIMIT ?
         )
         UNION ALL
         SELECT * FROM (
           SELECT 1 AS src, id AS rid, name, slug, description AS tagline, category,
                  COALESCE(NULLIF(price_detail, ''), price_model) AS price, korean_support,
                  COALESCE(difficulty, '초보자') AS difficulty, updated_at, url, price_model, logo_url
           FROM tool_submissions WHERE status = 'published' ORDER BY updated_at DESC, id ASC LIMIT ?
         )
       ) ORDER BY updated_at DESC, src ASC, rid ASC LIMIT ?`
    ).bind(QUERY_LIMIT, QUERY_LIMIT, QUERY_LIMIT).all();
    tools = (res.results || []) as ToolRowDb[];
  }
} catch (e) {
  // D1 장애 시 홈 전체가 죽지 않도록 섹션만 비운다.
  console.error('ToolsSection D1 error:', e);
}

// 1차와 같은 ToolRow 컴포넌트가 소비하는 형태로 정규화 (data-*·배지 로직 공유).
const visible = tools
  .map((t) => ({
    id: t.slug,
    isD1: Number(t.src) === 1,
    data: {
      name: String(t.name ?? '').trim(),
      description: String(t.tagline ?? '').split('\n')[0].trim(),
      category: String(t.category ?? ''),
      price: String(t.price ?? ''),
      priceModel: t.price_model ? String(t.price_model).trim() : null,
      logoUrl: String(t.logo_url ?? ''),
      koreanSupport: Number(t.korean_support) === 1,
      difficulty: String(t.difficulty ?? '중급'),
      tags: [],
      updated: String(t.updated_at ?? '').slice(0, 10),
      url: String(t.url ?? ''),
      verified: Number(t.src) === 1, // published submission = 관리자 검토 통과
    },
  }))
  .filter((t) => t.data.name !== '')
  .slice(0, DISPLAY_COUNT);
---

<section class="py-16 px-4 bg-white">
  <div class="max-w-5xl mx-auto">
    <h2 class="text-2xl md:text-3xl font-bold mb-2" style="font-family: var(--font-sans); border-left: 6px solid #E63B2E; padding-left: 24px;">
      오늘의 도구
    </h2>
    <p class="text-sm text-gray-500 mb-8" style="padding-left: 30px;">
      {visible.length > 0 ? `최신 등록 도구 ${visible.length}건 — 한눈에 훑어보세요.` : '한국어도 바로 쓰는 실전 도구를 모았습니다.'}
    </p>

    {visible.length > 0 ? (
      <div class="flex flex-col gap-2">
        {visible.map((tool, i) => <ToolRow tool={tool} index={i} />)}
      </div>
    ) : (
      <div class="text-center py-12">
        <img src="/mascot-tiger.png" alt="AI코리아24 마스코트" width="120" height="120"
          class="mx-auto mb-4" loading="lazy" decoding="async"
          onerror="this.onerror=null;this.src='/logo-final.webp';" />
        <p class="text-gray-500">아직 표시할 도구가 없습니다.</p>
      </div>
    )}

    <div class="mt-8" style="padding-left: 30px;">
      <a href="/tools/" class="inline-flex items-center gap-1 text-sm font-semibold text-[#111111] hover:text-[#E63B2E] transition-colors">
        전체 툴 보기 <span class="inline-block">→</span>
      </a>
    </div>
  </div>
</section>
