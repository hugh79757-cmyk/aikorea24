---
const { briefing, items } = Astro.props;
const hasData = briefing && items && items.length > 0;

function formatDate(dateStr: string) {
  const d = new Date(dateStr.split('-').slice(0, 3).join('-'));
  const month = d.getMonth() + 1;
  const day = d.getDate();
  const weekdays = ['일', '월', '화', '수', '목', '금', '토'];
  const weekday = weekdays[d.getDay()];
  return `${month}월 ${day}일 (${weekday})`;
}
---

<section class="relative z-10 px-4 py-16 bg-white">
  <div class="max-w-3xl mx-auto">

    {hasData ? (
      <div>
        <div class="mb-10">
          <div class="inline-flex items-center gap-2 bg-gray-50 border border-gray-200 rounded-full px-4 py-1.5 mb-4">
            <span class="w-2 h-2 bg-[#E63B2E] rounded-full"></span>
            <span class="text-sm text-gray-600">오늘의 AI 브리핑</span>
          </div>
          <h2 class="text-3xl md:text-4xl font-bold mb-3 text-[#111111]" style="font-family: var(--font-sans); border-left: 4px solid #E63B2E; padding-left: 12px;">
            {formatDate(briefing.date)}
          </h2>
        </div>

        {briefing.intro && (
          <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 mb-10">
            <p class="text-lg leading-relaxed text-gray-700 italic">
              "{briefing.intro}"
            </p>
          </div>
        )}

        <div class="space-y-6">
          {items.map((item: any, idx: number) => (
            <article class="group bg-white border border-gray-200 rounded-xl p-6 hover:border-[#E63B2E] transition-all duration-300">
              <div class="flex items-start gap-4">
                <span class="flex-shrink-0 w-8 h-8 bg-[#111111] rounded-lg flex items-center justify-center text-white font-bold text-sm">
                  {idx + 1}
                </span>
                <div class="flex-1 min-w-0">
                  <a href={`/briefing/${briefing.date}/#item-${idx+1}`} class="block">
                    <h3 class="text-lg font-semibold text-[#111111] mb-2 group-hover:text-[#E63B2E] transition-colors leading-snug">
                      {item.title}
                    </h3>
                  </a>
                   {item.comment && (
                    <p class="text-base text-gray-700 mb-2 leading-relaxed">
                      {item.comment}
                    </p>
                  )}
                  <div class="flex items-center gap-3 text-xs text-gray-500">
                    <span>{item.source}</span>
                    {item.country && item.country !== 'kr' && (
                      <span class="bg-gray-100 text-gray-600 px-2 py-0.5 rounded">해외</span>
                    )}
                    <a href={`/briefing/${briefing.date}/#item-${idx+1}`} class="ml-auto text-gray-500 hover:text-[#E63B2E] transition-colors">
                      자세히 보기 &rarr;
                    </a>
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>

        <div class="text-center mt-10">
          <a href="/briefing/" class="text-sm text-gray-500 hover:text-[#E63B2E] transition-colors">
            이전 브리핑 보기 &rarr;
          </a>
        </div>
      </div>
    ) : (
      <div class="text-center py-20">
        <div class="text-6xl mb-4">📡</div>
        <h2 class="text-2xl font-bold mb-2 text-[#111111]" style="font-family: var(--font-sans);">오늘의 브리핑 준비 중</h2>
        <p class="text-gray-500">매일 아침 AI 뉴스를 직접 선별하여 발행합니다</p>
      </div>
    )}

  </div>
</section>
