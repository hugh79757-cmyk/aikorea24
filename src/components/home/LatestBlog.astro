---
interface Props { posts: any[] }
const { posts } = Astro.props;

function getCategoryEmoji(category: string): string {
  const map: Record<string, string> = {
    'AI 도구': '🛠️', 'AI 강좌': '📚', 'AI 뉴스': '📰',
    'AI 지원사업': '💰', 'AI 체험': '🧪', '재테크': '💎',
  };
  return map[category] || '✍️';
}
---
<section class="relative z-10 px-4 pb-20 bg-white">
  <div class="max-w-6xl mx-auto">
    <div class="flex justify-between items-center mb-8">
      <h2 class="text-xl font-bold text-[#111111]" style="font-family: var(--font-sans); border-left: 4px solid #E63B2E; padding-left: 12px;">최신 블로그</h2>
      <a href="/blog" class="text-sm text-gray-600 hover:text-[#E63B2E] font-medium transition-colors hidden md:block">전체 보기 →</a>
    </div>
    <div id="latest-blog-posts" class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {posts.length === 0 && <div class="col-span-3 text-center text-gray-400 py-8">로딩 중...</div>}
      {posts.map((post: any) => {
        const rawDate = post.data.date instanceof Date
          ? post.data.date.toISOString()
          : String(post.data.date);
        const [y, m, d] = rawDate.substring(0, 10).split('-').map(Number);
        const dateFormatted = `${y}년 ${m}월 ${d}일`;
        return (
          <a href={`/blog/${post.id}/`} class="group block bg-white border border-gray-200 rounded-xl overflow-hidden hover:border-[#E63B2E] hover:shadow-md transition-all duration-300">
            {post.data.image ? (
              <div class="aspect-square overflow-hidden">
                <img src={post.data.image} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" width="400" height="300" />
              </div>
            ) : (
              <div class="aspect-square bg-gray-50 flex items-center justify-center">
                <span class="text-4xl opacity-60 group-hover:opacity-100 group-hover:scale-110 transition-all duration-300">{getCategoryEmoji(post.data.category)}</span>
              </div>
            )}
            <div class="p-5">
              <div class="flex items-center gap-2 mb-2">
                <span class="text-[10px] font-semibold text-[#E63B2E]">{post.data.category}</span>
                <span class="text-[10px] text-gray-500">{dateFormatted}</span>
              </div>
              <h2 class="font-bold text-[#111111] group-hover:text-[#E63B2E] transition-colors line-clamp-2" style="font-family: var(--font-sans);">{post.data.title}</h2>
              <p class="text-sm text-gray-600 mt-2 line-clamp-2">{post.data.description}</p>
            </div>
          </a>
        );
      })}
    </div>
    <div class="text-center mt-6 md:hidden">
      <a href="/blog" class="text-sm text-gray-600 hover:text-[#E63B2E] font-medium">전체 보기 →</a>
    </div>
  </div>
</section>
