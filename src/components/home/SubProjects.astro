---
const projects = [
  {
    title: 'Link2Threads',
    desc: '스레드 콘텐츠를 링크로 연결하는 큐레이션',
    url: 'https://link2threads.com',
    image: '/images/link2threads-logo.webp',
  },
  {
    title: '한국인 AI 페르소나',
    desc: '나와 비슷한 한국인의 금융·보험·투자 패턴을 AI로 분석',
    url: 'https://persona.aikorea24.kr',
    image: '/images/persona-og.jpg',
  },
];
---

<section class="relative z-10 px-4 py-16 bg-white">
  <div class="max-w-4xl mx-auto">
    <div class="mb-10">
      <h2 class="text-2xl md:text-3xl font-bold text-[#111111] mb-2" style="font-family: var(--font-sans); border-left: 4px solid #E63B2E; padding-left: 12px;">서브 프로젝트</h2>
      <p class="text-gray-500 text-sm" style="padding-left: 16px;">AI코리아24에서 운영하는 프로젝트들</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
      {projects.map((p) => (
        <a href={p.url} target="_blank" rel="noopener"
           class="group block bg-white border border-gray-200 rounded-xl overflow-hidden hover:border-[#E63B2E] hover:shadow-md transition-all duration-300">
          <div class="aspect-video overflow-hidden">
            <img src={p.image} alt={p.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
          </div>
          <div class="p-6">
            <h3 class="text-lg font-bold mb-2 text-[#111111]" style="font-family: var(--font-sans);">{p.title}</h3>
            <p class="text-sm text-gray-600 mb-4 leading-relaxed">{p.desc}</p>
            <span class="text-sm text-[#111111] group-hover:text-[#E63B2E] group-hover:translate-x-1 inline-block transition-all">
              바로가기 &rarr;
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
