<section class="relative z-10 min-h-[560px] flex items-center px-4 bg-white">
  <div class="relative z-10 max-w-5xl mx-auto">
    <div class="inline-flex items-center gap-2 bg-gray-50 border border-gray-200 rounded-full px-5 py-2 mb-8">
      <span class="w-2 h-2 bg-[#E63B2E] rounded-full"></span>
      <span class="text-sm text-gray-600">AI 큐레이션 플랫폼</span>
    </div>
    <h1 class="text-4xl md:text-6xl font-bold mb-6 leading-[1.15] tracking-tight text-left" style="font-family: var(--font-sans); border-left: 6px solid #E63B2E; padding-left: 24px;">
      매일 아침 5분,<br/>
      AI 뉴스 핵심만
    </h1>
    <p class="text-lg md:text-xl text-gray-600 mb-10 max-w-xl leading-relaxed text-left" style="padding-left: 30px;">
      오늘 무료로 쓸 수 있는<br class="hidden sm:inline" />AI 소식만 골라서 보내드립니다
    </p>

    <div class="flex items-center gap-6 mb-3" style="padding-left: 30px;">
      <form id="hero-subscribe" class="flex flex-col sm:flex-row gap-2 max-w-md flex-1">
        <input type="email" id="hero-email" name="email" placeholder="이메일 주소" required
          class="flex-1 px-4 py-3.5 rounded-lg bg-white border border-gray-300 text-black placeholder:text-gray-400 text-sm focus:ring-2 focus:ring-gray-400 focus:border-transparent outline-none" />
        <button type="submit"
          class="px-6 py-3.5 bg-[#111111] text-white font-semibold rounded-lg text-sm hover:bg-[#333333] transition-colors whitespace-nowrap">
          무료로 구독하기
        </button>
      </form>
      <img src="/mascot-tiger.png" alt="AI코리아24 마스코트" width="120" height="120"
        class="hidden md:block shrink-0" loading="lazy" decoding="async"
        onerror="this.onerror=null;this.src='/logo-final.webp';" />
    </div>
    <p id="hero-subscribe-msg" class="text-xs mt-2 text-[#E63B2E] hidden" style="padding-left: 30px;"></p>
    <p class="text-xs text-gray-500 mb-10" style="padding-left: 30px;">광고 없음 · 언제든 해지 가능</p>

    <div class="flex flex-col sm:flex-row gap-4" style="padding-left: 30px;">
      <a href="/courses/7day-starter/"
         class="group bg-[#111111] text-white font-semibold px-8 py-4 rounded-lg hover:bg-[#333333] transition-colors">
        7일 강좌 시작하기 <span class="inline-block ml-1 group-hover:translate-x-1 transition-transform">→</span>
      </a>
      <a href="/about" class="bg-white border border-gray-300 font-semibold px-8 py-4 rounded-lg hover:bg-gray-50 transition-colors text-gray-700">
        더 알아보기
      </a>
    </div>
  </div>
</section>

<script>
  const heroForm = document.getElementById('hero-subscribe');
  heroForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const input = document.getElementById('hero-email');
    const msg = document.getElementById('hero-subscribe-msg');
    const btn = heroForm.querySelector('button');
    const email = input.value.trim();

    btn.disabled = true;
    btn.textContent = '처리 중...';
    msg.classList.add('hidden');

    try {
      const res = await fetch('/api/subscribe/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email })
      });
      const data = await res.json();

      if (res.ok) {
        msg.textContent = '구독 완료! 매일 아침 AI 브리핑을 보내드립니다.';
        input.value = '';
      } else {
        msg.textContent = data.error || '오류가 발생했습니다.';
      }
    } catch {
      msg.textContent = '네트워크 오류입니다.';
    } finally {
      btn.disabled = false;
      btn.textContent = '무료로 구독하기';
      msg.classList.remove('hidden');
    }
  });
</script>