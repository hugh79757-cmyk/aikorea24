---
// AIK24-TOOLS-LOGO-01 — 목록·상세가 함께 쓰는 도구 아이콘.
// 우선순위: 업로드 로고 → Google 파비콘 → 이름 첫 글자 모노그램.
// 파비콘은 www. 를 제거한 도메인으로 s2에 요청한다(지시서 §4).
interface Props {
  name: string;
  logoUrl?: string | null;
  url?: string | null;
  sizeClass?: string; // 기본 48px(w-12 h-12), 상세는 w-16 h-16
  textClass?: string; // 모노그램 글자 크기
}
const { name, logoUrl, url, sizeClass = 'w-12 h-12', textClass = 'text-lg' } = Astro.props;

const logo = String(logoUrl ?? '').trim();
const m = String(url ?? '').match(/^https?:\/\/([^/?#]+)/i);
const domain = m ? m[1].toLowerCase().replace(/^www\./, '') : '';
const initial = String(name ?? '').trim().charAt(0) || '?';
---

{logo ? (
  <span class:list={['relative flex-shrink-0 bg-white rounded-lg overflow-hidden border border-gray-200', sizeClass]}>
    <img src={logo} alt="" loading="lazy" decoding="async" class="w-full h-full object-contain bg-white" />
  </span>
) : domain ? (
  <span class:list={['relative flex-shrink-0 bg-gray-100 rounded-lg overflow-hidden', sizeClass]}>
    <img
      src={`https://www.google.com/s2/favicons?domain=${encodeURIComponent(domain)}&sz=64`}
      alt="" loading="lazy" decoding="async" class="w-full h-full object-contain"
      onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
    />
    <span class:list={['absolute inset-0 hidden items-center justify-center bg-gray-100 text-gray-500 font-bold', textClass]}>{initial}</span>
  </span>
) : (
  <span class:list={['flex-shrink-0 flex items-center justify-center bg-gray-100 text-gray-500 font-bold rounded-lg', sizeClass, textClass]}>{initial}</span>
)}
