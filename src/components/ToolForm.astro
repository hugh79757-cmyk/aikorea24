---
import { TASKS } from '../config/tasks';

export interface ToolInitialData {
  name?: string;
  url?: string;
  description?: string;
  category?: string;
  category_custom?: string;
  price_model?: string;
  price_detail?: string;
  screenshot_url?: string;
  korean_support?: boolean | number;
  difficulty?: string;
  use_cases?: string;
  tags?: string | string[];
  tasks?: string | string[];
  detail_markdown?: string;
  slug?: string;
}

interface Props {
  mode: 'create' | 'edit';
  initialData?: ToolInitialData;
  slug?: string;
}

const { mode, initialData = {}, slug = '' } = Astro.props;
const isEdit = mode === 'edit';

const categories = [
  { id: '글쓰기·챗봇', emoji: '✍️' },
  { id: '이미지 생성', emoji: '🎨' },
  { id: '영상·음성', emoji: '🎬' },
  { id: '업무·생산성', emoji: '📊' },
  { id: '코딩·개발', emoji: '💻' },
  { id: '디자인', emoji: '🖼️' },
  { id: '번역·학습', emoji: '🌐' },
  { id: '기타', emoji: '📦' },
];
const taskSlugs = Object.keys(TASKS);

const d = {
  name: initialData.name ?? '',
  url: initialData.url ?? '',
  description: initialData.description ?? '',
  category: initialData.category ?? '',
  category_custom: initialData.category_custom ?? '',
  price_model: initialData.price_model ?? '무료',
  price_detail: initialData.price_detail ?? '',
  screenshot_url: initialData.screenshot_url ?? '',
  korean_support: initialData.korean_support === true || initialData.korean_support === 1,
  difficulty: initialData.difficulty ?? '',
  use_cases: initialData.use_cases ?? '',
  detail_markdown: initialData.detail_markdown ?? '',
};

function toStrArray(v: string | string[] | undefined): string[] {
  if (!v) return [];
  if (Array.isArray(v)) return v.map((x) => String(x));
  try {
    const a = JSON.parse(v);
    if (Array.isArray(a)) return a.map((x: any) => String(x));
  } catch {}
  return String(v).split(',').map((s) => s.trim()).filter(Boolean);
}

const tagsStr = Array.isArray(initialData.tags)
  ? initialData.tags.join(', ')
  : (initialData.tags ?? '');
const taskArr = toStrArray(initialData.tasks as any);

const title = isEdit ? '🛠️ AI 툴 수정하기' : '🛠️ AI 툴 등록하기';
const subtitle = isEdit
  ? '등록한 도구 정보를 수정합니다. slug는 변경되지 않습니다.'
  : '아직 등록되지 않은 AI 툴을 추천해주세요. 제출 즉시 디렉토리에 게시됩니다.';
const submitLabel = isEdit ? '수정 완료' : '등록 제출하기';
---

<div class="max-w-2xl mx-auto px-4 py-12">
  <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-4">{title}</h1>
  <p class="text-gray-600 dark:text-gray-400 mb-8">{subtitle}</p>

  <div id="error-msg" class="hidden bg-red-50 dark:bg-red-500/20 border border-red-200 dark:border-red-500/50 text-red-700 dark:text-red-300 px-4 py-3 rounded-lg mb-6"></div>

  <!-- Step 표시 -->
  <div class="flex items-center gap-2 mb-8">
    <div id="step-dot-1" class="flex items-center gap-2">
      <span class="w-7 h-7 rounded-full bg-blue-600 text-white text-sm flex items-center justify-center font-bold">1</span>
      <span class="text-sm font-medium text-gray-900 dark:text-white">필수 정보</span>
    </div>
    <div class="flex-1 h-px bg-gray-300 dark:bg-gray-600"></div>
    <div id="step-dot-2" class="flex items-center gap-2 opacity-50">
      <span class="w-7 h-7 rounded-full bg-gray-300 dark:bg-gray-600 text-gray-600 dark:text-gray-300 text-sm flex items-center justify-center font-bold">2</span>
      <span class="text-sm font-medium text-gray-500 dark:text-gray-400">추가 정보</span>
    </div>
  </div>

  <form id="submit-form" class="space-y-6" data-mode={mode} data-slug={slug}>
    <!-- Step 1: 필수 5필드 -->
    <div id="step-1" class="space-y-6">
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">툴 이름 *</label>
        <input type="text" id="f-name" required value={d.name} class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 outline-none" placeholder="예: ChatGPT" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">공식 URL *</label>
        <input type="url" id="f-url" required value={d.url} class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 outline-none" placeholder="https://chat.openai.com" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">한 줄 설명 * (<span id="desc-count">{d.description.length}</span>/200)</label>
        <textarea id="f-description" required rows="2" maxlength="200" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 outline-none" placeholder="이 툴을 한 줄로 설명해주세요 (200자 이내)">{d.description}</textarea>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">카테고리 *</label>
          <select id="f-category" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 outline-none">
            {categories.map(cat => <option value={cat.id} selected={d.category ? cat.id === d.category : undefined}>{cat.emoji} {cat.id}</option>)}
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">가격 모델 *</label>
          <div class="flex gap-4 py-2.5" role="radiogroup" aria-label="가격 모델">
            <label class="flex items-center gap-1.5 text-sm text-gray-700 dark:text-gray-300">
              <input type="radio" name="price_model" value="무료" checked={d.price_model === '무료'} class="rounded text-blue-600" /> 무료
            </label>
            <label class="flex items-center gap-1.5 text-sm text-gray-700 dark:text-gray-300">
              <input type="radio" name="price_model" value="Freemium" checked={d.price_model === 'Freemium'} class="rounded text-blue-600" /> Freemium
            </label>
            <label class="flex items-center gap-1.5 text-sm text-gray-700 dark:text-gray-300">
              <input type="radio" name="price_model" value="유료" checked={d.price_model === '유료'} class="rounded text-blue-600" /> 유료
            </label>
          </div>
          <input type="text" id="f-price-detail" value={d.price_detail} class="mt-2 w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 outline-none" placeholder="가격 상세 (선택, 예: 월 9,900원부터)" />
        </div>
      </div>
      <div id="category-custom-wrap" class={d.category === '기타' ? '' : 'hidden'}>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">희망 카테고리 (기타 선택 시)</label>
        <input type="text" id="f-category-custom" value={d.category_custom} class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 outline-none" placeholder="원하는 카테고리를 적어주세요 (선택)" />
      </div>
      <button type="button" id="btn-next" class="w-full py-3 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl transition-colors">다음 →</button>
    </div>

    <!-- Step 2: 선택 7필드 -->
    <div id="step-2" class="space-y-6 hidden">
      <div class="flex items-center gap-2">
        <input type="checkbox" id="f-korean" checked={d.korean_support} class="rounded text-blue-600" />
        <label for="f-korean" class="text-sm text-gray-700 dark:text-gray-300">한국어 지원</label>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">난이도</label>
        <select id="f-difficulty" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 outline-none">
          <option value="" selected={!d.difficulty}>선택 안 함</option>
          <option value="초보자" selected={d.difficulty === '초보자'}>초보자 OK</option>
          <option value="중급" selected={d.difficulty === '중급'}>중급</option>
          <option value="고급" selected={d.difficulty === '고급'}>고급</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">활용사례</label>
        <input type="text" id="f-usecases" value={d.use_cases} class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 outline-none" placeholder="예: 블로그 글쓰기, 회의 요약" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">태그 (쉼표 구분)</label>
        <input type="text" id="f-tags" value={tagsStr} class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 outline-none" placeholder="예: AI, 글쓰기, 무료" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">스크린샷 (선택)</label>
        <input type="hidden" id="f-screenshot-url" value={d.screenshot_url} />
        <div id="screenshot-drop" class="border-2 border-dashed border-gray-600 rounded-xl p-6 text-center cursor-pointer hover:border-blue-500 transition-colors">
          <input type="file" id="f-screenshot-file" accept="image/jpeg,image/png,image/webp,image/gif" class="hidden" />
          <div id="screenshot-prompt">
            <p class="text-2xl mb-2">📷</p>
            <p class="text-sm font-medium text-gray-700 dark:text-gray-300">클릭하여 이미지 업로드</p>
            <p class="text-sm text-gray-500 dark:text-gray-400">또는 파일을 여기로 드래그</p>
            <p class="text-xs text-gray-500 dark:text-gray-500 mt-2">JPG, PNG, WebP · 최대 2MB</p>
          </div>
          <div id="screenshot-uploading" class="hidden">
            <p class="text-sm text-gray-500 dark:text-gray-400">업로드 중...</p>
          </div>
          <div id="screenshot-preview" class="hidden">
            <img id="screenshot-thumb" src="" alt="스크린샷 미리보기" class="max-h-40 mx-auto rounded-lg mb-2" />
            <p id="screenshot-meta" class="text-xs text-gray-500 dark:text-gray-400 mb-2"></p>
            <button type="button" id="screenshot-remove" class="text-xs px-3 py-1.5 bg-gray-200 hover:bg-gray-300 dark:bg-gray-700 dark:hover:bg-gray-600 text-gray-800 dark:text-white font-bold rounded-lg transition-colors">✕ 삭제</button>
          </div>
        </div>
        <p id="screenshot-error" class="hidden text-sm text-red-600 dark:text-red-400 mt-2"></p>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">연관작업 (최대 5개)</label>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 max-h-48 overflow-y-auto border border-gray-300 dark:border-gray-600 rounded-lg p-3">
          {taskSlugs.map(slug => (
            <label class="flex items-center gap-1.5 text-sm text-gray-700 dark:text-gray-300">
              <input type="checkbox" name="tasks" value={slug} checked={taskArr.includes(slug)} class="rounded text-blue-600 task-check" />
              <span>{TASKS[slug].title.replace(' 추천', '')}</span>
            </label>
          ))}
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">상세 설명</label>
        <textarea id="f-detail" rows="4" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 outline-none" placeholder="이 툴의 자세한 소개를 적어주세요 (선택)">{d.detail_markdown}</textarea>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <button type="button" id="btn-back" class="py-3 bg-gray-200 hover:bg-gray-300 dark:bg-gray-700 dark:hover:bg-gray-600 text-gray-800 dark:text-white font-bold rounded-xl transition-colors">← 이전</button>
        <button type="submit" id="btn-submit" class="py-3 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl transition-colors">{submitLabel}</button>
      </div>
    </div>
  </form>

  {isEdit ? (
    <!-- 수정 완료화면 -->
    <div id="edit-done-state" class="hidden py-8 text-center">
      <p class="text-2xl mb-2">✅</p>
      <p class="text-lg font-bold text-gray-900 dark:text-white mb-6">수정이 완료되었습니다.</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/my/tools/" class="px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl transition-colors text-sm">내 도구 목록으로 →</a>
        <a id="edit-done-link" href={slug ? `/tools/${slug}/` : '/tools/'} class="px-6 py-3 bg-gray-100 hover:bg-gray-200 dark:bg-gray-700 dark:hover:bg-gray-600 text-gray-800 dark:text-white font-bold rounded-xl transition-colors text-sm">도구 페이지 보기 →</a>
      </div>
    </div>
  ) : (
    <!-- 완료화면 (41-03 Task 1: 카드 미리보기 + MAKER + 카페 퍼널) -->
    <div id="done-state" class="hidden py-8">
      <div class="text-center mb-6">
        <p class="text-2xl mb-2">✅</p>
        <p class="text-lg font-bold text-gray-900 dark:text-white mb-2">등록되었습니다!</p>
        <p class="text-sm text-gray-600 dark:text-gray-400">slug: <span id="done-slug" class="font-mono"></span></p>
      </div>

      <!-- 카드 미리보기 (index 카드 클래스 재사용) -->
      <div class="relative flex flex-col bg-white rounded-2xl border border-gray-200 overflow-hidden dark:bg-[#111827]/60 dark:border-white/[0.06] mb-6">
        <div class="h-0.5 w-full bg-gradient-to-r from-purple-500 to-indigo-600"></div>
        <div class="p-4 sm:p-5 flex-1 flex flex-col">
          <div class="flex items-start justify-between mb-2">
            <h3 id="preview-name" class="text-sm sm:text-base font-bold text-gray-900 dark:text-white leading-snug pr-2"></h3>
            <div class="flex gap-1 flex-shrink-0">
              <span class="text-xs font-bold px-2 py-0.5 bg-purple-100 text-purple-700 rounded-full border border-purple-200 dark:bg-purple-500/15 dark:text-purple-400 dark:border-purple-500/20">MAKER</span>
            </div>
          </div>
          <p id="preview-desc" class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 line-clamp-2 mb-3 flex-1 leading-relaxed"></p>
          <div class="flex items-center justify-between gap-2 pt-3 border-t border-gray-100 dark:border-white/[0.05]">
            <span id="preview-cat" class="text-xs text-gray-500 dark:text-gray-500"></span>
            <span id="preview-price" class="text-[11px] font-medium text-gray-600 dark:text-gray-500 flex-shrink-0"></span>
          </div>
        </div>
      </div>

      <!-- 카페 퍼널 -->
      <div class="flex flex-col sm:flex-row gap-3 mb-6">
        <button type="button" id="cafe-copy-btn" class="flex-1 py-3 bg-green-600 hover:bg-green-700 text-white font-bold rounded-xl transition-colors text-sm">📋 카페 공유 문구 복사</button>
        <a id="cafe-link" href="https://cafe.naver.com/aikorea24" target="_blank" rel="noopener" class="flex-1 py-3 text-center bg-gray-100 hover:bg-gray-200 dark:bg-gray-700 dark:hover:bg-gray-600 text-gray-800 dark:text-white font-bold rounded-xl transition-colors text-sm">☕ 카페 바로가기</a>
      </div>
      <p id="copy-ok" class="hidden text-sm text-green-600 dark:text-green-400 text-center mb-4">복사되었습니다! 카페에 붙여넣기 해주세요.</p>

      <div class="text-center">
        <a id="done-link" href="#" class="inline-block px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl transition-colors text-sm">내 도구 보기 →</a>
      </div>
    </div>
  )}

  <div class="mt-8 text-center">
    <a href="/tools/" class="text-blue-600 dark:text-blue-400 hover:underline text-sm">← 전체 도구 목록으로</a>
  </div>
</div>

<script>
  const CAFE_URL = 'https://cafe.naver.com/aikorea24';
  const form = document.getElementById('submit-form');
  const mode = form?.dataset.mode || 'create';
  const editSlug = form?.dataset.slug || '';
  const isEditMode = mode === 'edit';
  const SUBMIT_URL = isEditMode ? `/api/tools/${editSlug}` : '/api/tools/submit';
  const SUBMIT_METHOD = isEditMode ? 'PUT' : 'POST';
  const SUBMIT_LABEL = isEditMode ? '수정 완료' : '등록 제출하기';
  const BUSY_LABEL = isEditMode ? '수정 중...' : '제출 중...';
  const step1 = document.getElementById('step-1');
  const step2 = document.getElementById('step-2');
  const errBox = document.getElementById('error-msg');
  const descCount = document.getElementById('desc-count');

  function showError(msg) {
    errBox.textContent = msg;
    errBox.classList.remove('hidden');
  }
  function hideError() {
    errBox.classList.add('hidden');
  }

  document.getElementById('f-description').addEventListener('input', (e) => {
    const n = e.target.value.length;
    descCount.textContent = n;
    const btn = document.getElementById('btn-submit');
    if (n > 200) {
      descCount.classList.add('text-red-600', 'font-bold');
      if (btn) btn.disabled = true;
    } else {
      descCount.classList.remove('text-red-600', 'font-bold');
      if (btn) btn.disabled = false;
    }
  });

  // 기타 선택 시 희망 카테고리 토글 (D-04)
  document.getElementById('f-category').addEventListener('change', (e) => {
    const wrap = document.getElementById('category-custom-wrap');
    if (e.target.value === '기타') {
      wrap.classList.remove('hidden');
    } else {
      wrap.classList.add('hidden');
    }
  });

  // 카페 바로가기 href를 상수로 통일 (D-05)
  document.getElementById('cafe-link')?.setAttribute('href', CAFE_URL);

  // 연관작업 최대 5개 제한
  document.querySelectorAll('.task-check').forEach((cb) => {
    cb.addEventListener('change', () => {
      const checked = document.querySelectorAll('.task-check:checked');
      if (checked.length > 5) {
        cb.checked = false;
        showError('연관작업은 최대 5개까지 선택할 수 있습니다.');
      } else {
        hideError();
      }
    });
  });

  // 스크린샷 파일 업로드 (3-B-2: click/drag-drop → POST /api/upload)
  const shotDrop = document.getElementById('screenshot-drop');
  const shotFile = document.getElementById('f-screenshot-file');
  const shotUrl = document.getElementById('f-screenshot-url');
  const shotPrompt = document.getElementById('screenshot-prompt');
  const shotUploading = document.getElementById('screenshot-uploading');
  const shotPreview = document.getElementById('screenshot-preview');
  const shotThumb = document.getElementById('screenshot-thumb');
  const shotMeta = document.getElementById('screenshot-meta');
  const shotError = document.getElementById('screenshot-error');
  const ALLOWED_MIMES = ['image/jpeg', 'image/png', 'image/webp', 'image/gif'];
  const MAX_BYTES = 2 * 1024 * 1024;

  function showShotError(msg) {
    shotError.textContent = msg;
    shotError.classList.remove('hidden');
    shotDrop.classList.add('border-red-500');
  }
  function hideShotError() {
    shotError.classList.add('hidden');
    shotDrop.classList.remove('border-red-500');
  }
  function formatSize(n) {
    if (n < 1024) return n + ' B';
    if (n < 1024 * 1024) return (n / 1024).toFixed(1) + ' KB';
    return (n / 1024 / 1024).toFixed(2) + ' MB';
  }
  function showShotPreview(url, name, size) {
    shotThumb.src = url;
    shotMeta.textContent = name + (size != null ? ' · ' + formatSize(size) : '');
    shotPrompt.classList.add('hidden');
    shotUploading.classList.add('hidden');
    shotPreview.classList.remove('hidden');
  }
  function clearShotPreview() {
    shotUrl.value = '';
    shotFile.value = '';
    shotThumb.removeAttribute('src');
    shotMeta.textContent = '';
    shotPreview.classList.add('hidden');
    shotUploading.classList.add('hidden');
    shotPrompt.classList.remove('hidden');
  }
  function validateShotFile(file) {
    if (!ALLOWED_MIMES.includes(file.type)) {
      return '이미지 파일만 업로드할 수 있습니다. (JPG, PNG, WebP)';
    }
    if (file.size > MAX_BYTES) {
      return '파일 크기는 2MB 이하만 가능합니다.';
    }
    return null;
  }
  async function uploadShotFile(file) {
    hideShotError();
    const err = validateShotFile(file);
    if (err) {
      showShotError(err);
      return;
    }
    shotPrompt.classList.add('hidden');
    shotPreview.classList.add('hidden');
    shotUploading.classList.remove('hidden');
    try {
      const fd = new FormData();
      fd.append('file', file);
      const res = await fetch('/api/upload', { method: 'POST', body: fd });
      const data = await res.json().catch(() => ({}));
      if (res.status === 401) {
        shotUploading.classList.add('hidden');
        shotPrompt.classList.remove('hidden');
        showShotError('세션이 만료되었습니다. 새로고침 후 다시 시도해주세요.');
        return;
      }
      if (!res.ok || !data.url) {
        shotUploading.classList.add('hidden');
        shotPrompt.classList.remove('hidden');
        showShotError(data.error || '업로드 중 오류가 발생했습니다.');
        return;
      }
      shotUrl.value = data.url;
      showShotPreview(data.url, file.name, file.size);
    } catch {
      shotUploading.classList.add('hidden');
      shotPrompt.classList.remove('hidden');
      showShotError('네트워크 오류가 발생했습니다. 잠시 후 다시 시도해주세요.');
    }
  }

  // 수정 모드: 기존 screenshot_url 프리필
  if (shotUrl.value) {
    const parts = shotUrl.value.split('/');
    showShotPreview(shotUrl.value, parts[parts.length - 1] || 'screenshot', null);
  }

  shotDrop.addEventListener('click', (e) => {
    if (e.target.closest('#screenshot-remove')) return;
    shotFile.click();
  });
  shotFile.addEventListener('change', () => {
    if (shotFile.files && shotFile.files[0]) uploadShotFile(shotFile.files[0]);
  });
  ['dragenter', 'dragover'].forEach((ev) => {
    shotDrop.addEventListener(ev, (e) => {
      e.preventDefault();
      shotDrop.classList.add('border-blue-500', 'bg-blue-500/10');
    });
  });
  ['dragleave', 'drop'].forEach((ev) => {
    shotDrop.addEventListener(ev, (e) => {
      e.preventDefault();
      shotDrop.classList.remove('border-blue-500', 'bg-blue-500/10');
    });
  });
  shotDrop.addEventListener('drop', (e) => {
    const f = e.dataTransfer?.files?.[0];
    if (f) uploadShotFile(f);
  });
  document.getElementById('screenshot-remove').addEventListener('click', (e) => {
    e.stopPropagation();
    hideShotError();
    clearShotPreview();
  });

  function validateStep1() {
    const name = document.getElementById('f-name').value.trim();
    const url = document.getElementById('f-url').value.trim();
    const desc = document.getElementById('f-description').value.trim();
    if (!name || !url || !desc) {
      showError('이름, URL, 설명을 모두 입력해주세요.');
      return false;
    }
    if (desc.length > 200) {
      showError('설명은 200자 이내로 입력해주세요.');
      return false;
    }
    try {
      const parsed = new URL(url);
      if (parsed.protocol !== 'http:' && parsed.protocol !== 'https:') {
        showError('올바른 URL을 입력해주세요. (http:// 또는 https://)');
        return false;
      }
    } catch {
      showError('올바른 URL을 입력해주세요.');
      return false;
    }
    return true;
  }

  document.getElementById('btn-next').addEventListener('click', () => {
    hideError();
    if (!validateStep1()) return;
    step1.classList.add('hidden');
    step2.classList.remove('hidden');
    document.getElementById('step-dot-2').classList.remove('opacity-50');
    window.scrollTo(0, 0);
  });

  document.getElementById('btn-back').addEventListener('click', () => {
    hideError();
    step2.classList.add('hidden');
    step1.classList.remove('hidden');
    document.getElementById('step-dot-2').classList.add('opacity-50');
    window.scrollTo(0, 0);
  });

  // 카페 공유 문구 복사 (41-03 Task 1 — URL locked)
  document.getElementById('cafe-copy-btn')?.addEventListener('click', async () => {
    const text = document.getElementById('cafe-copy-btn')?.dataset.shareText || '';
    try {
      await navigator.clipboard.writeText(text);
      document.getElementById('copy-ok')?.classList.remove('hidden');
    } catch {
      showError('클립보드 복사에 실패했습니다. 직접 복사해주세요.');
    }
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideError();
    const btn = document.getElementById('btn-submit');
    btn.disabled = true;
    btn.textContent = BUSY_LABEL;

    const tagsRaw = document.getElementById('f-tags').value.trim();
    const priceModel = document.querySelector('input[name="price_model"]:checked')?.value || '';
    const priceDetail = document.getElementById('f-price-detail').value.trim();
    const catVal = document.getElementById('f-category').value;
    const catCustom = document.getElementById('f-category-custom').value.trim();
    const shotRaw = document.getElementById('f-screenshot-url').value.trim();
    const payload = {
      name: document.getElementById('f-name').value.trim(),
      url: document.getElementById('f-url').value.trim(),
      category: catVal,
      category_custom: catVal === '기타' ? (catCustom || null) : null,
      description: document.getElementById('f-description').value.trim(),
      price_model: priceModel,
      price_detail: priceDetail || null,
      screenshot_url: shotRaw || null,
      korean_support: document.getElementById('f-korean').checked,
      difficulty: document.getElementById('f-difficulty').value || null,
      use_cases: document.getElementById('f-usecases').value.trim() || null,
      tags: tagsRaw ? tagsRaw.split(',').map((t) => t.trim()).filter(Boolean) : [],
      tasks: [...document.querySelectorAll('.task-check:checked')].map((cb) => cb.value),
      detail_markdown: document.getElementById('f-detail').value.trim() || null,
    };

    try {
      const res = await fetch(SUBMIT_URL, {
        method: SUBMIT_METHOD,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json().catch(() => ({}));
      if (res.status === 401) {
        showError('로그인이 필요합니다.');
      } else if (!res.ok) {
        showError(data.error || '제출 중 오류가 발생했습니다.');
      } else if (isEditMode) {
        form.classList.add('hidden');
        document.getElementById('edit-done-state').classList.remove('hidden');
        window.scrollTo(0, 0);
      } else {
        const toolName = document.getElementById('f-name').value.trim();
        const toolUrl = document.getElementById('f-url').value.trim();
        const toolDesc = document.getElementById('f-description').value.trim();
        const toolCat = document.getElementById('f-category').value;
        const toolModel = document.querySelector('input[name="price_model"]:checked')?.value || '';
        const toolDetail = document.getElementById('f-price-detail').value.trim();
        const toolPrice = toolDetail || toolModel || '—';
        form.classList.add('hidden');
        document.getElementById('done-state').classList.remove('hidden');
        document.getElementById('done-slug').textContent = data.slug;
        document.getElementById('done-link').href = '/tools/' + data.slug + '/';
        document.getElementById('preview-name').textContent = toolName;
        document.getElementById('preview-desc').textContent = toolDesc;
        document.getElementById('preview-cat').textContent = toolCat;
        document.getElementById('preview-price').textContent = toolPrice || '—';
        document.getElementById('cafe-copy-btn').dataset.shareText =
          `[${toolName}] ${toolUrl}\n${toolDesc}\n${CAFE_URL} 에서 더 많은 AI 활용법을 확인하세요`;
        window.scrollTo(0, 0);
      }
    } catch {
      showError('네트워크 오류가 발생했습니다. 잠시 후 다시 시도해주세요.');
    } finally {
      btn.disabled = false;
      btn.textContent = SUBMIT_LABEL;
    }
  });
</script>
