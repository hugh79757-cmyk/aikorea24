---
import '../styles/global.css';
import SEOHead from '../components/SEOHead.astro';
import { verifySession } from '../lib/auth';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedDate?: string;
  modifiedDate?: string;
  tags?: string[];
  category?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'AI 도구, 강좌, 지원사업, 뉴스를 한국어로 큐레이션합니다. AI, 누구나 쓸 수 있습니다.',
  image,
  type = 'website',
  publishedDate,
  modifiedDate,
  tags = [],
  category = '',
  noindex = false,
} = Astro.props;

let currentUser = null;
const session = Astro.cookies.get('session')?.value;
if (session) currentUser = await verifySession(session, Astro.locals.sessionSecret);

const navItems = [
  // '홈' 제거 (2026-10-10, AIK24-PIPE-02): 로고가 이미 / 로 연결됨
  { label: '블로그', href: '/blog' },
  { label: 'AI 도구', href: '/tools' },
  { label: '용어사전', href: '/glossary' },
  { label: '타임라인', href: '/chronicle' },
  { label: '뉴스', href: '/news' },
  { label: '구독', href: '/subscribe' },
  { label: '문의', href: '/contact' },
];

const currentPath = Astro.url.pathname;
---
<!DOCTYPE html>
<html lang="ko" class="scroll-smooth">
<head>
  <script is:inline>
    // 시안 A: 라이트 모드 고정 (다크모드 비활성화)
    document.documentElement.classList.remove('dark');
    localStorage.setItem('theme', 'light');
  </script>
  <SEOHead
    title={title}
    description={description}
    image={image}
    type={type}
    publishedDate={publishedDate}
    modifiedDate={modifiedDate}
    tags={tags}
    category={category}
    noindex={noindex}
  />
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5938862195544185"
     crossorigin="anonymous"></script>
  <meta name="p:domain_verify" content="a2f1f9d5f2c18d423c1d99f6c2d0247b"/>
  <meta name="facebook-domain-verification" content="78ii97o27tz0jckp14cjh76vh4om2e" />
  <style is:global>
    :root { --font-sans: 'Pretendard Variable', Pretendard, -apple-system, BlinkMacSystemFont, system-ui, Roboto, sans-serif; }
    body { font-family: var(--font-sans); }
  </style>
</head>
<body class="min-h-screen flex flex-col" data-ssr-user={currentUser ? "1" : undefined}>

  <header class="sticky top-0 z-50 bg-white/85 dark:bg-[#0A0E1A]/80 backdrop-blur-md border-b border-gray-200 dark:border-white/[0.06]">
    <nav class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center">
        <img src="/logo-final.webp" alt="AI KOREA 24" class="h-8 w-auto" />
      </a>
      <div class="hidden md:flex items-center gap-8">
        {navItems.map(item => (
          <a
            href={item.href}
            class:list={[
              'text-sm font-medium transition-colors hover:text-[#E63B2E]',
              currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href))
                ? 'text-[#E63B2E]' : 'text-gray-600 dark:text-gray-400'
            ]}
          >
            {item.label}
          </a>
        ))}
      </div>
      <div class="hidden md:flex items-center ml-4">
        {currentUser ? (
          <div class="flex items-center gap-3">
            {currentUser.avatar ? (
              <div class="relative w-7 h-7">
                <div class="w-7 h-7 rounded-full bg-gray-200 dark:bg-gray-600 flex items-center justify-center text-xs font-medium text-gray-600 dark:text-gray-300">
                  {currentUser.name.charAt(0).toUpperCase()}
                </div>
                <img
                  src={currentUser.avatar}
                  alt=""
                  class="absolute inset-0 w-7 h-7 rounded-full overflow-hidden"
                  onerror="this.remove()"
                />
              </div>
            ) : (
              <div class="w-7 h-7 rounded-full bg-gray-200 dark:bg-gray-600 flex items-center justify-center text-xs font-medium text-gray-600 dark:text-gray-300">
                {currentUser.name.charAt(0).toUpperCase()}
              </div>
            )}
            <a href="/my/tools/" class="text-xs font-medium text-[#E63B2E] hover:underline">내 도구</a>
            <a href="/api/auth/logout" class="text-xs text-gray-500 dark:text-gray-500 hover:text-red-500 dark:hover:text-red-400">로그아웃</a>
          </div>
        ) : (
          <a href="/api/auth/login" class="js-login-btn text-sm font-medium bg-gray-100 dark:bg-white/[0.1] border border-gray-300 dark:border-white/[0.15] px-4 py-2 rounded-lg hover:bg-gray-200 dark:hover:bg-white/[0.2] text-gray-700 dark:text-gray-200 transition-all">로그인</a>
        )}
        <!-- 정적 프리렌더 페이지용 로그인 상태 박스 (아래 인라인 스크립트가 채움) -->
        <div class="js-user-box hidden items-center gap-3">
          <div class="w-7 h-7 rounded-full bg-gray-200 dark:bg-gray-600 flex items-center justify-center text-xs font-medium text-gray-600 dark:text-gray-300"><span class="js-user-initial"></span></div>
          <a href="/my/tools/" class="text-xs font-medium text-[#E63B2E] hover:underline">내 도구</a>
          <a href="/api/auth/logout" class="text-xs text-gray-500 dark:text-gray-500 hover:text-red-500 dark:hover:text-red-400">로그아웃</a>
        </div>
      </div>

      <button id="search-btn" class="p-2 rounded-lg text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-white/10 transition-colors" aria-label="검색">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      </button>

      <button id="mobile-menu-btn" class="md:hidden p-2 text-gray-700 dark:text-gray-200" aria-label="메뉴 열기">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </nav>
    <div id="mobile-menu" class="hidden md:hidden border-t border-gray-200 dark:border-white/[0.06] bg-white/95 dark:bg-[#0A0E1A]/95 backdrop-blur-md">
      {navItems.map(item => (
        <a href={item.href} class="block px-4 py-3 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-white/[0.05] border-b border-gray-100 dark:border-white/[0.06]">
          {item.label}
        </a>
      ))}
      <div class="px-4 py-3 border-t border-gray-200 dark:border-white/[0.06]">
        {currentUser ? (
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              {currentUser.avatar ? (
                <div class="relative w-7 h-7">
                  <div class="w-7 h-7 rounded-full bg-gray-200 dark:bg-gray-600 flex items-center justify-center text-xs font-medium text-gray-600 dark:text-gray-300">
                    {currentUser.name.charAt(0).toUpperCase()}
                  </div>
                  <img
                    src={currentUser.avatar}
                    alt=""
                    class="absolute inset-0 w-7 h-7 rounded-full overflow-hidden"
                    onerror="this.remove()"
                  />
                </div>
              ) : (
                <div class="w-7 h-7 rounded-full bg-gray-200 dark:bg-gray-600 flex items-center justify-center text-xs font-medium text-gray-600 dark:text-gray-300">
                  {currentUser.name.charAt(0).toUpperCase()}
                </div>
              )}
            </div>
            <div class="flex items-center gap-3">
              <a href="/my/tools/" class="text-xs font-medium text-[#E63B2E]">내 도구</a>
              <a href="/api/auth/logout" class="text-xs text-red-400 hover:text-red-300">로그아웃</a>
            </div>
          </div>
        ) : (
          <a href="/api/auth/login" class="js-login-btn block text-center text-sm font-medium bg-[#111111] hover:bg-[#333333] text-white px-4 py-2.5 rounded-lg transition-all">
            Google로 로그인
          </a>
        )}
        <div class="js-user-box hidden items-center justify-center gap-3 py-1">
          <span class="js-user-initial w-7 h-7 rounded-full bg-gray-200 dark:bg-gray-600 flex items-center justify-center text-xs font-medium text-gray-600 dark:text-gray-300"></span>
          <a href="/my/tools/" class="text-xs font-medium text-[#E63B2E]">내 도구</a>
          <a href="/api/auth/logout" class="text-xs text-red-400 hover:text-red-300">로그아웃</a>
        </div>
      </div>
    </div>
  </header>

  <!-- 검색 모달 -->
  <div id="search-modal" class="hidden fixed inset-0 z-[60] bg-black/50 backdrop-blur-sm">
    <div class="max-w-xl mx-auto mt-20 px-4 bg-white dark:bg-[#111827] rounded-2xl shadow-2xl border border-gray-200 dark:border-white/10 overflow-hidden">
      <div class="flex items-center gap-3 px-4 py-3 border-b border-gray-200 dark:border-white/10">
        <svg class="w-5 h-5 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        <input id="search-input" type="text" placeholder="블로그 검색... (제목, 설명, 태그)" class="flex-1 bg-transparent text-gray-900 dark:text-gray-100 placeholder-gray-400 outline-none text-base" autocomplete="off" />
        <kbd class="hidden sm:inline text-xs text-gray-400 border border-gray-300 dark:border-gray-600 rounded px-1.5 py-0.5">ESC</kbd>
      </div>
      <div id="search-results" class="max-h-[60vh] overflow-y-auto p-2">
        <p class="text-sm text-gray-400 text-center py-8">검색어를 입력하세요</p>
      </div>
    </div>
  </div>

  <main class="flex-1">
    <!-- 콘텐츠 상단 광고 -->
    <div style="text-align:center;margin:16px auto;max-width:728px;width:100%;overflow:hidden;">
      <ins class="adsbygoogle"
           style="display:block;width:100%;"
           data-ad-client="ca-pub-5938862195544185"
           data-ad-slot="3350911709"
           data-ad-format="auto"
           data-full-width-responsive="true"></ins>
      <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
    </div>
    <slot />
    <!-- 콘텐츠 하단 광고 -->
    <div style="text-align:center;margin:16px auto;max-width:728px;width:100%;overflow:hidden;">
      <ins class="adsbygoogle"
           style="display:block;width:100%;"
           data-ad-client="ca-pub-5938862195544185"
           data-ad-slot="3350911709"
           data-ad-format="auto"
           data-full-width-responsive="true"></ins>
      <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
    </div>
  </main>

  <footer class="bg-gray-100 dark:bg-gray-900 text-gray-500 dark:text-gray-400 mt-auto transition-colors">
    <div class="max-w-6xl mx-auto px-4 py-6">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-4">
        <div>
          <h3 class="text-gray-900 dark:text-white font-bold text-lg mb-3">AI코리아24</h3>
          <p class="text-sm leading-relaxed">AI, 누구나 쓸 수 있습니다.<br/>AI 도구, 강좌, 지원사업, 뉴스를 한국어로 큐레이션합니다.</p>
        </div>
        <div>
          <h3 class="text-gray-900 dark:text-white font-semibold mb-3">바로가기</h3>
          <ul class="space-y-2 text-sm">
            <li><a href="/blog" class="hover:text-gray-900 dark:hover:text-white transition-colors">블로그</a></li>
            <li><a href="/tools" class="hover:text-gray-900 dark:hover:text-white transition-colors">AI 도구</a></li>
            <li><a href="/glossary" class="hover:text-gray-900 dark:hover:text-white transition-colors">AI 용어사전</a></li>
            <li><a href="/chronicle" class="hover:text-gray-900 dark:hover:text-white transition-colors">AI 타임라인</a></li>
            <li><a href="/tools/finder/" class="hover:text-gray-900 dark:hover:text-white transition-colors">도구 추천 퀴즈</a></li>
            <li><a href="/contact" class="hover:text-gray-900 dark:hover:text-white transition-colors">문의</a></li>
          </ul>
        </div>
        <div>
          <h3 class="text-gray-900 dark:text-white font-semibold mb-3">법적 고지</h3>
          <ul class="space-y-2 text-sm">
            <li><a href="/privacy" class="hover:text-gray-900 dark:hover:text-white transition-colors">개인정보처리방침</a></li>
            <li><a href="/terms" class="hover:text-gray-900 dark:hover:text-white transition-colors">이용약관</a></li>
          </ul>
        </div>
        <div>
          <h3 class="text-gray-900 dark:text-white font-semibold mb-3">서브 프로젝트</h3>
          <ul class="space-y-2 text-sm">
            <li><a href="https://heritage.aikorea24.kr" target="_blank" class="hover:text-gray-900 dark:hover:text-white transition-colors">AI 문화유산 가이드 프로젝트</a></li>
            <li><a href="https://cert.aikorea24.kr" target="_blank" class="hover:text-gray-900 dark:hover:text-white transition-colors">자격증 소개 프로젝트</a></li>
            <li><a href="https://keyword.aikorea24.kr" target="_blank" class="hover:text-gray-900 dark:hover:text-white transition-colors">뉴스 키워드 인사이트 Pro</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-gray-300 dark:border-gray-800 pt-4 text-xs leading-relaxed">
        <p>스타일팩토리9 (Style Factory 9) | 대표: 조진연 | 사업자등록번호: 672-43-00632 | 통신판매업 신고번호: 제 2026-의정부흥선-0694호 | 호스팅 제공자: Cloudflare, Inc.</p>
        <p>경기도 의정부시 호암로 256, 107-1804 (우 11638) | info@aikorea24.kr | 전화(Tel): +82 10-7416-5705</p>
        <p class="mt-2">본 사이트에서 제공하는 정보는 참고용이며, 정확한 내용은 해당 기관에서 확인하시기 바랍니다.</p>
        <p class="mt-1">&copy; 2026 AI코리아24. All rights reserved. <a href="/network/" class="text-gray-400 dark:text-gray-600 hover:text-gray-500 dark:hover:text-gray-500 transition-colors">네트워크</a></p>
      </div>
    </div>
  </footer>

  <script>
    // 모바일 메뉴
    document.getElementById('mobile-menu-btn')?.addEventListener('click', () => {
      document.getElementById('mobile-menu')?.classList.toggle('hidden');
    });

    // 테마 토글: 시안 A는 라이트 전용 — 토글 UI·핸들러 제거됨(2026-10-10, AIK24-RENEWAL-01)
    // head 인라인 스크립트가 `dark` 클래스를 제거하므로 마크업의 `dark:` 변수는 활성화되지 않는다.

    // 검색 기능
    let searchData = null;

    async function loadSearchData() {
      if (searchData) return searchData;
      const res = await fetch('/api/search/');
      searchData = await res.json();
      return searchData;
    }

    function openSearch() {
      document.getElementById('search-modal')?.classList.remove('hidden');
      document.getElementById('search-input')?.focus();
      document.body.style.overflow = 'hidden';
      loadSearchData();
    }

    function closeSearch() {
      document.getElementById('search-modal')?.classList.add('hidden');
      document.body.style.overflow = '';
      const input = document.getElementById('search-input');
      if (input) input.value = '';
      const results = document.getElementById('search-results');
      if (results) results.innerHTML = '<p class="text-sm text-gray-400 text-center py-8">검색어를 입력하세요</p>';
    }

    document.getElementById('search-btn')?.addEventListener('click', openSearch);

    document.getElementById('search-modal')?.addEventListener('click', (e) => {
      if (e.target === e.currentTarget) closeSearch();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeSearch();
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        const modal = document.getElementById('search-modal');
        if (modal?.classList.contains('hidden')) openSearch();
        else closeSearch();
      }
    });

    document.getElementById('search-input')?.addEventListener('input', async (e) => {
      const query = (e.target as HTMLInputElement).value.trim().toLowerCase();
      const results = document.getElementById('search-results');
      if (!results) return;

      if (!query) {
        results.innerHTML = '<p class="text-sm text-gray-400 text-center py-8">검색어를 입력하세요</p>';
        return;
      }

      const data = await loadSearchData();
      const filtered = data.filter((post: any) =>
        post.title.toLowerCase().includes(query) ||
        post.description.toLowerCase().includes(query) ||
        post.tags.some((t: string) => t.toLowerCase().includes(query)) ||
        post.category.toLowerCase().includes(query)
      );

      if (filtered.length === 0) {
        results.innerHTML = '<p class="text-sm text-gray-400 text-center py-8">검색 결과가 없습니다</p>';
        return;
      }

      results.innerHTML = filtered.slice(0, 10).map((post: any) => `
        <a href="/blog/${post.slug}/" class="block px-3 py-3 rounded-lg hover:bg-gray-100 dark:hover:bg-white/[0.05] transition-colors">
          <div class="flex items-center gap-2 mb-1">
            <span class="text-xs px-2 py-0.5 rounded-full bg-[#f7f7f7] text-[#555555]">${post.category}</span>
          </div>
          <p class="text-sm font-medium text-gray-900 dark:text-gray-100">${post.title}</p>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-1 line-clamp-1">${post.description}</p>
        </a>
      `).join('');
    });
  </script>

  <div id="share-copy-wrap" style="position:fixed;bottom:24px;right:16px;z-index:9999;max-width:calc(100vw - 32px);">
    <button id="copy-link-btn" onclick="navigator.clipboard.writeText(window.location.href).then(function(){var t=document.getElementById('copy-toast');t.style.opacity='1';setTimeout(function(){t.style.opacity='0';},2000);})" style="display:flex;align-items:center;gap:6px;padding:12px 20px;background:#1f2937;color:#fff;border:none;border-radius:999px;font-size:14px;font-weight:500;cursor:pointer;box-shadow:0 4px 14px rgba(0,0,0,0.3);transition:all 0.2s;-webkit-tap-highlight-color:transparent;">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
      공유하기
    </button>
  </div>
  <div id="copy-toast" style="position:fixed;bottom:80px;right:16px;z-index:10000;padding:10px 20px;background:#10b981;color:#fff;border-radius:8px;font-size:14px;opacity:0;transition:opacity 0.3s;pointer-events:none;">링크가 복사되었습니다!</div>

  <script is:inline>
    // 정적 프리렌더 페이지는 빌드 시점에 쿠키가 없어 Layout의 세션 판정이 항상 로그아웃으로 끝난다.
    // → 로그인 여부를 클라이언트에서 확인해 헤더를 갱신한다 (user 데이터는 textContent로만 주입).
    (async () => {
      // SSR에서 이미 로그인 상태로 렌더된 페이지면 손대지 않는다 (2026-10-10, AIK24-PIPE-02)
      // → 이 가드가 없으면 SSR 박스와 js-user-box 가 동시에 보여 '내 도구·로그아웃'이 2개씩 렌더됨
      if (document.body.dataset.ssrUser) return;
      if (!document.querySelector('.js-user-box')) return;
      const res = await fetch('/api/auth/me').catch(() => null);
      if (!res || !res.ok) return;
      const me = await res.json();
      if (!me.loggedIn) return;
      const name = me.name || (me.email || '').split('@')[0] || '회원';
      document.querySelectorAll('.js-login-btn').forEach((el) => el.classList.add('hidden'));
      document.querySelectorAll('.js-user-initial').forEach((el) => (el.textContent = name.charAt(0).toUpperCase()));
      document.querySelectorAll('.js-user-box').forEach((el) => el.classList.remove('hidden'));
      document.querySelectorAll('.js-user-box').forEach((el) => el.classList.add('flex'));
    })();
  </script>

</body>
</html>
