#!/usr/bin/env python3
"""
aikorea24 블로그 주제 선정기 v2.0
전략: 오늘 뉴스 이슈 → 경쟁 공백 키워드 선점
- 검색량 기준 X → 블로그 경쟁 수 기준 O
- 대형 키워드 X → 뉴스 기반 구체적 롱테일 O
- 브랜드명 X → 브랜드명 + 행동의도 조합 O
"""
import os, sys, json, subprocess, time, hmac, hashlib, base64, re
import concurrent.futures
from datetime import datetime, timedelta
from urllib.parse import quote

PROJECT_DIR = '/Users/twinssn/Projects/aikorea24'

def load_env(path):
    if os.path.exists(path):
        with open(path) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith('#') and '=' in line:
                    if line.startswith('export '):
                        line = line[7:]
                    k, v = line.split('=', 1)
                    os.environ[k.strip()] = v.strip().strip('"').strip("'")

load_env(os.path.join(PROJECT_DIR, '.env'))
load_env(os.path.join(PROJECT_DIR, 'api_test', '.env.sh'))

OPENAI_KEY      = os.environ.get('OPENAI_API_KEY', '')
NAVER_ID        = os.environ.get('NAVER_CLIENT_ID', '')
NAVER_SECRET    = os.environ.get('NAVER_CLIENT_SECRET', '')
NAVER_AD_CID    = os.environ.get('NAVER_AD_CUSTOMER_ID', '')
NAVER_AD_KEY    = os.environ.get('NAVER_AD_CLIENT_ID', '')
NAVER_AD_SECRET = os.environ.get('NAVER_AD_CLIENT_SECRET', '')


# ============================================
# 1. 뉴스 DB에서 최근 24시간 기사 수집
# ============================================
def fetch_recent_news(hours=24):
    print(f"\n[1단계] 최근 {hours}시간 기사 수집...")
    try:
        r = subprocess.run(
            ['npx', 'wrangler', 'd1', 'execute', 'aikorea24-db', '--remote', '--yes',
             '--command',
             f"SELECT title, source, category, description FROM news "
             f"WHERE created_at >= datetime('now', '-{hours} hours') "
             f"ORDER BY created_at DESC;",
             '--json'],
            capture_output=True, text=True, cwd=PROJECT_DIR, timeout=120)
        if r.returncode == 0:
            data = json.loads(r.stdout)
            if isinstance(data, list) and data:
                results = data[0].get('results', [])
                print(f"  수집: {len(results)}건")
                return results
    except Exception as e:
        print(f"  실패: {e}")
    return []


# ============================================
# 2. 뉴스 고유명사 추출 → 네이버 API 연관키워드 2홉 확장
# ============================================
# AI 브랜드/모델 화이트리스트 (네이버 검색량이 실제 있는 것만)
AI_BRAND_WHITELIST = [
    # LLM 모델
    "챗GPT", "ChatGPT", "클로드", "Claude", "제미나이", "Gemini",
    "퍼플렉시티", "Perplexity", "그록", "Grok", "미스트랄", "Mistral",
    "라마", "Llama", "딥시크", "DeepSeek", "코덱스", "Codex",
    "젬마", "Gemma", "코파일럿", "Copilot", "윈드서프", "Windsurf",
    "커서AI", "볼트", "Bolt", "리플릿", "Replit",
    # AI 기업
    "오픈AI", "OpenAI", "앤트로픽", "Anthropic", "구글AI", "메타AI",
    "허깅페이스", "HuggingFace", "그로크", "Groq", "세레브라스", "Cerebras",
    # AI 기능/카테고리 (검색량 있는 것)
    "AI이미지생성", "AI작곡", "AI번역", "AI코딩", "AI그림",
    "AI영상", "AI챗봇", "AI글쓰기", "AI요약", "AI음성",
    "GGML", "llama.cpp", "Unsloth", "VLA", "RAG",
]

def extract_seed_keywords(articles):
    """뉴스 제목에서 AI 브랜드/모델명 매칭 + GPT 보조 추출"""
    import re
    titles = " ".join([a.get('title', '') for a in articles])

    # 1. 화이트리스트 매칭 (확실한 씨앗)
    found = []
    for brand in AI_BRAND_WHITELIST:
        pattern = re.compile(re.escape(brand), re.IGNORECASE)
        if pattern.search(titles):
            found.append(brand)

    print(f"  화이트리스트 매칭: {len(found)}개")

    # 2. GPT로 화이트리스트에 없는 신규 AI 제품명만 보조 추출
    if OPENAI_KEY and articles:
        try:
            from openai import OpenAI
            client = OpenAI(api_key=OPENAI_KEY)
            sample_titles = [a['title'] for a in articles[:80] if a.get('title')]
            headlines_text = "\n".join([f"- {t}" for t in sample_titles])

            prompt = f"""다음 뉴스에서 **새로운 AI 제품명·모델명·서비스명**만 추출하세요.

{headlines_text}

조건:
- 반드시 구체적인 제품/모델/서비스 고유명사만 (예: GPT-5o, Claude4, Gemini3.5Flash)
- 이미 알려진 것 제외: ChatGPT, Claude, 제미나이, Llama, DeepSeek, Codex, Gemma
- 일반명사 절대 금지: AI기술, AI드론, AI전력, 클라우드, 미세조정 등
- 띄어쓰기 없이 붙여쓰기
- 없으면 빈 응답
- 최대 10개, 쉼표 구분

응답:"""
            resp = client.chat.completions.create(
                model="gpt-4o-mini",
                messages=[{"role": "user", "content": prompt}],
                max_completion_tokens=200)
            extras = [kw.strip() for kw in resp.choices[0].message.content.split(",")
                      if 2 <= len(kw.strip()) <= 20 and kw.strip()]
            # 일반명사 블랙리스트 필터
            BLACKLIST = ["AI기술", "AI드론", "AI전력", "클라우드", "미세조정",
                         "AI생태계", "AI홍보", "AI추론", "AI안전", "AI모델"]
            extras = [kw for kw in extras
                      if not any(bl in kw for bl in BLACKLIST)]
            if extras:
                print(f"  GPT 추가 발굴: {extras}")
                found.extend(extras)
        except Exception as e:
            print(f"  GPT 보조 실패: {e}")

    found = list(dict.fromkeys(found))  # 중복 제거
    print(f"  씨앗 고유명사: {len(found)}개")
    return found


def expand_keywords_via_api(seeds):
    """네이버 광고 API로 씨앗 → 연관키워드 2홉 확장"""
    if not all([NAVER_AD_CID, NAVER_AD_KEY, NAVER_AD_SECRET]):
        return seeds, {}

    import requests
    uri = "/keywordstool"
    all_keywords = {}

    def query_api(batch):
        cleaned = [kw.replace(" ", "") for kw in batch if kw.strip()]
        if not cleaned:
            return {}
        timestamp = str(int(time.time() * 1000))
        sig = generate_signature(timestamp, "GET", uri, NAVER_AD_SECRET)
        headers = {
            "X-Timestamp": timestamp, "X-API-KEY": NAVER_AD_KEY,
            "X-Customer": NAVER_AD_CID, "X-Signature": sig,
            "Content-Type": "application/json; charset=UTF-8"
        }
        result = {}
        try:
            url = f"https://api.naver.com{uri}?hintKeywords={quote(','.join(cleaned), safe='')}&showDetail=1"
            resp = requests.get(url, headers=headers, timeout=10)
            if resp.status_code == 200:
                for item in resp.json().get("keywordList", []):
                    kw   = item.get("relKeyword", "")
                    pc   = item.get("monthlyPcQcCnt", 0)
                    mo   = item.get("monthlyMobileQcCnt", 0)
                    comp = item.get("compIdx", "")
                    pc   = 5 if pc == "< 10" else int(pc or 0)
                    mo   = 5 if mo == "< 10" else int(mo or 0)
                    vol  = pc + mo
                    if kw and vol >= 100:
                        # (검색량, 경쟁도) 튜플로 저장
                        result[kw] = (vol, comp)
            time.sleep(0.15)
        except Exception as e:
            print(f"    API 에러: {e}")
        return result

    # 1홉: 씨앗 키워드
    print(f"  1홉 확장 ({len(seeds)}개 씨앗)...")
    for i in range(0, len(seeds), 5):
        batch_result = query_api(seeds[i:i+5])
        all_keywords.update(batch_result)
    print(f"    → {len(all_keywords)}개 연관키워드 발견")

    # 2홉: 1홉 결과 중 검색량 상위 30개로 재확장
    if all_keywords:
        top30 = sorted(all_keywords.keys(),
                       key=lambda k: all_keywords[k], reverse=True)[:30]
        print(f"  2홉 확장 (상위 30개)...")
        hop2 = {}
        for i in range(0, len(top30), 5):
            batch_result = query_api(top30[i:i+5])
            hop2.update(batch_result)
        # 병합 (검색량 높은 것 유지)
        for kw, data in hop2.items():
            vol = data[0] if isinstance(data, tuple) else data
            cur = all_keywords.get(kw)
            cur_vol = cur[0] if isinstance(cur, tuple) else (cur or 0)
            if cur is None or cur_vol < vol:
                all_keywords[kw] = data
        print(f"    → 총 {len(all_keywords)}개 (2홉 후)")

    # volumes: {kw: 검색량}, comp_map: {kw: 경쟁도}
    volumes  = {}
    comp_map = {}
    for kw, data in all_keywords.items():
        if isinstance(data, tuple):
            volumes[kw]  = data[0]
            comp_map[kw] = data[1]
        else:
            volumes[kw]  = data
            comp_map[kw] = ""
    # comp_map을 모듈 속성으로 저장
    expand_keywords_via_api._comp_map = comp_map
    return list(volumes.keys()), volumes


def extract_longtail_keywords(articles):
    print(f"\n[2단계] 뉴스 고유명사 추출 → 네이버 연관키워드 2홉 확장...")
    seeds = extract_seed_keywords(articles)
    if not seeds:
        seeds = ["ChatGPT", "Claude", "제미나이", "AI코딩", "커서AI"]
        print(f"  기본 씨앗 사용: {seeds}")
    keywords, volumes = expand_keywords_via_api(seeds)
    # volumes를 전역으로 전달하기 위해 모듈 속성으로 저장
    extract_longtail_keywords._volumes = volumes
    print(f"  최종 후보: {len(keywords)}개 키워드")
    return keywords


# ============================================
# 3. 네이버 광고 API - 검색량 조회
# ============================================
def generate_signature(timestamp, method, path, secret_key):
    message = f"{timestamp}.{method}.{path}"
    sig = hmac.new(secret_key.encode('utf-8'), message.encode('utf-8'), hashlib.sha256).digest()
    return base64.b64encode(sig).decode('utf-8')


def get_search_volume(keywords):
    print(f"\n[3단계] 검색량 조회 ({len(keywords)}개)...")
    if not all([NAVER_AD_CID, NAVER_AD_KEY, NAVER_AD_SECRET]):
        print("  네이버 광고 API 키 없음")
        return {}

    import requests
    results = {}
    uri = "/keywordstool"

    for i in range(0, len(keywords), 5):
        batch = [kw.strip().replace(" ", "") for kw in keywords[i:i+5] if kw.strip()]
        if not batch:
            continue
        timestamp = str(int(time.time() * 1000))
        sig = generate_signature(timestamp, "GET", uri, NAVER_AD_SECRET)
        headers = {
            "X-Timestamp": timestamp, "X-API-KEY": NAVER_AD_KEY,
            "X-Customer": NAVER_AD_CID, "X-Signature": sig,
            "Content-Type": "application/json; charset=UTF-8"
        }
        try:
            url = f"https://api.naver.com{uri}?hintKeywords={quote(','.join(batch), safe='')}&showDetail=1"
            resp = requests.get(url, headers=headers, timeout=10)
            if resp.status_code == 200:
                for item in resp.json().get("keywordList", []):
                    kw = item.get("relKeyword", "").replace(" ", "")
                    pc  = item.get("monthlyPcQcCnt", 0)
                    mo  = item.get("monthlyMobileQcCnt", 0)
                    pc  = 5 if pc == "< 10" else int(pc or 0)
                    mo  = 5 if mo == "< 10" else int(mo or 0)
                    if kw:
                        results[kw] = pc + mo
            time.sleep(0.1)
        except Exception as e:
            print(f"  배치 에러: {e}")

    print(f"  조회 완료: {len(results)}개")
    return results


# ============================================
# 4. 네이버 블로그 경쟁 수 조회 (핵심 지표)
# ============================================
def get_blog_count(keyword):
    if not all([NAVER_ID, NAVER_SECRET]):
        return 0
    import requests
    try:
        resp = requests.get(
            "https://openapi.naver.com/v1/search/blog.json",
            headers={"X-Naver-Client-Id": NAVER_ID, "X-Naver-Client-Secret": NAVER_SECRET},
            params={"query": keyword, "display": 1}, timeout=5)
        if resp.status_code == 200:
            return resp.json().get("total", 0)
    except:
        pass
    return 0


def get_blog_counts_batch(keywords):
    print(f"  블로그 경쟁 수 조회 중 ({len(keywords)}개)...")
    results = {}
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as ex:
        future_map = {ex.submit(get_blog_count, kw): kw for kw in keywords}
        for future in concurrent.futures.as_completed(future_map):
            kw = future_map[future]
            try:
                results[kw] = future.result()
            except:
                results[kw] = 0
    return results


# ============================================
# 5. 관련 뉴스 매칭
# ============================================
def find_related_news(keyword, articles, max_count=3):
    parts = re.findall(r'[가-힣]{2,}|[a-zA-Z0-9]{2,}', keyword)
    related = []
    for a in articles:
        title = a.get('title', '')
        match = sum(1 for p in parts if p.lower() in title.lower())
        if match >= 2:
            related.append((match, a['title']))
    related.sort(reverse=True)
    return [t for _, t in related[:max_count]]


# ============================================
# 6. 황금 주제 선별 - 경쟁 공백 기준
# ============================================

# AI 관련 키워드 통과 필터
AI_INCLUDE_PATTERNS = [
    "AI", "ai", "챗GPT", "ChatGPT", "클로드", "Claude", "제미나이", "Gemini",
    "퍼플렉시티", "Perplexity", "그록", "Grok", "딥시크", "DeepSeek",
    "라마", "Llama", "GPT", "gpt", "LLM", "llm", "코파일럿", "Copilot",
    "커서AI", "윈드서프", "Windsurf", "오픈AI", "OpenAI", "앤트로픽", "Anthropic",
    "허깅페이스", "HuggingFace", "미스트랄", "Mistral", "젬마", "Gemma",
    "코덱스", "Codex", "GGML", "llama.cpp", "Unsloth", "RAG", "VLA",
    "인공지능", "머신러닝", "딥러닝", "자연어처리", "생성형AI", "생성AI",
    "AI코딩", "AI이미지", "AI영상", "AI번역", "AI챗봇", "AI글쓰기",
    "AI요약", "AI음성", "AI그림", "AI작곡", "AI보안", "AICC",
]

def is_ai_related(keyword):
    """키워드가 AI 관련인지 판단"""
    kw_upper = keyword.upper()
    for pattern in AI_INCLUDE_PATTERNS:
        if pattern.upper() in kw_upper:
            return True
    return False

def select_topics(keywords, search_volumes, blog_counts, articles, top_n=20):
    print(f"\n[5단계] 경쟁 공백 기준 황금 주제 선별...")
    topics = []

    for kw in keywords:
        # AI 관련 키워드만 통과
        if not is_ai_related(kw):
            continue
        vol   = search_volumes.get(kw, 0)
        blog  = blog_counts.get(kw, 0)

        if blog == 0:
            continue  # API 오류 가능성

        # 경쟁 공백 등급 (블로그 수 기준)
        if blog <= 500:
            grade = "🏆 독점가능"
            priority = 1
        elif blog <= 2000:
            grade = "🟢 경쟁낮음"
            priority = 2
        elif blog <= 5000:
            grade = "🟡 경쟁보통"
            priority = 3
        elif blog <= 15000:
            grade = "🟠 경쟁높음"
            priority = 4
        else:
            continue  # 경쟁 과다 제외

        # 검색량 보너스 점수
        vol_score = 0
        if vol >= 10000:
            vol_score = 3
        elif vol >= 3000:
            vol_score = 2
        elif vol >= 500:
            vol_score = 1

        related = find_related_news(kw, articles)

        topics.append({
            "keyword": kw,
            "monthly_search": vol,
            "blog_count": blog,
            "grade": grade,
            "priority": priority,
            "vol_score": vol_score,
            "related_news": related,
            "has_news": len(related) > 0,
        })

    # 정렬: 경쟁낮음 우선, 같은 등급 내에서 검색량 높은 것 우선, 관련뉴스 있는 것 우선
    topics.sort(key=lambda x: (
        x['priority'],
        -x['vol_score'],
        -int(x['has_news'])
    ))

    return topics[:top_n]


# ============================================
# 7. 블로그 글 제목 후보 생성 (GPT)
# ============================================
def generate_titles(topic, articles):
    if not OPENAI_KEY:
        return []
    from openai import OpenAI
    client = OpenAI(api_key=OPENAI_KEY)

    related_context = "\n".join(topic['related_news']) if topic['related_news'] else "관련 뉴스 없음"

    prompt = f"""키워드: {topic['keyword']}
월간 검색량: {topic['monthly_search']:,}
블로그 경쟁 수: {topic['blog_count']:,}
관련 뉴스: {related_context}

이 키워드로 네이버/구글 상위노출될 블로그 글 제목 5개를 만들어주세요.

규칙:
- 검색 의도를 정확히 담을 것 (방법/비교/후기/정리 등)
- 2026년 최신 정보임을 어필할 것
- 클릭하고 싶은 제목 (숫자, 구체성 활용)
- 30자 이내

형식: 번호 없이 줄바꿈으로 구분"""

    try:
        resp = client.chat.completions.create(
            model="gpt-4o-mini",
            messages=[{"role": "user", "content": prompt}],
            max_completion_tokens=500)
        titles = [t.strip() for t in resp.choices[0].message.content.strip().split("\n")
                  if t.strip() and len(t.strip()) > 5]
        return titles[:5]
    except:
        return []


# ============================================
# 메인
# ============================================
def main():
    import argparse
    parser = argparse.ArgumentParser()
    parser.add_argument('--hours', type=int, default=24, help='최근 N시간 기사')
    parser.add_argument('--top', type=int, default=15, help='상위 N개 주제')
    parser.add_argument('--titles', action='store_true', help='글 제목 후보 생성')
    args = parser.parse_args()

    print("=" * 60)
    print(f"aikorea24 블로그 주제 선정기 v2.0")
    print(f"전략: 경쟁 공백 선점 | {datetime.now().strftime('%Y-%m-%d %H:%M')}")
    print("=" * 60)

    # 1. 뉴스 수집
    articles = fetch_recent_news(hours=args.hours)
    if not articles:
        print("뉴스 없음. 48시간으로 재시도...")
        articles = fetch_recent_news(hours=48)
    if not articles:
        print("뉴스 없음. 종료.")
        return

    # 2. 롱테일 키워드 생성
    keywords = extract_longtail_keywords(articles)
    if not keywords:
        print("키워드 없음. 종료.")
        return

    # 3. 검색량 (2단계에서 이미 수집됨)
    search_volumes = getattr(extract_longtail_keywords, '_volumes', {})
    if not search_volumes:
        search_volumes = get_search_volume(keywords[:80])

    # 4. 블로그 경쟁 수 조회
    print("\n[4단계] 블로그 경쟁 수 조회...")
    # AI 관련 키워드만 먼저 필터링 후 검색량 상위 300개 조회
    ai_keywords = [kw for kw in keywords if is_ai_related(kw)]
    # 검색량 기준 정렬 (search_volumes에 있는 것 우선)
    ai_keywords_sorted = sorted(
        ai_keywords,
        key=lambda k: search_volumes.get(k, 0),
        reverse=True
    )
    sample = ai_keywords_sorted[:300]
    print(f"  AI 관련 키워드: {len(ai_keywords)}개 → 상위 {len(sample)}개 블로그 경쟁 조회")
    blog_counts = get_blog_counts_batch(sample)

    # 5. 황금 주제 선별
    topics = select_topics(keywords, search_volumes, blog_counts, articles, top_n=args.top)

    # 6. 결과 출력
    print("\n" + "=" * 60)
    print(f"블로그 주제 후보 TOP {len(topics)}")
    print(f"기준: 블로그 경쟁 수 15,000 이하 | 최근 {args.hours}시간 뉴스 기반")
    print("=" * 60)

    for i, t in enumerate(topics, 1):
        vol_str = f"{t['monthly_search']:,}" if t['monthly_search'] > 0 else "검색량 미집계"
        print(f"\n{i:02d}. [{t['grade']}] {t['keyword']}")
        print(f"    검색량: {vol_str} | 블로그 경쟁: {t['blog_count']:,}개")
        if t['related_news']:
            print(f"    관련 뉴스:")
            for news in t['related_news']:
                print(f"      → {news[:70]}")

        # 제목 후보 생성 (--titles 옵션)
        if args.titles and i <= 5:
            print(f"    글 제목 후보:")
            titles = generate_titles(t, articles)
            for title in titles:
                print(f"      • {title}")

    # JSON 저장
    out_path = os.path.join(PROJECT_DIR, 'api_test', 'blog_topics.json')
    with open(out_path, 'w', encoding='utf-8') as f:
        json.dump({
            "generated_at": datetime.now().isoformat(),
            "hours": args.hours,
            "total_articles": len(articles),
            "total_keywords": len(keywords),
            "topics": topics
        }, f, ensure_ascii=False, indent=2)

    print(f"\n결과 저장: {out_path}")
    print("=" * 60)
    print("다음 단계: --titles 옵션으로 글 제목 후보 생성")
    print("  python3 blog_topic_finder.py --titles")


if __name__ == '__main__':
    main()
