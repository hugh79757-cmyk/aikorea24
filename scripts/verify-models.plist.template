<?xml version="1.0" encoding="UTF-8"?>
<!-- AIK24-EVAL-07 후속(2단 잡): 무료 모델 호출 검증을 09:30 에 먼저 돌려 캐시를 갱신한다.
     페이지 발행은 기존 kr.aikorea24.free-model-pipe(10:00)가 담당 — 이 잡은 캐시(free_models_verify.json)만 갱신한다.
     검증이 오래 걸려도 10:00 페이지 갱신이 밀리지 않는다(2026-10-16 대표님 선택 = (a) 안전한 쪽).
     설치: cp scripts/verify-models.plist.template ~/Library/LaunchAgents/kr.aikorea24.verify-models.plist
     키는 이 파일에 넣지 않는다 — verify_models_daily.py → model_eval → model_router.load_env() 가
     프로젝트 .env / ~/.env.common 을 직접 읽는다. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>kr.aikorea24.verify-models</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/twinssn/Projects/aikorea24/.venv/bin/python3</string>
		<string>/Users/twinssn/Projects/aikorea24/scripts/verify_models_daily.py</string>
	</array>
	<key>StartCalendarInterval</key>
	<!-- 방콕(+07) 오전 09:30 = 머신 로컬 09:30 — 10:00 페이지 갱신 30분 전. -->
	<dict>
		<key>Hour</key>
		<integer>9</integer>
		<key>Minute</key>
		<integer>30</integer>
	</dict>
	<key>WorkingDirectory</key>
	<string>/Users/twinssn/Projects/aikorea24</string>
	<key>StandardOutPath</key>
	<string>/Users/twinssn/Projects/aikorea24/scripts/logs/verify-models.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/twinssn/Projects/aikorea24/scripts/logs/verify-models.err.log</string>
	<key>RunAtLoad</key>
	<false/>
</dict>
</plist>
