{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aikorea24",
  "account_id": "7eb1b8cd178de269758ec94b2e03330b",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": true,
  "assets": { "binding": "ASSETS", "directory": "./dist/client", "not_found_handling": "single-page-application", "run_worker_first": false },
  // Pages 프로젝트가 프로젝트 레벨 바인딩으로 제공하던 것을 Workers 쪽에 그대로 옮긴다.
  // 이게 없으면 SSR 라우트(홈 포함)가 500으로 죽는다 — DB를 46곳이 참조한다.
  "d1_databases": [
    // remote:true 는 로컬(빌드 중 prerender) 개발에서 실제 D1을 쓰게 한다.
    // 이게 없으면 miniflare가 빈 로컬 SQLite를 만들어 courses 테이블이 없어서
    // /courses/7day-starter 프리렌더가 'no such table: courses'로 죽는다.
    { "binding": "DB", "database_name": "aikorea24-db", "database_id": "3f4cedde-eabc-4d7c-b459-f6abe8733767", "remote": true }
  ],
  "r2_buckets": [
    { "binding": "R2", "bucket_name": "aikorea24-files" }
  ],
  "routes": [
    { "pattern": "aikorea24.kr", "custom_domain": true },
    { "pattern": "www.aikorea24.kr", "custom_domain": true }
  ]
}
